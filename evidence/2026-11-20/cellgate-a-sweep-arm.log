  "vetSays": [
    {
      "day": 1,
      "line": "A man, maybe 30s, with a scarred cheek: \"We've got days of stores, not weeks. The treeline is the pantry now. Learn what's out there.\""
    },
    {
      "day": 1,
      "line": "A man, maybe 30s, with a scarred cheek heads out for water. \"Thirst doesn't negotiate. Going.\" Company makes the road shorter."
    },
    {
      "day": 1,
      "line": "💧 A man, maybe 30s, with a scarred cheek returns with water: +2 clean."
    },
    {
      "day": 1,
      "line": "🍲 A man, maybe 30s, with a scarred cheek is eating by the fire — not talking, just eating."
    },
    {
      "day": 1,
      "line": "\"Hey.\" A man, maybe 30s, with a scarred cheek settles near you, not too close. \"Day one. Everyone's pretending they're fine. ...Can we talk? Just talk — like people used to.\" (Talk to A man, maybe 30s, with a scarred cheek.)"
    },
    {
      "day": 2,
      "line": "A man, maybe 30s, with a scarred cheek hesitates, then backs off. \"Not today. Sorry.\" (Low trust — reluctant.)"
    },
    {
      "day": 2,
      "line": "📋 A man, maybe 30s, with a scarred cheek — 🪾 Gather deadfall. They'll report back by next part."
    },
    {
      "day": 2,
