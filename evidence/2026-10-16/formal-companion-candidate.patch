   // member-status popover. UI-only state — lives here, not in the save.
   let partyPanelOpen = false;
 
+  // Same body as a nearby companion in game.js. Formal membership changes
+  // who joins, not their wounds, adult capacity or actually worn equipment.
+  // Preserve the existing nearby entry clamp (minimum1, default100); this
+  // does not change living-roster eligibility or the hostile betrayal model.
+  function partyCombatBody(game, vid) {
+    let person = game.vpOf(vid);
+    if (!person || !person.id) person = (game.data.background_survivors || []).find(p => p.id === vid);
+    const current = (game.state.village.health || {})[vid];
+    const hp = Math.max(1, Math.round(current !== undefined ? current : 100));
+    const body = { hp, maxHp: Math.max(hp, 100), wbonus: 0, varmor: 0 };
+    const equipment = (globalThis.Scattering || {}).equipment;
+    if (equipment && person) {
+      try {
+        body.wbonus = equipment.weaponBonusOf(person, game.data.items);
+        body.varmor = equipment.armorOf(person, game.data.items);
+      } catch (e) { console.warn('[party] companion equipment', e); }
+    }
+    return body;
+  }
