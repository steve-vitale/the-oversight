"might:1":true,"might:2":true,"showmanship:0":true,"protected:0":true,"showmanship:1":true,"protected:1":true,"showmanship:2":true,"brokerage:0":true,"defiance:0":true},"surgeResonance":265,"moments":[{"day":89,"text":"Dieter Rosenberg died. Nomthandazo picked up the Codex."},{"day":89,"text":"Planted: wrong pauses in the north village's messages."},{"day":87,"text":"THE HERALD struck unanswered."},{"day":82,"text":"THE HERALD struck unanswered."},{"day":81,"text":"Survived the audience's trial: Haul 3,000 kcal to the pantry within 3 days.."},{"day":78,"text":"Planted: wrong pauses in the north village's messages."},{"day":78,"text":"Haven feasted the world feed."},{"day":78,"text":"Haven feels as one."},{"day":77,"text":"Haven became national — the first court sat."},{"day":77,"text":"THE HERALD struck unanswered."},{"day":72,"text":"THE HERALD struck unanswered."},{"day":71,"text":"The Granary raised — Haven grows to 24 souls."},{"day":67,"text":"THE HERALD struck unanswered."},{"day":66,"text":"Imani Zhang was brought home. The village dug the grave."},{"day":66,"text":"Planted: wrong pauses in the north village's messages."},{"day":66,"text":"Dieter Rosenberg claimed the relay."},{"day":65,"text":"Haven entered Arc IV."},{"day":65,"text":"Imani Zhang died. Dieter picked up the Codex."},{"day":62,"text":"Survived the audience's trial: Haul 3,000 kcal to the pantry within 3 days.."},{"day":62,"text":"THE HERALD struck unanswered."},{"day":59,"text":"Dieter, Devon brought down Big Ugly 1, Big Ugly 2, Big Ugly 3, Big Ugly 4. Together."},{"day":57,"text":"Haven entered Arc III."},{"day":57,"text":"Crisis survived: THE FIRST GRAVE."},{"day":57,"text":"War council sat for THE HERALD."},{"day":57,"text":"THE HERALD struck unanswered."},{"day":57,"text":"THE HERALD located. The coalition must answer."},{"day":56,"text":"Survived the audience's trial: Haul 1,000 kcal to the pantry within 3 days.."},{"day":55,"text":"The Palisade raised — Haven grows to 20 souls."},{"day":48,"text":"Titan omen: something stirs."},{"day":47,"text":"Imani Zhang claimed the relay."}],"pendingMoments":[],"legendBeats":[{"day":4,"kind":"lived","dim":"foodShared","text":"A mother from Ashford pressed a carved token into your hand: \"for the winter you fed us.\" You didn't know there was a winter you'd fed."},{"day":8,"kind":"gossip","dim":"foodShared","text":"You overhear it at the fire, and stop pretending not to listen. Riders say your name the way people say \"harvest.\""},{"day":9,"kind":"system","dim":"embrace","text":"The overlay's tone has changed around you. Warmer. It notices you noticing."},{"day":13,"kind":"show","dim":"foodShared","text":"📺 The broadcast ran the numbers: how much of Haven's food left Haven in your hands. The audience went quiet — the good kind of quiet."},{"day":22,"kind":"gossip","dim":"might","text":"Riders from Emberhold are telling the deer story again — with your name attached this time."},{"day":22,"kind":"show","dim":"might","text":"📺 The show has started calling you \"the strong one of Haven.\" They play the deer footage underneath, whether you want them to or not."},{"day":22,"kind":"lived","dim":"might","text":"You notice the village gives you room on the path now. Not fear, exactly. Room."},{"day":26,"kind":"show","dim":"showmanship","text":"📺 The audience has a favorite, and it's you. The chant doesn't have words. It doesn't need them."},{"day":28,"kind":"lived","dim":"protected","text":"A child drew you on the haven wall. You're very tall, and there are a lot of teeth on the other side."},{"day":38,"kind":"show","dim":"showmanship","text":"📺 Strangers paint your face on their walls. In other villages. Villages you've never been to."},{"day":49,"kind":"gossip","dim":"protected","text":"In Stonebridge, mothers tell the story of the night you stood between. The children ask for it by name."},{"day":62,"kind":"show","dim":"showmanship","text":"📺 The show has stopped introducing you. Everybody knows."},{"day":87,"kind":"gossip","dim":"brokerage","text":"A rider says in Ashford you're \"the one who makes deals hold.\" Nobody remembers when that started being true."},{"day":89,"kind":"system","dim":"defiance","text":"The System's messages have gotten careful around you. It chooses its words the way you choose footing on ice."}],"selfTalkedAbout":true,"lastArcDay":65,"lastStage":3,"table":{},"lastLedgerBeat":84,"namedMonsterGrants":{"white_noise_heron":true,"gallowdeer":true,"hummice":true,"hushwolf":true,"mirrormoth":true,"heckler":true,"nevermore":true,"memory_projector":true,"bright_idea":true,"landlord":true,"union_rep":true,"cancellation":true,"spool":true,"lockpick_raccoon":true,"ducks_in_a_row":true,"nightlight_catfish":true,"editor":true},"feastSurge":1.5,"ledgerEvents":[{"sys":"hierarchy","ev":"stir:contest:Duel","day":20},{"sys":"hierarchy","ev":"linked:village_0:prim","day":25},{"sys":"hierarchy","ev":"stir:court:village_0","day":25},{"sys":"hierarchy","ev":"tended:village_0","day":26},{"sys":"hierarchy","ev":"linked:village_1:prim","day":26},{"sys":"hierarchy","ev":"stir:court:village_1","day":26},{"sys":"hierarchy","ev":"tended:village_1","day":27},{"sys":"hierarchy","ev":"linked:village_2:prim","day":27},{"sys":"hierarchy","ev":"stir:court:village_2","day":27},{"sys":"hierarchy","ev":"tended:village_0","day":28},{"sys":"hierarchy","ev":"tended:village_1","day":28},{"sys":"hierarchy","ev":"tended:village_2","day":28},{"sys":"hierarchy","ev":"stir:contest:Hollow Belly","day":35},{"sys":"hierarchy","ev":"tended:village_0","day":35},{"sys":"hierarchy","ev":"tended:village_1","day":35},{"sys":"hierarchy","ev":"tended:village_2","day":35},{"sys":"hierarchy","ev":"tended:village_0","day":42},{"sys":"hierarchy","ev":"tended:village_1","day":42},{"sys":"hierarchy","ev":"tended:village_2","day":42},{"sys":"hierarchy","ev":"regional-dawn","day":46},{"sys":"hierarchy","ev":"tended:village_0","day":49},{"sys":"hierarchy","ev":"tended:village_1","day":49},{"sys":"hierarchy","ev":"ten