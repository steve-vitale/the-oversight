tcourt":1,"white_noise_heron":1,"hushwolf":1,"hummice":1,"gallowdeer":1,"heckler":2,"alien_tick":2,"lockpick_raccoon":1,"nevermore":1,"memory_projector":2,"bright_idea":2,"landlord":2,"eulogy":4,"union_rep":2,"glasswing":1},"contestsSurvived":3},"ledger":{"might":55,"brokerage":4,"showmanship":23,"embrace":5,"defiance":1,"exposed":0,"unified":6,"fractured":0,"foodShared":29,"foodHoarded":0,"protected":17,"killed":0,"betrayed":0},"baseBreadth":8,"_teleSeen":{"arc":2,"rank":"regional","syn":{}},"hungryStreak":0,"ledgerQueue":[],"unityTier":"close-knit","foodStanceKey":"sharer","overtimeLastDay":57,"lineage":[],"ledgerBeatsFired":{"foodShared:0":true,"foodShared:1":true,"embrace:0":true,"foodShared:2":true,"might:0":true,"might:1":true,"might:2":true,"showmanship:0":true,"protected:0":true,"showmanship:1":true,"protected:1":true},"surgeResonance":162,"moments":[{"day":57,"text":"War council sat for THE HERALD."},{"day":57,"text":"THE HERALD struck unanswered."},{"day":57,"text":"THE HERALD located. The coalition must answer."},{"day":56,"text":"Survived the audience's trial: Haul 1,000 kcal to the pantry within 3 days.."},{"day":55,"text":"The Palisade raised — Haven grows to 20 souls."},{"day":48,"text":"Titan omen: something stirs."},{"day":47,"text":"Imani Zhang claimed the relay."},{"day":45,"text":"Survived the audience's trial: Haul 3,000 kcal to the pantry within 3 days.."},{"day":39,"text":"Taught the System something it didn't know."},{"day":38,"text":"Survived the audience's trial: Haul 1,000 kcal to the pantry within 3 days.."},{"day":37,"text":"Dieter, Devon, Miguel brought down Nostalgia. Together."},{"day":35,"text":"Taught the System something it didn't know."},{"day":34,"text":"Taught the System something it didn't know."},{"day":31,"text":"Survived the audience's trial: Haul 1,000 kcal to the pantry within 3 days.."},{"day":30,"text":"Dieter, Devon, Miguel brought down Pack-leader Nevermore, Nevermore (packmate). Together."},{"day":26,"text":"Survived the audience's trial: Haul 3,000 kcal to the pantry within 3 days.."},{"day":26,"text":"Haven feels close-knit."},{"day":24,"text":"Dieter, Devon, Miguel brought down The Heckler. Together."},{"day":22,"text":"Dieter, Devon, Miguel brought down Pack-leader Big Ugly 1, Big Ugly (packmate), Pack-leader Big Ugly 2, Pack-leader Big Ugly 3, Pack-leader "},{"day":22,"text":"Shared food outward — Haven's pantry."},{"day":20,"text":"Taught the System something it didn't know."},{"day":11,"text":"Crisis survived: THE BREACH."},{"day":8,"text":"Haven entered Arc II."},{"day":6,"text":"The village has decided what kind of keeper you are."},{"day":3,"text":"The Longhouse raised — Haven grows to 16 souls."}],"pendingMoments":[],"legendBeats":[{"day":4,"kind":"lived","dim":"foodShared","text":"A mother from Ashford pressed a carved token into your hand: \"for the winter you fed us.\" You didn't know there was a winter you'd fed."},{"day":8,"kind":"gossip","dim":"foodShared","text":"You overhear it at the fire, and stop pretending not to listen. Riders say your name the way people say \"harvest.\""},{"day":9,"kind":"system","dim":"embrace","text":"The overlay's tone has changed around you. Warmer. It notices you noticing."},{"day":13,"kind":"show","dim":"foodShared","text":"📺 The broadcast ran the numbers: how much of Haven's food left Haven in your hands. The audience went quiet — the good kind of quiet."},{"day":22,"kind":"gossip","dim":"might","text":"Riders from Emberhold are telling the deer story again — with your name attached this time."},{"day":22,"kind":"show","dim":"might","text":"📺 The show has started calling you \"the strong one of Haven.\" They play the deer footage underneath, whether you want them to or not."},{"day":22,"kind":"lived","dim":"might","text":"You notice the village gives you room on the path now. Not fear, exactly. Room."},{"day":26,"kind":"show","dim":"showmanship","text":"📺 The audience has a favorite, and it's you. The chant doesn't have words. It doesn't need them."},{"day":28,"kind":"lived","dim":"protected","text":"A child drew you on the haven wall. You're very tall, and there are a lot of teeth on the other side."},{"day":38,"kind":"show","dim":"showmanship","text":"📺 Strangers paint your face on their walls. In other villages. Villages you've never been to."},{"day":49,"kind":"gossip","dim":"protected","text":"In Stonebridge, mothers tell the story of the night you stood between. The children ask for it by name."}],"selfTalkedAbout":true,"lastArcDay":8,"lastStage":3,"table":{},"lastLedgerBeat":48,"namedMonsterGrants":{"white_noise_heron":true,"gallowdeer":true,"hummice":true,"hushwolf":true,"mirrormoth":true,"heckler":true,"nevermore":true,"memory_projector":true,"bright_idea":true,"landlord":true,"union_rep":true},"feastSurge":1.5,"ledgerEvents":[{"sys":"hierarchy","ev":"stir:contest:Duel","day":20},{"sys":"hierarchy","ev":"linked:village_0:prim","day":25},{"sys":"hierarchy","ev":"stir:court:village_0","day":25},{"sys":"hierarchy","ev":"tended:village_0","day":26},{"sys":"hierarchy","ev":"linked:village_1:prim","day":26},{"sys":"hierarchy","ev":"stir:court:village_1","day":26},{"sys":"hierarchy","ev":"tended:village_1","day":27},{"sys":"hierarchy","ev":"linked:village_2:prim","day":27},{"sys":"hierarchy","ev":"stir:court:village_2","day":27},{"sys":"hierarchy","ev":"tended:village_0","day":28},{"sys":"hierarchy","ev":"tended:village_1","day":28},{"sys":"hierarchy","ev":"tended:village_2","day":28},{"sys":"hierarchy","ev":"stir:contest:Hollow Belly","day":35},{"sys":"hierarchy","ev":"tended:village_0","day":35},{"sys":"hierarchy","ev":"tended:village_1","day":35},{"sys":"hierarchy","ev":"tended:village_2","day":35},{"sys":"hierarchy","ev":"tended:village_0","day":42},{"sys":"hierarchy","ev":"tended:village_1","day":42},{"sys":"hierarchy","ev":"tended:village_2","day":42},{"sys":"hierarchy","ev":"regional-dawn","day":46},{"sys":"hierarchy","ev":"tended:village_0","day":49},{"sys":"hierarchy","ev":"tende