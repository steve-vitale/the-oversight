    "transcript": [
     {
      "who": "NPC",
      "text": "\"About the creek water run — I still haven't found anyone. Any chance? Makes sense to me.\""
     },
     {
      "who": "YOU",
      "text": "\"I'll do it.\""
     },
     {
      "who": "NPC",
      "text": "\"Dawn, then. Bring something to carry — and thank you.\""
     },
     {
      "who": "YOU",
      "text": "\"Wait — what were we talking about?\""
     },
     {
      "who": "NPC",
      "text": "\"Honestly, still on that favor.\""
     },
     {
      "who": "YOU",
      "text": "\"Keep going.\""
     },
     {
      "who": "NPC",
      "text": "The mood shifts, subtly."
     },
     {
      "who": "YOU",
      "text": "\"Wait — what were we talking about?\""
     },
     {
      "who": "NPC",
      "text": "\"Still on that favor.\""
     },
     {
      "who": "YOU",
      "text": "\"Keep going.\""
     },
     {
      "who": "NPC",
      "text": "\"...Hi. Sorry. I'm not good at the talking-to-strangers part.\""
     },
     {
      "who": "YOU",
      "text": "\"Neither am I, honestly.\""
     },
     {
      "who": "NPC",
      "text": "Something eases in their shoulders. \"Oh. Okay. That's... that's fine, then.\""
     },
     {
      "who": "YOU",
      "text": "\"Keep going.\""
     },
     {
      "who": "NPC",
      "text": "\"Alright, duty calls. This was a good pause.\""
     },
     {
      "who": "NPC",
      "text": "\"First light. Don't sleep through it.\""
     }
