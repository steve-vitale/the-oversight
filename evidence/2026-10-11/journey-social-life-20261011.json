    "naturalEnd": true,
    "forcedClose": false,
    "transcript": [
     {
      "who": "NPC",
      "text": "\"About the creek water run you promised — You came through on the creek water run. I won't forget it.\""
     },
     {
      "who": "YOU",
      "text": "\"How can I help?\""
     },
     {
      "who": "NPC",
      "text": "\"Good. Then we're square.\" They look lighter for it."
     },
     {
      "who": "YOU",
      "text": "\"About what you promised — and did...\""
     },
     {
      "who": "NPC",
      "text": "“You kept your word. That’s rare out here.”"
     },
     {
      "who": "YOU",
      "text": "\"About what you promised — and did...\""
     },
     {
      "who": "YOU",
      "text": "\"About what you promised — and did...\""
     },
     {
      "who": "YOU",
      "text": "\"About what you promised — and did...\""
     },
     {
      "who": "YOU",
      "text": "\"About what you promised — and did...\""
     },
     {
      "who": "NPC",
      "text": "\"I've got things to see to. Don't be a stranger.\""
     },
     {
      "who": "YOU",
      "text": "\"About what you promised — and did...\""
     },
     {
      "who": "NPC",
      "text": "\"Alright. One thing at a time. That's how we get through.\""
     },
     {
      "who": "NPC",
      "text": "\"Good — that favor, settled. Feels better said out loud.\""
     },
     {
      "who": "NPC",
      "text": "They're smiling as you go. \"Come back anytime.\""
     }
