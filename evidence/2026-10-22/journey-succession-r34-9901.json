 "convoReads": [
  {
   "day": 19,
   "dplus": 7,
   "vid": "Carlos",
   "refused": false,
   "want": "seek_comfort"
  },
  {
   "day": 26,
   "dplus": 14,
   "vid": "Carlos",
   "refused": false,
   "want": "ask_favor"
  },
  {
   "day": 33,
