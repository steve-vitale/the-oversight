    {
      "id": "gate-pass-rate",
      "pass": true,
      "detail": "arm spearPassed/spearSeen = 111/111 = 1.000 (bar 1.0 — every spear-holder passed over)"
    },
    {
      "id": "ctl-pass-rate",
      "pass": true,
      "detail": "ctl spearPassed/spearSeen = 108/108 = 1.000 (bar 1.0 — the gate is ON on the ctl leg too; every spear-holder is passed over)"
    },
    {
      "id": "consistency-alreadyHad",
      "pass": true,
      "detail": "arm alreadyHad 195 vs ctl alreadyHad 195 (delta 0, bar |delta|<=3; both legs gate-on, so no spearSeen term)"
    },
    {
      "id": "consistency-noSource",
      "pass": false,
      "detail": "arm noSource 259 vs ctl noSource 255 minus (arm staged 2 - ctl staged 0) = 253 (delta 6, bar |delta|<=3; PARTITION formula — every departure partitions into staged / craftedFail / noSource, so a served departure leaves noSource by exactly one)"
    },
    {
      "id": "served",
      "pass": false,
      "detail": "SERVED (fromStash+fromArmory+crafted): arm 2 (stash 0 armory 0 crafted 2, craftedFail 5) minus ctl 0 = 2 (bar >= 3 — the gate must actually serve spear-holders, not just pass them to noSource)"
    },
    {
      "id": "volley-rate-rise",
      "pass": true,
      "detail": "volley fire share arm 0.435 (10/23) minus ctl 0.333 (7/21) = 0.101 (bar >= +0.10 — served bows must actually open fire)"
    },
    {
      "id": "cost-starvation",
      "pass": true,
      "detail": "starvation totals arm 2 vs ctl 3; villager arm 2 vs ctl 3 (bar arm<=ctl+2 both)"
    },
    {
      "id": "cost-median",
      "pass": true,
      "detail": "median survival arm 150d vs ctl 150d (bar arm>=0.8x ctl)"
    }
  ],
