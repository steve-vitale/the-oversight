  "vetSays": [
    {
      "day": 1,
      "line": "A person, maybe 30s, with a scarred cheek looks at you flatly. \"Why should I listen to you?\" (Trust too low.)"
    },
    {
      "day": 1,
      "line": "A person, maybe 30s, with a scarred cheek heads out for water. \"Thirst doesn't negotiate. Going.\""
    },
    {
      "day": 1,
      "line": "\"You haven't earned that yet,\" A person, maybe 30s, with a scarred cheek says. (Trust too low.)"
    },
    {
      "day": 1,
      "line": "A person, maybe 30s, with a scarred cheek shakes their head. \"Ask someone who trusts you.\" (Trust too low.)"
    },
    {
      "day": 1,
      "line": "💧 A person, maybe 30s, with a scarred cheek returns with water: +4 clean."
    },
    {
      "day": 1,
      "line": "🍲 A person, maybe 30s, with a scarred cheek is eating by the fire — not talking, just eating."
    },
    {
      "day": 1,
      "line": "A person, maybe 30s, with a scarred cheek will work the garden once each day while at Haven. Other orders take priority."
    },
    {
      "day": 1,
      "line": "🌱 A person, maybe 30s, with a scarred cheek looks over the garden: turned soil, nothing planted. Someone has to sow first."
    },
    {
      "day": 1,
      "line": "📓 Journal: the person in their 30s, with a wiry build taught the person in their 30s, with a scarred cheek Field Dressing."
    },
    {
      "day": 2,
      "line": "\"You haven't earned that yet,\" A person, maybe 30s, with a scarred cheek says. (Trust too low.)"
    },
    {
      "day": 2,
      "line": "A person, maybe 30s, with a scarred cheek shakes their head. \"Ask someone who trusts you.\" (Trust too low.)"
    },
    {
      "day": 2,
      "line": "A person, maybe 30s, with a scarred cheek looks at you flatly. \"Why should I listen to you?\" (Trust too low.)"
    },
    {
      "day": 2,
      "line": "👂 Overheard — A person, maybe 30s, with a scarred cheek: \"Yeah. Yeah, okay. That's solid.\""
    },
    {
      "day": 2,
      "line": "🌿 A person, maybe 30s, with a scarred cheek checks the pantry before heading out — the shelves are full, ~5 days of fresh on hand… leaves the harvest standing and turns to the wood run instead. The pantry can't take more; the wild will keep."
    },
    {
      "day": 2,
      "line": "🪵 A person, maybe 30s, with a scarred cheek hauls back 6 wood. The pile grows. (16 logs now.)"
    },
    {
      "day": 2,
      "line": "🍲 A person, maybe 30s, with a scarred cheek is hunched over their bowl by the fire, eating like it matters."
    },
    {
      "day": 2,
      "line": "\"Can we talk?\" A person, maybe 30s, with a scarred cheek sits down near you. \"Just... talk. Like people used to.\" (Talk to A person, maybe 30s, with a scarred cheek.)"
    },
    {
      "day": 2,
      "line": "👂 Overheard — A person, maybe 30s, with a scarred cheek: \"One day at a time. We're still here — that counts.\""
    },
    {
      "day": 2,
      "line": "📋 A person, maybe 30s, with a scarred cheek — 🎣 Fish. They'll report back by next part."
    },
    {
      "day": 2,
      "line": "You give A person, maybe 30s, with a scarred cheek 3 portions of Dried beans, with the village watching. They look at you differently now."
    },
    {
      "day": 2,
      "line": "💧 A person, maybe 30s, with a scarred cheek eyes the cistern — full to the brim. No sense hauling water there's no room for; they turn to the stone pile instead."
    },
    {
      "day": 2,
      "line": "🪨 A person, maybe 30s, with a scarred cheek pries 1 stone loose from the creek bed. The building pile grows. (2 stone now.)"
    },
    {
      "day": 3,
      "line": "🌿 A person, maybe 30s, with a scarred cheek checks the pantry before heading out — the shelves are full, ~6 days of fresh on hand… leaves the harvest standing and turns to the stone pile instead. The pantry can't take more; the wild will keep."
    },
    {
      "day": 3,
      "line": "🪨 A person, maybe 30s, with a scarred cheek pries 1 stone loose from the creek bed. The building pile grows. (1 stone now.)"
    },
    {
      "day": 3,
      "line": "A person, maybe 30s, with a scarred cheek quietly adds to the pantry without being asked. \"For later. All of us.\" (+150 kcal)"
    },
    {
      "day": 3,
      "line": "👂 Overheard — A person, maybe 30s, with a scarred cheek: \"Steady on. We'll get there.\""
    },
    {
      "day": 3,
      "line": "A person, maybe 30s, with a scarred cheek eats from the pantry."
    },
    {
      "day": 3,
      "line": "👂 Overheard — A person, maybe 30s, with a scarred cheek: \"Us. Yeah. I'll drink to that — water, but still.\""
    },
    {
      "day": 3,
      "line": "👂 Overheard — A person, maybe 30s, with a scarred cheek: \"Yeah. Yeah, okay. That's solid.\""
