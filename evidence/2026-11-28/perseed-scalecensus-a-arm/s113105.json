 "fireside": [
  {
   "day": 7,
   "speaker": "A man, maybe 50s, with weathered hands",
   "listener": "Thong",
   "text": "\"Stone. We need 47 more for the palisade footings. Creek beds, hillsides — pry it loose.\""
  },
  {
   "day": 14,
   "speaker": "Caleb",
   "listener": "Ingrid",
   "text": "\"313 wood. We need 350. The forest isn't going to cut itself.\""
  },
  {
   "day": 60,
   "speaker": "Jorge",
   "listener": "Naran",
   "text": "\"Did you see their faces? Too many angles. I keep wondering what they want from us.\""
  }
 ],
 "firesideCount": 3,
 "tableLines": [
  {
   "day": 2,
   "line": "You caught the lie in his face and watched the whole table react to it before he'd finished the sentence. Face and room, both open books."
  },
  {
   "day": 16,
   "line": "💔 A faction of Stonebridge has turned cannibal — and split. The eaters walked. The Red Table is a new fire in the world now — 3 people under Alba."
  },
  {
   "day": 16,
   "line": "📓 Codex: Stonebridge split (cannibal). The Red Table formed; 3 petition at Haven's fire."
  },
  {
   "day": 17,
   "line": "A mother from The Red Table pressed a carved token into your hand: \"for the winter you fed us.\" You didn't know there was a winter you'd fed."
  },
  {
   "day": 17,
   "line": "A runner from The Red Table, dusty and direct: \"Your foragers are stripping our side of the northwest ground. Back off — or we'll talk with teeth.\" (Trust -3. The commons cuts both ways.)"
  },
  {
   "day": 18,
   "line": "🧳 A traveler passed through yesterday, talking about a village to the northwest called The Red Table. The region is bigger than your fire."
  },
  {
   "day": 19,
   "line": "Word later: they walked to The Red Table. Another fire in the world, whether you wanted it or not."
  },
  {
   "day": 20,
   "line": "🧳 Stonebridge has split — the eaters walked. They call the new fire The Red Table. Half of them were headed this way, or so the traveler says."
  },
  {
   "day": 31,
   "line": "💔 A faction of Emberhold has turned cannibal — and split. The eaters walked. The Red Table II is a new fire in the world now — 2 people under Alba."
  },
  {
   "day": 34,
   "line": "🧳 Emberhold has split — the eaters walked. They call the new fire The Red Table II. Half of them were headed this way, or so the traveler says."
  },
  {
   "day": 35,
   "line": "Word later: they walked to The Red Table II. Another fire in the world, whether you wanted it or not."
  },
  {
   "day": 35,
   "line": "🌙 Raid — The Red Table came in the night from the northwest. They trampled 2 garden plots into mud. Nobody's dead, but the message is clear: the ground is theirs too, and they're done asking. (Trust -10.)"
  },
  {
   "day": 35,
   "line": "A runner from The Red Table II, dusty and direct: \"Your foragers are stripping our side of the northeast ground. Back off — or we'll talk with teeth.\" (Trust -3. The commons cuts both ways.)"
  },
  {
   "day": 37,
   "line": "The village feels it before they understand it: Haven isn't just Haven anymore. Ezra speaks at Emberhold's table now — earned, not appointed. And the other fire is watching what Haven does FIRST."
  },
