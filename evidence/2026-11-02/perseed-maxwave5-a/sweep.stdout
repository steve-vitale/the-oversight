e.js:12695:52)"},{"day":57,"mid":"strike","wave":4,"titan":false,"optsKeys":["mx","my"],"stackTop":"    at Game.spawnWorldMonster (/home/hatch/workspace/worktrees/sim-maxwave5-a/scripts/maxwave5-replay-20261102.js:99:93) |     at Object.checkEncounter (src/js/game.js:23836:16) |     at G.checkEncounter (src/js/encounters.js:2676:47) |     at Game.checkEncounter (src/js/party-formal.js:908:34) |     at Object.travelTo (src/js/game.js:12695:52)"},{"day":61,"mid":"reunion","wave":4,"titan":false,"optsKeys":["mx","my"],"stackTop":"    at Game.spawnWorldMonster (/home/hatch/workspace/worktrees/sim-maxwave5-a/scripts/maxwave5-replay-20261102.js:99:93) |     at Object.checkEncounter (src/js/game.js:23836:16) |     at G.checkEncounter (src/js/encounters.js:2676:47) |     at Game.checkEncounter (src/js/party-formal.js:908:34) |     at Object.travelTo (src/js/game.js:12695:52)"},{"day":64,"mid":"herald","wave":4,"titan":true,"optsKeys":["titan"],"stackTop":"    at Game.spawnWorldMonster (/home/hatch/workspace/worktrees/sim-maxwave5-a/scripts/maxwave5-replay-20261102.js:99:93) |     at titanPlace (src/js/titans.js:291:22) |     at titanAdvanceOmen (src/js/titans.js:239:7) |     at eval (src/js/titans.js:203:9) |     at Array.forEach (<anonymous>)"},{"day":74,"mid":"spool","wave":3,"titan":false,"optsKeys":["mx","my"],"stackTop":"    at Game.spawnWorldMonster (/home/hatch/workspace/worktrees/sim-maxwave5-a/scripts/maxwave5-replay-20261102.js:99:93) |     at Object.checkEncounter (src/js/game.js:23836:16) |     at G.checkEncounter (src/js/encounters.js:2676:47) |     at Game.checkEncounter (src/js/party-formal.js:908:34) |     at Object.travelTo (src/js/game.js:12695:52)"}],"unlockLines":[{"day":37,"line":"📺 \"Oh, you survived the AUDIENCE NOTES? Cute. We've stopped pretending these are animals now. That was the FINAL DRAFT, folks — what comes out of the treeline next was never alive the way you mean it.\""},{"day":46,"line":"◈ ARC IV — THE INEFFICIENCY. SYSTEM: \"ROUNDING ERROR RECLASSIFIED: ANOMALY. Organic consumption yields impossible output. Recalculating. Recalculating.\" — They finally see it. The thing they laughed at — needing to EAT — is the engine. Their confusion is your weapon now. You stood up to the calibration fauna, the audience's notes, the Final Draft — lived through their Show, weathered the worst tog"},{"day":50,"line":"📺 \"But finales — FINALES need a LEGEND, sweetheart. More STANDING — blood, bonds, or bread — and look the Mirror Draft in the eye. The producers are WAITING.\""},{"day":50,"line":"📺 \"We've been watching you for a LONG time. Your faiths. Your formats. Your little institutions. So we built something out of... well. Out of YOU. Say hello to the MIRROR DRAFT.\""},{"day":55,"line":"◈ SYSTEM: \"Four waves. FOUR. The producers are — okay, I'm saying it: FINALES need a NATION. You've got a region; now make it a REALM. Bind fires under one head, or bend the knee to someone who has. The higher-ups are watching. ...Did I say higher-ups? I said NOTHING. Forget the higher-ups.\""},{"day":76,"line":"📺 \"You've gotten too big for the story. Ratings are GREAT, by the way — but you're threatening the narrative now. So the narrative is fighting back. Meet the PRODUCERS.\""}],"attempts":[{"day":27,"mid":"alien_tick","wave":2,"cls":"FOUGHT","reason":null,"caller":"wild-contact","titan":false},{"day":30,"mid":"warranty_caller","wave":2,"cls":"FOUGHT","reason":null,"caller":"wild-contact","titan":false},{"day":32,"mid":"drumbelly_tanuki","wave":1,"cls":"FOUGHT","reason":null,"caller":"wild-contact","titan":false},{"day":36,"mid":"living_wire","wave":1,"cls":"FOUGHT","reason":null,"caller":"contest","titan":false},{"day":36,"mid":"paparazzo","wave":2,"cls":"FOUGHT","reason":null,"caller":"wild-contact","titan":false},{"day":41,"mid":"redactor","wave":3,"cls":"FOUGHT","reason":null,"caller":"wild-contact","titan":false},{"day":43,"mid":"buffering","wave":3,"cls":"FOUGHT","reason":null,"caller":"contest","titan":false},{"day"