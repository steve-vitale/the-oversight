  "sayKept": [
    {
      "day": 1,
      "line": "📨 Word came: Jovan Milic wants to join Haven. \"Word travels: Haven takes people in. I'm people.\" — they haven't set foot here. The village will judge."
    },
    {
      "day": 8,
      "line": "Someone walks in like they belong here, grinning. \"Heard about this place three valleys over. Had to see it.\" The System's show has an audience, and audiences talk."
    },
    {
      "day": 9,
      "line": "🚶 A stranger walks into Haven. They're thin, scared, and carrying nothing. \"Please,\" they say. \"I heard you have food.\" (Drama: do you share?)"
    },
    {
      "day": 12,
      "line": "📨 Word came: Rosa Mendez wants to join Haven. \"My village is gone. Yours isn't. That's the whole of it.\" — they haven't set foot here. The village will judge."
    },
