w":3,"rank":"regional"},{"day":73,"uw":3,"rank":"regional"},{"day":74,"uw":3,"rank":"regional"},{"day":75,"uw":3,"rank":"regional"},{"day":76,"uw":3,"rank":"regional"},{"day":77,"uw":3,"rank":"regional"},{"day":78,"uw":3,"rank":"regional"},{"day":79,"uw":3,"rank":"regional"},{"day":80,"uw":3,"rank":"regional"},{"day":81,"uw":3,"rank":"regional"},{"day":82,"uw":3,"rank":"regional"},{"day":83,"uw":3,"rank":"regional"},{"day":84,"uw":3,"rank":"regional"},{"day":85,"uw":3,"rank":"regional"},{"day":86,"uw":3,"rank":"regional"},{"day":87,"uw":3,"rank":"regional"},{"day":88,"uw":3,"rank":"regional"},{"day":89,"uw":3,"rank":"regional"},{"day":90,"uw":3,"rank":"regional"},{"day":91,"uw":3,"rank":"regional"},{"day":92,"uw":3,"rank":"regional"},{"day":93,"uw":3,"rank":"national"},{"day":94,"uw":3,"rank":"national"},{"day":95,"uw":3,"rank":"national"},{"day":96,"uw":3,"rank":"national"},{"day":97,"uw":3,"rank":"national"},{"day":98,"uw":4,"rank":"national"},{"day":99,"uw":4,"rank":"national"},{"day":100,"uw":4,"rank":"national"},{"day":101,"uw":4,"rank":"national"},{"day":102,"uw":4,"rank":"national"},{"day":103,"uw":4,"rank":"national"},{"day":104,"uw":4,"rank":"national"},{"day":105,"uw":4,"rank":"national"},{"day":106,"uw":4,"rank":"national"},{"day":107,"uw":4,"rank":"national"},{"day":108,"uw":4,"rank":"national"},{"day":109,"uw":4,"rank":"national"},{"day":110,"uw":4,"rank":"national"},{"day":111,"uw":4,"rank":"national"},{"day":112,"uw":4,"rank":"national"},{"day":113,"uw":4,"rank":"national"},{"day":114,"uw":4,"rank":"national"},{"day":115,"uw":4,"rank":"national"},{"day":116,"uw":4,"rank":"national"},{"day":117,"uw":4,"rank":"national"},{"day":118,"uw":4,"rank":"national"},{"day":119,"uw":4,"rank":"national"},{"day":120,"uw":4,"rank":"national"},{"day":121,"uw":4,"rank":"national"},{"day":122,"uw":4,"rank":"national"},{"day":123,"uw":4,"rank":"national"},{"day":124,"uw":4,"rank":"national"},{"day":125,"uw":4,"rank":"national"},{"day":126,"uw":4,"rank":"national"},{"day":127,"uw":4,"rank":"national"},{"day":128,"uw":4,"rank":"national"},{"day":129,"uw":4,"rank":"national"},{"day":130,"uw":4,"rank":"national"},{"day":131,"uw":4,"rank":"national"},{"day":132,"uw":4,"rank":"national"},{"day":133,"uw":4,"rank":"national"},{"day":134,"uw":4,"rank":"national"},{"day":135,"uw":4,"rank":"national"},{"day":136,"uw":4,"rank":"national"}],"transcripts":[{"cls":"herald-refused-late","day":128,"mid":"herald","muster":{"present":false,"alliesRaw":0,"alliesUnique":0,"havenRaw":0,"havenUnique":0,"need":null,"readyProxy":null},"sayDuring":["⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."],"lines":["You STRIKE the congregation for 25 (Crowbar).","📺 +5 style — solid hit","🔔 The steeple RINGS — the bell is the telegraph. ABSOLUTION falls like a beam.","Your strikes land harder. (x1.15 training)","(congregation's hide absorbs 10.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the congregation for 33 (Crowbar).","📺 +5 style — solid hit","🔔 The steeple RINGS — one clear note. The chapel doors swing wide. \"Come. Be washed. Trauma, grief, the whole weight — laid down. The price is obedience, a little geas, nothing you'd miss.\" (Accept: heal 40 + cleanse. Refuse: no leash, but no washing.)","Your strikes land harder. (x1.15 training)","(congregation's hide absorbs 10.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the congregation for 28 (Crowbar).","📺 +5 style — solid hit","🔔 The steeple RINGS — the bell is the telegraph. ABSOLUTION falls like a beam.","💥 Absolution!","Armor absorbs 31.","Congregation's Absolution hits you for 28.","Your strikes land harder. (x1.15 training)","(congregation's hide absorbs 10.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the congregation for 29 (Crowbar).","📺 +5 style — solid hit","🔔 The steeple RINGS — one clear note. The chapel doors swing wide. \"Come. Be washed. Trauma, grief, the whole weight — laid down. The price is obedience, a little geas, nothing you'd miss.\" (Accept: heal 40 + cleanse. Refuse: no leash, but no washing.)","Your strikes land harder. (x1.15 training)","(congregation's hide absorbs 10.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the congregation for 24 (Crowbar).","📺 +5 style — solid hit","🔔 The steeple RINGS — the bell is the telegraph. ABSOLUTION falls like a beam.","Your strikes land harder. (x1.15 training)","(congregation's hide absorbs 10.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the congregation for 33 (Crowbar).","📺 +5 style — solid hit","🔔 The steeple RINGS — one clear note. The chapel doors swing wide. \"Come. Be washed. Trauma, grief, the whole weight — laid down. The price is obedience, a little geas, nothing you'd miss.\" (Accept: heal 40 + cleanse. Refuse: no leash, but no washing.)","Your strikes land harder. (x1.15 training)","(congregation's hide absorbs 10.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the congregation for 28 (Crowbar).","📺 +5 style — solid hit","🔔 The steeple RINGS — the bell is the telegraph. ABSOLUTION falls like a beam.","💥 Absolution!","Armor absorbs 36.","Congregation's Absolution hits you for 33.","No path there.","🔔 The steeple RINGS — one clear note. The chapel doors swing wide. \"Come. Be washed. Trauma, grief, the whole weight — laid down. The price is obedience, a little geas, nothing you'd miss.\" (Accept: heal 40 + cleanse. Refuse: no leash, but no washing.)","No path there.","🔔 The steeple RINGS — the bell is the telegraph. ABSOLUTION falls like a beam.","No path there.","🔔 The steeple RINGS — one clear note. The chapel doors swing wide. \"Come. Be washed. Trauma, grief, the whole weight — laid down. The price is obedience, a little geas, nothing you'd miss.\" (Accept: heal 40 + cleanse. Refuse: no leash, but no washing.)","No path there.","🔔 The steeple RINGS — the bell is the telegraph. ABSOLUTION falls like a beam.","💥 Absolution!","Armor absorbs 33.","Congregation's Absolution hits you for 30.","You go down.","📖 The Codex turns a page on its own. Grace Obi is dead. You didn't ask. It knew.","Nobody's talking much. The fire feels smaller tonight.","🕯️ Grace is dead — and the dead hold no treaties. Every link Haven has shakes.","GRACE — GONE. 2 open questions closed unanswered.","🕯️ Grace Obi is dead — the wild. The village stops. Somebody screams. Somebody else starts digging.","What Grace kept close goes into the ground with them — keepsakes are buried, never taken from the body.","\"Grace's gone.\" Ada looks at you for a long moment. \"You're not Grace.\" No heat in it. Just fact. You'll have to earn this face.","The Codex doesn't pause for grief. Emma blinks — and it's already there, overlaying everything, syncing. No pen. No paper. The mantle just... transfers.","📖 LEARNED: Wound Care (Level 1). Clean it, close it, cover it. Pressure stops bleeding. Clean water is better than dirty hands.","⚡ TECHNIQUE UNLOCKED: Precise Mend! Your healing knows where to go. +50% effectiveness. (Your knowledge of Wound Care amplifies your field_medicine.)","📖 LEARNED: Food Preservation (Level 1). Salt, smoke, dry. The big three. Salt draws water out; bacteria can't live without it.","📖 LEARNED: Patient Aim (Level 1). One shot. You don't take the shot unless it's the shot.","🌟 \"MANTLE TRANSFER DETECTED. ...Oh! New face! Same job! Whole new set of tricks. We hardly noticed. (That is a lie. We noticed. The audience CRIED.)\"","📖 The Codex turns a page: Grace Obi, 127 days. The mantle passes to Emma Larsen.","🪞 You wake up somebody else. Emma Larsen, 24 — a Veterinarian. Her hands know different work now: The Touch, Echo Location, Berserker Rage.","You knew Grace — not the office, the person. The fire keeps expecting her, and so do you. That's a heavier kind of stepping up. (+5 trauma)","At the grave, Ada, Meera, Oliver speak for Emma — \"Grace trusted them. We saw it. Give them the fire's hearing.\" The village listens.","The fire knew Emma before the Codex did — her name already carried weight here.","You are full enough.","Took Tribute grain from Stonebridge.","You eat Tribute grain from Stonebridge (500 kcal).","Took Tribute grain from Stonebridge.","You eat Tribute grain from Stonebridge (500 kcal).","Ruby looks at you flatly. \"Why should I listen to you?\" (Trust too low.)","Its posture changes. Curiosity is over.","— DUSK — Animals stir again. Shadows lengthen.","You wait. The light changes. Nothing asks anything of you.","💛 You hold Carpenter's square. Breathe. The shaking eases. (−6 trauma)","Travel 1 tile to grove.","It followed you. The Herald is here.","★ Deeper knowledge: Hickory Nuts. Parts: nut meat (eat), shells (smoke flavor), bark (tea). Crack carefully. (Yield +50%). Use unlocked: food: sweet nutmeats — shell first, worth the work.","You work the patch with practiced hands: 4× Hickory Nuts, 8× Blackberry (520 kcal). This patch is picked clean — it'll recover in a few days.","Travel 1 tile to Haven.","The Herald stops at the treeline — pacing, unwilling. The walls end the argument. It's still out there.","You keep a day's food (520 kcal) — nothing extra for the pantry this time.","1 unprocessed haul onto the counter — the clock is ticking.","You lay out the haul. Ada leans over Hickory Nuts. \"Oh — THAT one. Here, look.\"","📖 Ada starts in on the lesson, then catches themself. \"Hold on — I already showed you this one. Hickory Nuts. You remember.\"","You walk back into Haven. 47 Codex entries. The village is glad to see you.","You clear a dead bed. Sow fresh seed to start a new crop. (40 kcal.)","You sow Blackberry: 180 days to first harvest. Later harvests need 45 days of regrowth. Tend daily; garden magic can accelerate growth. (2 units sown.)","Ruby looks at you flatly. \"Why should I listen to you?\" (Trust too low.)","📋 Oliver — 🎣 Fish. Oliver nods eagerly. They'll report back by next part.","You settle into the hall floor. Sleep takes you.","Word gets around the haven. Whatever that thing was — the haven's talking about nothing else.","Back at the haven the argument starts: Ruby is calling it \"Big-Eyes.\" Nobody agrees yet — weigh in if you want.","🚶 Meera is back.","🌿 Oliver returns from foraging the wilds: +460 kcal to the pantry.","— NIGHT — Camp. Rest — or risk the dark.","Night settles. The fire is the whole world now. No watches posted. The dark feels bigger than it should.","💬 Emma says: \"Do you ever feel it? Like the air leans in when something happens.\"","The village debates a quiet mechanic. The room is cold — Ruby, Ada, Oliver against. \"More mouths, same fire.\" (36% for.)","◈ AUDIENCE TRIAL — SYSTEM: \"The audience wants an encore. A trial, then — smaller this time, but televised.\" Fully identify 3 plants (knowledge level 3) within 3 days. Reward: integration, and a lesson.","🌙 Night. The lingering The Herald gorges at the treeline — 600 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","A lean scout waits a while, then moves on down the road. Word travels about that, too.","It's settled. The village is calling it \"Big-Eyes.\" The Codex keeps it.","◈ The System files the name away with visible satisfaction. It has so few words for things that bleed. (+2 integration)","Rain. Steady, cold, honest rain.","⚠ STARVING: health and energy falling. You went to bed on an empty stomach.","Village meal: +2200 kcal from the communal pantry.","Someone is crying, quietly, in one of the bunks. Ruby goes to sit with them.","Ruby came back with 338 kcal of something edible. The pantry breathes.","🌙 Raid — The Red Table came in the night from the southeast. They trampled 2 garden plots into mud. Nobody's dead, but the message is clear: the ground is theirs too, and they're done asking. (Trust -10.)","— DAY 128 DAWN — The world wakes. Animals are active.","The fire burns low. One new line in the journal: Hickory Nuts — handled into knowledge.","🎁 You find a small bundle tucked where you'll find it. No one saw it left there.","\"The System flagged your sector. Move. NOW.\"","(399 kcal of dried meat and clean water. Nothing traceable.)","💬 Adaeze says: \"The voice said 'north.' Just... north. I don't know what it means.\"","Meera kneels and asks. The land answers: 5 bellies full in Haven today. (Feed the Multitude)","Whatever was at the door has moved on — or found easier meat. The call goes quiet.","Dawn. You wake rested. (+0 health, energy restored. By the fire. Good enough.)","No risky water to boil.","Drank clean water.","\"You haven't earned that yet,\" Ruby says. (Trust too low.)","📯 It moves.","You catch fragments by the fire — Oliver telling Adaeze about you. Someone's added a flourish that wasn't there this morning.","💧 Ada returns with water: +4 clean.","Iron cold. Even the ticks are shelved.","— MIDDAY — Honest work hours. Heat builds.","Word with the traders: Stonebridge door is clear again. Whatever had them, let go.","You wait. The light changes. Nothing asks anything of you.","Filled 1L (clean — Haven well). 3L carried (3kg). (-10 kcal hauling, 1 tick.) Cistern: 3L left.","Ruby looks at you flatly. \"Why should I listen to you?\" (Trust too low.)","📯 It moves.","You catch fragments by the fire — Oliver telling Meera about you. Half of it's true anymore. You're not sure which half.","👥 Ada heads out for water. \"Off to the well — back with a full skin.\"","👥 Meera walks out with Ada. \"Nobody walks alone today.\"","— DUSK — Animals stir again. Shadows lengthen.","You wait. The light changes. Nothing asks anything of you.","Ruby looks at you flatly. \"Why should I listen to you?\" (Trust too low.)","Adaeze left 2 wood logs by the stash. No announcement. That's how it works here.","⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."]}],"musterRefusals":[{"idx":0,"day":128,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic.","have":0,"need":10,"musterExists":false,"alliesRaw":0,"alliesUnique":0,"havenValid":0,"readyManual":false,"readyGame":false,"omenStage":2,"omenDay":119,"links":[{"villageId":"village_0","name":"Emberhold","trust":69,"opinion":6,"arrears":3000,"quota":2,"facesFree":0,"already":0,"wouldRefuse":true,"wouldYield":0},{"villageId":"village_1","name":"Stonebridge","trust":71,"opinion":38,"arrears":0,"quota":6,"facesFree":7,"already":0,"wouldRefuse":false,"wouldYield":6},{"villageId":"village_2","name":"Thornfield","trust":61,"opinion":15,"arrears":0,"quota":2,"facesFree":0,"already":0,"wouldRefuse":false,"wouldYield":0}],"linksActive":3,"callYield":6,"callOffered":true,"commitOffered":true,"volunteers":1,"outcomesPrior":0,"callsSoFar":{"soundTitanCall":0,"titanCommitOwn":0,"titanSelfDo":0,"titanWarCouncil":0}},{"idx":1,"day":128,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic.","have":0,"need":10,"musterExists":false,"alliesRaw":0,"alliesUnique":0,"havenValid":0,"readyManual":false,"readyGame":false,"omenStage":2,"omenDay":119,"links":[{"villageId":"village_0","name":"Emberhold","trust":69,"opinion":6,"arrears":3000,"quota":2,"facesFree":0,"already":0,"wouldRefuse":true,"wouldYield":0},{"villageId":"village_1","name":"Stonebridge","trust":71,"opinion":38,"arrears":0,"quota":6,"facesFree":7,"already":0,"wouldRefuse":false,"wouldYield":6},{"villag