":4,"py":4},"entityPos":{"tx":4,"ty":4,"mx":8,"my":0},"entityHp":{"hp":684,"maxHp":1000},"sayDuring":[],"gameOutcomes":[],"end":"won"}],"fieldFights":[{"day":67,"vid":"luis_fernandez","mid":"reunion","wave":4,"outcome":"vDie","rounds":2,"vTaken":107,"mDealt":19,"vHpLeft":0,"mHpLeft":1181},{"day":70,"vid":"app_mgpsphfn238","mid":"reunion","wave":4,"outcome":"vFlee","rounds":1,"vTaken":62,"mDealt":8,"vHpLeft":13,"mHpLeft":1173},{"day":72,"vid":"app_mgpsphfn238","mid":"reunion","wave":4,"outcome":"vDie","rounds":1,"vTaken":59,"mDealt":0,"vHpLeft":0,"mHpLeft":873},{"day":75,"vid":"elif_demir","mid":"influencer","wave":4,"outcome":"vFlee","rounds":2,"vTaken":67,"mDealt":35,"vHpLeft":18,"mHpLeft":895},{"day":85,"vid":"app_mgpspigb0","mid":"strike","wave":4,"outcome":"vFlee","rounds":2,"vTaken":65,"mDealt":51,"vHpLeft":16,"mHpLeft":949},{"day":87,"vid":"victor_lopez","mid":"reunion","wave":4,"outcome":"vDie","rounds":2,"vTaken":104,"mDealt":0,"vHpLeft":0,"mHpLeft":873},{"day":87,"vid":"visjoin_85","mid":"reunion","wave":4,"outcome":"vFlee","rounds":2,"vTaken":95,"mDealt":29,"vHpLeft":5,"mHpLeft":544},{"day":89,"vid":"visjoin_85","mid":"strike","wave":4,"outcome":"vFlee","rounds":1,"vTaken":45,"mDealt":15,"vHpLeft":21,"mHpLeft":684}],"kills":[{"day":90,"mid":"strike","wave":4,"by":"gen_d6y1a5a","via":"player"}],"musterEvents":[],"census":[{"day":2,"uw":1,"rank":"village"},{"day":2,"uw":1,"rank":"village"},{"day":4,"uw":1,"rank":"village"},{"day":4,"uw":1,"rank":"village"},{"day":5,"uw":1,"rank":"village"},{"day":6,"uw":1,"rank":"village"},{"day":7,"uw":1,"rank":"village"},{"day":8,"uw":1,"rank":"village"},{"day":9,"uw":1,"rank":"village"},{"day":10,"uw":1,"rank":"village"},{"day":11,"uw":1,"rank":"village"},{"day":12,"uw":1,"rank":"village"},{"day":13,"uw":1,"rank":"village"},{"day":14,"uw":1,"rank":"village"},{"day":15,"uw":1,"rank":"village"},{"day":16,"uw":1,"rank":"village"},{"day":17,"uw":1,"rank":"village"},{"day":18,"uw":1,"rank":"village"},{"day":19,"uw":1,"rank":"village"},{"day":20,"uw":2,"rank":"village"},{"day":21,"uw":2,"rank":"village"},{"day":22,"uw":2,"rank":"village"},{"day":23,"uw":2,"rank":"village"},{"day":24,"uw":2,"rank":"village"},{"day":25,"uw":2,"rank":"village"},{"day":26,"uw":2,"rank":"village"},{"day":27,"uw":2,"rank":"village"},{"day":28,"uw":2,"rank":"village"},{"day":29,"uw":2,"rank":"village"},{"day":30,"uw":2,"rank":"village"},{"day":31,"uw":2,"rank":"village"},{"day":32,"uw":2,"rank":"village"},{"day":33,"uw":2,"rank":"village"},{"day":34,"uw":2,"rank":"village"},{"day":35,"uw":2,"rank":"village"},{"day":36,"uw":2,"rank":"village"},{"day":37,"uw":2,"rank":"village"},{"day":38,"uw":2,"rank":"village"},{"day":39,"uw":2,"rank":"village"},{"day":40,"uw":2,"rank":"village"},{"day":41,"uw":3,"rank":"village"},{"day":42,"uw":3,"rank":"village"},{"day":43,"uw":4,"rank":"village"},{"day":44,"uw":4,"rank":"village"},{"day":45,"uw":4,"rank":"village"},{"day":46,"uw":4,"rank":"village"},{"day":47,"uw":4,"rank":"regional"},{"day":48,"uw":4,"rank":"regional"},{"day":49,"uw":4,"rank":"regional"},{"day":50,"uw":4,"rank":"regional"},{"day":51,"uw":4,"rank":"regional"},{"day":52,"uw":4,"rank":"regional"},{"day":53,"uw":4,"rank":"regional"},{"day":54,"uw":4,"rank":"regional"},{"day":55,"uw":4,"rank":"regional"},{"day":56,"uw":4,"rank":"regional"},{"day":57,"uw":4,"rank":"regional"},{"day":58,"uw":4,"rank":"regional"},{"day":59,"uw":4,"rank":"regional"},{"day":60,"uw":4,"rank":"regional"},{"day":61,"uw":4,"rank":"regional"},{"day":62,"uw":4,"rank":"regional"},{"day":63,"uw":4,"rank":"regional"},{"day":64,"uw":4,"rank":"regional"},{"day":65,"uw":4,"rank":"regional"},{"day":66,"uw":4,"rank":"regional"},{"day":67,"uw":4,"rank":"regional"},{"day":68,"uw":4,"rank":"regional"},{"day":69,"uw":4,"rank":"regional"},{"day":70,"uw":4,"rank":"regional"},{"day":71,"uw":4,"rank":"regional"},{"day":72,"uw":4,"rank":"regional"},{"day":73,"uw":4,"rank":"regional"},{"day":74,"uw":4,"rank":"regional"},{"day":75,"uw":4,"rank":"regional"},{"day":76,"uw":4,"rank":"regional"},{"day":77,"uw":4,"rank":"national"},{"day":78,"uw":4,"rank":"regional"},{"day":79,"uw":4,"rank":"regional"},{"day":80,"uw":4,"rank":"regional"},{"day":81,"uw":4,"rank":"regional"},{"day":82,"uw":4,"rank":"regional"},{"day":83,"uw":4,"rank":"regional"},{"day":84,"uw":4,"rank":"regional"},{"day":85,"uw":4,"rank":"regional"},{"day":86,"uw":4,"rank":"regional"},{"day":87,"uw":4,"rank":"regional"},{"day":88,"uw":4,"rank":"regional"},{"day":89,"uw":4,"rank":"regional"}],"transcripts":[{"cls":"herald-refused-first","day":73,"mid":"herald","muster":{"present":false,"alliesRaw":0,"alliesUnique":0,"havenRaw":0,"havenUnique":0,"need":null,"readyProxy":null},"sayDuring":["⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."],"lines":["🚶 Elif is back with Yara.","💧 Werner returns with water: +4 clean.","Iron cold. Even the ticks are shelved.","— MIDDAY — Honest work hours. Heat builds.","You wait. The light changes. Nothing asks anything of you.","You catch fragments by the fire — Fang telling Nikos about Yara. Half of it's true anymore. You're not sure which half.","🩹 Werner is hurting (16 HP) — You patch them up before they head out. (16 → 41 HP)","👥 Elif heads out to forage. \"Gone looking. Don't wait up.\"","👥 Werner walks out with Elif. \"Nobody walks alone today.\"","🌿 Ella returns from foraging the wilds: +260 kcal to the pantry.","🌿 Fang returns from foraging the wilds: +567 kcal to the pantry.","— DUSK — Animals stir again. Shadows lengthen.","You wait. The light changes. Nothing asks anything of you.","Tebogo left 1 wood log by the stash. No announcement. That's how it works here.","👥 Ella heads out for water. \"Fetching water. Somebody has to.\"","👥 Fang walks out with Ella. \"Nobody walks alone today.\"","— NIGHT — Camp. Rest — or risk the dark.","Night. The treeline is just a sound now. The fire is the whole argument against it.","You wait. The light changes. Nothing asks anything of you.","💛 You hold Field suture kit. You practiced on an orange. 'People are just oranges that bleed,' your instructor said, and then taught you how to not flinch. You haven't flinched since. Your gifts are not mastered — but they are lived-in, and they are with you. The feast was the weapon. (The next feast grants FEASTED until tomorrow's dawn: strikes & abilities uplifted, devotion ×1.5 — richer feasts hit harder.)","Travel 1 tile to wetland.","You work the patch with practiced hands: 9× Sassafras, 9× Muscadine Grapes (990 kcal). This patch is picked clean — it'll recover in a few days.","Travel 1 tile to Haven.","While you were gone — one thing you missed:","🩸 The Reunion mauled Werner (-62 health) over 1 round. They're lucky to be breathing. — staying out of sight for the rest of the day — too hurt to meet it again","You keep a day's food (1445 kcal) — nothing extra for the pantry this time.","You walk back into Haven. 46 Codex entries. The village is glad to see you.","You settle into the hall floor. Sleep takes you.","You catch fragments by the fire — Ella telling Nikos about Elif. The story's getting bigger than what happened.","🌿 Elif returns from foraging the wilds: +225 kcal to the pantry.","🚶 Werner is back with Elif.","🗣️ Nikos to Ella, by the fire: \"Why them? ...Sorry. It's just sitting there, and they're the one who has to sit in it.\"","🐗 RAID — 3 raiders (The Callback, The Herald, The Reunion) hit Haven in the night, drawn by the smell of the pantry! The palisade's stakes take their toll as they come over the wall.","🐗⚠️ One of them is bigger than the usual teeth at the door — The Herald came with this raid, and the wall was not built for its kind.","🕯️ The treeline is still torn up from the raid when the System's light comes for them. Nobody is ready. The light doesn't wait.","🚨 The Callback, The Herald, The Reunion is at Haven's door. The village looks to you. Four ways to call: a RUNNER (slow, dangerous), a SIGNAL FIRE (fast, loud, everyone sees), the SYSTEM RELAY (if it can carry voices), or an ABILITY CRY (if your build has one). Each with honest costs.","💡 COUNTER LEARNED — The Callback: Say the goodbye — properly, out loud. It wears someone you buried. Every few rounds the face shifts and borrows their swing. Speak to it AS them — say the goodbye properly, out loud — and it loses coherence; the face cannot borrow a swing from someone who has been mourned. (Werner lived to tell it, twice — the village pieced it together.)","📓 Codex: Counter: Say the goodbye — properly, out loud — It wears someone you buried. Every few rounds the face shifts and borrows their swing. Speak to it AS them — say the goodbye properly, out loud — and it loses coherence; the face cannot borrow a swing from someone who has been mourned.","Nobody met The Herald — it's still out there at the treeline. It'll gorge every night until it's driven off.","Nobody met The Reunion — it's still out there at the treeline. It'll gorge every night until it's driven off.","🛡️ Werner met them at the door — 1 barely walked away. Werner is hurt.","The watch holds the wall. You sleep through the worst of it — or would have, if the shouting had let you.","It's settled. The village is calling it \"Loud-Eyes.\" The Codex keeps it.","◈ The System files the name away with visible satisfaction. It has so few words for things that bleed. (+2 integration)","⚠ WARNING: reserves critical. Eat tomorrow or the spiral begins.","Village meal: +2552 kcal, +1L water from the communal pantry.","🩹 You make rounds — Werner gets bound up properly. (11 → 26 HP)","Werner came back with 485 kcal of something edible. The pantry breathes.","Elif came back with 359 kcal of something edible. The pantry breathes.","🤒 Werner is feverish, a cut gone hot and angry. Rest and clean water — or it gets worse. You're already boiling water. It's handled.","🛟 Elif looks up from the fire. \"And now sickness, on top of it all. The options stand — pick, before we lose the chance.\"","🌙 Raid — Emberhold came in the night from the northeast. They carried off ~400 kcal from the pantry. Nobody's dead, but the message is clear: the ground is theirs too, and they're done asking. (Trust -10.)","— DAY 72 DAWN — The world wakes. Animals are active.","Overnight, Blackberry went bad — beyond saving. You leave it for the flies.","Fresh food keeps days, not weeks. Smoke it over a fire to make it last.","◈ WORD TRAVELS — riders from Thornfield bring talk of Haven. Out there they call you the Feared. The show's narration lingers on your hands.","📊 THE STANDINGS — Haven sits 1st of 7. Haven leads. The audience has a favorite, and it's you.","Werner Santos reads the sky: snow tomorrow, freezing.","Riders from Stonebridge: something's at THEIR door now. They can't spare anyone — and they wanted Haven to know first.","You wake with a start — something is wrong.","📦 A care package drops from the sky with a little parachute. There's a note: \"WE LOVE YOU! — your showbiz fans\"","Inside: Starfall bow","Plus 30 kcal of fan-approved snacks.","No risky water to boil.","Drank clean water.","You catch fragments by the fire — Tebogo telling Fang about Elif. It's picking up decorations as it travels.","🚶 Yara is back with Nikos.","🚶 Nikos is back with Yara.","Elif heads out for water. \"Off to the well — back with a full skin.\"","Iron cold. Even the ticks are shelved.","— MIDDAY — Honest work hours. Heat builds.","You wait. The light changes. Nothing asks anything of you.","No risky water to boil.","Drank clean water.","💬 Yara says: \"Someone's been leaving food out. Good food. Don't ask me how I know it wasn't one of us.\"","Yara heads out for water. \"Thirst doesn't negotiate. Going.\"","Nikos heads out for water. \"Fetching water. Somebody has to.\"","— DUSK — Animals stir again. Shadows lengthen.","You wait. The light changes. Nothing asks anything of you.","The cistern is dry. Haul from a creek (risky water), or put someone on water duty.","💧 Elif returns with water: +4 clean.","💧 Ella returns with water: +4 clean.","🚶 Fang is back with Ella.","— NIGHT — Camp. Rest — or risk the dark.","The fire burns lower than it should. Nobody wants to be the one to go for wood in the dark.","You wait. The light changes. Nothing asks anything of you.","💛 You hold Field suture kit. You practiced on an orange. 'People are just oranges that bleed,' your instructor said, and then taught you how to not flinch. You haven't flinched since. Your gifts are not mastered — but they are lived-in, and they are with you. The feast was the weapon. (The next feast grants FEASTED until tomorrow's dawn: strikes & abilities uplifted, devotion ×1.5 — richer feasts hit harder.)","Travel 1 tile to wetland.","It followed you. The Callback is here.","👥 The Reunion watches Werner — learning their moves.","📖 The Codex turns a page on its own. Werner is dead. You didn't ask. It knew.","Nobody's talking much. The fire feels smaller tonight.","📖 The entry for Werner is finished. No more pages.","You catch fragments by the fire — Yara telling Nikos about himself. Someone's added a flourish that wasn't there this morning.","This patch is worked out — step to another green patch and forage again.","Travel 2 tiles to grove.","It followed you. The Callback is here.","This patch is worked out — step to another green patch and forage again.","Travel 2 tiles to trail edge.","This patch is worked out — step to another green patch and forage again.","Travel 1 tile to Haven.","While you were gone — 2 things you missed:","🩸 The Callback mauled Werner (-50 health) over 2 rounds. They're lucky to be breathing. — staying out of sight for the rest of the day — too hurt to meet it again","💀 The Reunion killed Werner in 1 round. The village mourns.","You keep a day's food (990 kcal) — nothing extra for the pantry this time.","You walk back into Haven. 46 Codex entries. The village is glad to see you.","You settle into the hall floor. Sleep takes you.","💧 Yara returns with water: +2 clean.","💧 Nikos returns with water: +4 clean.","🌙 Night. The lingering The Herald gorges at the treeline — 0 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","🌙 Night. The lingering The Reunion gorges at the treeline — 0 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","A stranger at the tree line, watching. Not hiding, exactly. Measuring. They'll be gone by dusk — but they'll remember what they saw.","⚠ WARNING: reserves critical. Eat tomorrow or the spiral begins.","No food in the pantry. The village is hungry. You still get your 1L water.","Someone is crying, quietly, in one of the bunks. Yara goes to sit with them.","🔍 Ella has been turning over broad floating leaves and white-blue flowers on still water for days — today it clicked. \"I know this one now. Look — see the leaves?\"","Ella came back with 360 kcal of something edible. The pantry breathes.","🤒 Nikos is achy and wrung out, barely eating. Rest and clean water — or it gets worse. You're already boiling water. It's handled.","— DAY 73 DAWN — The world wakes. Animals are active.","👀 \"surgeon, huh?\" Nikos nods — then, an hour later, drops a shop-talk detail no surgeon would ever get right. They catch themselves. Too late.","👀 Nikos says they want to belong somewhere. But they keep doing the exact thing someone who wants something else would do — and going quiet when anyone notices.","👀 You caught Elif rehearsing — muttering details about Denver under their breath before the evening fire, like someone cramming for a part.","💬 Tebogo says: \"Dreamed again. They showed me teeth. Lots of teeth. Be ready to fight soon.\"","Word with the traders: Stonebridge door is clear again. Whatever had them, let go.","Your stomach is a fist. Eat — anything real, now.","Dawn. You wake rested. (+5 health, energy restored. Your sleeping body burned less — 663 kcal conserved. By the fire. Good enough.)","You chew the Sassafras deliberately — the way you were taught. Bitter, working. (+8 health)","You eat Muscadine Grapes and Sassafras (990 kcal).","Took Foraged food.","You eat Foraged food (200 kcal).","Took Foraged food.","You eat Foraged food (200 kcal).","Took Foraged food.","You eat Foraged food (200 kcal).","No risky water to boil.","Drank clean water.","Tebogo left 2 bark strips by the stash. No announcement. That's how it works here.","👂 Overheard — Elif: \"The birds went quiet an hour before the last one came. Remember that.\"","👂 Overheard — Ella: \"I was thinking the same thing. People need to hear that.\"","Its posture changes. Curiosity is over.","📯 It moves.","Elif heads out for water. \"Thirst doesn't negotiate. Going.\"","👥 Ella heads out to forage. \"Gone looking. Don't wait up.\"","👥 Fang walks out with Ella. \"Nobody walks alone today.\"","Iron cold. Even the ticks are shelved.","— MIDDAY — Honest work hours. Heat builds.","The relief moment passes — the crisis runs its own course now. What you did stands; what you didn't, doesn't.","You wait. The light changes. Nothing asks anything of you.","Filled 1L (clean — Haven well). 3L carried (3kg). (-10 kcal hauling, 1 tick.) Cistern: 5L left.","⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."]}],"musterRefusals":[{"idx":0,"day":73,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic.","have":0,"need":10,"musterExists":false,"alliesRaw":0,"alliesUnique":0,"havenValid":0,"readyManual":false,"readyGame":false,"omenStage":2,"omenDay":65,"links":[{"villageId":"village_0","name":"Emberhold","trust":83,"opinion":35,"arrears":4000,"quota":6,"facesFree":6,"already":0,"wouldRefuse":true,"wouldYield":0},{"villageId":"village_1","name":"Stonebridge","trust":47,"opinion":30,"arrears":16980,"quota":2,"facesFree":0,"already":0,"wouldRefuse":true,"wouldYield":0},{"villageId":"village_2","name":"Thornfield","trust":54,"opinion":35,"arrears":4000,"quota":2,"facesFree":5,"already":0,"wouldRefuse":true,"wouldYield":0}],"linksActive":3,"callYield":0,"callOffered":true,"commitOffered":true,"volunteers":2,"outcomesPrior":0,"callsSoFar":{"soundTitanCall":0,"titanCommitOwn":0,"titanSelfDo":0,"titanWarCouncil":0}},{"idx":1,"day":73,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic.","have":0,"need":10,"musterExists":false,"alliesRaw":0,"alliesUnique":0,"havenValid":0,"readyManual":false,"readyGame":false,"omenStage":2,"omenDay":65,"links":[{"villageId":"village_0","name":"Emberhold","trust":83,"opinion":35,"arrears":4000,"quota":6,"facesFree":6,"already":0,"wouldRefuse":true,"wouldYield":0},{"villageId":"village_1","name":"Stonebridge","trust":47,"opinion":30,"arrears":16980,"quota":2,"facesFree":0,"already":0,"wouldRefuse":true,"wouldYield":0},{"villageId":"village_2","name":"Thornfield","trust":54,"opinion":35,"arrears":4000,"quota":2,"facesFree":5,"already":0,"wouldRefuse":true,"wouldYield":0}],"linksActive":3,"callYield":0,"callOffered":true,"commitOffered":true,"volunteers":2,"outcomesPrior":1,"callsSoFar":{"soundTitanCall":0,"titanCommitOwn":0,"titanSelfDo":0,"titanWarCouncil":0}},{"idx":2,"day":73,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You ca