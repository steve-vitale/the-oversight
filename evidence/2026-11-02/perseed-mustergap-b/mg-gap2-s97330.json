  "anchoredLines": [
    {
      "day": 22,
      "line": "🌒 Dusk. They come out of the treeline in a knot — 3 of them, thin and road-worn — and stop at the edge of your firelight like they're not sure they're allowed closer. The oldest steps forward. \"Rosa Diallo. From Stonebridge.\" A pause. \"We're asking for a fire.\""
    },
    {
      "day": 25,
      "line": "🌒 Dusk. They come out of the treeline in a knot — 2 of them, thin and road-worn — and stop at the edge of your firelight like they're not sure they're allowed closer. The oldest steps forward. \"Cole Dubois. From Emberhold.\" A pause. \"We're asking for a fire.\""
    },
    {
      "day": 39,
      "line": "🌒 Dusk. They come out of the treeline in a knot — 1 of them, thin and road-worn — and stop at the edge of your firelight like they're not sure they're allowed closer. The oldest steps forward. \"Elena Kowalski. From Thornfield.\" A pause. \"We're asking for a fire.\""
    },
    {
      "day": 85,
      "line": "📯 THE CALL GOES OUT — THE HERALD must fall, and no one fire can do it."
    },
    {
      "day": 85,
      "line": "— Emberhold answers! Theo Ali and Amara Haddad will march. (trust holds — they are counting on you.)"
    },
    {
      "day": 85,
      "line": "— Stonebridge answers! Hank Reyes and Amara Cohen will march. (trust holds — they are counting on you.)"
    },
    {
      "day": 85,
      "line": "— Thornfield answers! Sam Garcia and Tariq Costa will march. (trust holds — they are counting on you.)"
    },
    {
      "day": 85,
      "line": "🛡️ Nora, Vera, Omar step forward. They will march with the muster, eat from your stores (1000 kcal/day each), and stand in front of THE HERALD. They can die — Haven does not get them back, and the fire will be quieter. Tap again — Haven sends its own."
    },
    {
      "day": 85,
      "line": "🛡️ Haven commits its own: Nora, Vera, Omar march with the muster. Not loaned. Not asked-for. Ours. The coalition counts 9 blades against THE HERALD — it needs 10."
    }
  ],
