  {
   "day": 9,
   "npc": "Sal",
   "want": "ask_favor",
   "wantStage": 3,
   "turn": 3,
   "spokenInSitting": true,
   "invitePendingHeld": false,
   "spokenBeatTag": "invitation",
   "thread": "want",
   "themSoFar": [
    "\"We're down to 6 liters of clean water. Haul the creek with me at dawn? Two buckets each, there and back.\"",
    "\"Wait — I'm away from Haven right now, out on the road. I can't promise a dawn meet from out here — find me when I'm back and we'll set it then.\"",
    "\"Come see what I found. You won't believe it.\""
   ],
   "menuLabels": [
    "betrayal:accept=\"All right. Let's go.\"",
    "betrayal:decline=\"Not this time.\""
   ]
  }
