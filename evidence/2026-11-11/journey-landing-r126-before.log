  {
   "day": 8,
   "npc": "Nadia",
   "want": "curious",
   "wantStage": 2,
   "turn": 6,
   "spokenInSitting": true,
   "invitePendingHeld": false,
   "spokenBeatTag": "invitation",
   "thread": "want",
   "themSoFar": [
    "\"Look, forget it. You wanted something? You know?\"",
    "\"Alright. But I'm not carrying your stuff.\"",
    "\"Walk with me? I want another pair of eyes on something.\""
   ],
   "menuLabels": [
    "betrayal:accept=\"All right. Let's go.\"",
    "betrayal:decline=\"Not this time.\""
   ]
