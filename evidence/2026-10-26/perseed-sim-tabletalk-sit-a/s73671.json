 "fireside": [
  {
   "day": 4,
   "speaker": "A woman, maybe 60s",
   "listener": "Theo",
   "text": "\"Stone. We need 59 more for the palisade footings. Creek beds, hillsides — pry it loose.\""
  },
  {
   "day": 11,
   "speaker": "Grace",
   "listener": "Owen",
   "text": "\"Stone. We need 48 more for the palisade footings. Creek beds, hillsides — pry it loose.\""
  },
  {
   "day": 16,
   "speaker": "Sigrid",
   "listener": "Brunhilde",
   "text": "\"167 wood. We need 350. The forest isn't going to cut itself.\""
  },
  {
   "day": 24,
   "speaker": "Sigrid",
   "listener": "Tesfaye",
   "text": "\"The pantry's the thing. We don't raise The Palisade on empty shelves — 8,314 of 14,000 kcal.\""
