    "beatLines": [
      {
        "day": 1,
        "vid": "fatima_hassan",
        "kcal": 800,
        "line": "🍽️ The bins are thin, and Fatima looks it. You set your second half in front of Fatima. 'Eat,' you say. Fatima eats like someone making up for days."
      },
      {
        "day": 138,
        "vid": "chloe_dubois",
        "kcal": 1080,
        "line": "🍽️ You wave off the second scoop and nod toward Chloe. 'Chloe eats first tonight.' Nobody at the fire disagrees."
      },
      {
        "day": 141,
        "vid": "chloe_dubois",
        "kcal": 1376,
        "line": "🍽️ The bins are thin, and Chloe looks it. You set your second half in front of Chloe. 'Eat,' you say. Chloe eats like someone making up for days."
      },
      {
        "day": 142,
        "vid": "emma_larsen",
        "kcal": 500,
        "line": "🍽️ Half your share tonight. You hand the rest to Emma, who takes it with both hands and doesn't say a word until it's gone."
      },
      {
        "day": 143,
        "vid": "miguel_santos",
        "kcal": 1000,
        "line": "🍽️ You wave off the second scoop and nod toward Miguel. 'Miguel eats first tonight.' Nobody at the fire disagrees."
      },
      {
        "day": 144,
        "vid": "miguel_santos",
        "kcal": 1404,
        "line": "🍽️ Thin day. Your bowl stays half-full — the other half goes to Miguel, who's been quiet about being hungry."
      },
      {
        "day": 145,
        "vid": "chloe_dubois",
        "kcal": 500,
        "line": "🍽️ You push half your bowl across the fire to Chloe — 'eat. You need it more than I do.' Chloe doesn't argue. The bowl comes back scraped clean."
      },
      {
        "day": 163,
        "vid": "visjoin_149",
        "kcal": 1320,
        "line": "🍽️ You wave off the second scoop and nod toward Carolina. 'Carolina eats first tonight.' Nobody at the fire disagrees."
