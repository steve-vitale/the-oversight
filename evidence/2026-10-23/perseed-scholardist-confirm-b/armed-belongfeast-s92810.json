      {
        "day": 77,
        "vid": "gen_lvmc1vc",
        "kcal": 1427,
        "line": "🍽️ Half your share tonight. You hand the rest to Marco, who takes it with both hands and doesn't say a word until it's gone."
      },
      {
        "day": 115,
        "vid": "gen_4jqjavh",
        "kcal": 500,
        "line": "🍽️ You push half your bowl across the fire to Murilo — 'eat. You need it more than I do.' Murilo doesn't argue. The bowl comes back scraped clean."
      }
    ]
