    "beatLines": [
      {
        "day": 49,
        "vid": "nikolai_volkov",
        "kcal": 1200,
        "line": "🍽️ You push half your bowl across the fire to Nikolai — 'eat. You need it more than I do.' Nikolai doesn't argue. The bowl comes back scraped clean."
      },
      {
        "day": 52,
        "vid": "gen_kenjr1y",
        "kcal": 1213,
        "line": "🍽️ You wave off the second scoop and nod toward Moritz. 'Moritz eats first tonight.' Nobody at the fire disagrees."
      },
      {
        "day": 60,
        "vid": "gen_kenjr1y",
        "kcal": 1200,
        "line": "🍽️ The bins are thin, and Moritz looks it. You set your second half in front of Moritz. 'Eat,' you say. Moritz eats like someone making up for days."
      },
      {
        "day": 66,
        "vid": "gen_kenjr1y",
        "kcal": 1500,
        "line": "🍽️ Half your share tonight. You hand the rest to Moritz, who takes it with both hands and doesn't say a word until it's gone."
      },
      {
        "day": 127,
        "vid": "visjoin_124",
        "kcal": 1459,
        "line": "🍽️ You wave off the second scoop and nod toward Celestin. 'Celestin eats first tonight.' Nobody at the fire disagrees."
      },
      {
        "day": 128,
        "vid": "visjoin_124",
        "kcal": 100,
        "line": "🍽️ Thin day. Your bowl stays half-full — the other half goes to Celestin, who's been quiet about being hungry."
      },
      {
        "day": 129,
        "vid": "naran_tumen",
