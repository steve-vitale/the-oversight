        "day": 39,
        "vid": "victor_lopez",
        "kcal": 1403,
        "line": "🍽️ Thin day. Your bowl stays half-full — the other half goes to Victor, who's been quiet about being hungry."
      },
      {
        "day": 63,
        "vid": "diana_osei",
        "kcal": 500,
        "line": "🍽️ You wave off the second scoop and nod toward Diana. 'Diana eats first tonight.' Nobody at the fire disagrees."
      },
      {
        "day": 74,
        "vid": "victor_lopez",
        "kcal": 1105,
        "line": "🍽️ Thin day. Your bowl stays half-full — the other half goes to Victor, who's been quiet about being hungry."
      },
      {
        "day": 76,
        "vid": "luis_fernandez",
        "kcal": 1200,
        "line": "🍽️ The bins are thin, and Luis looks it. You set your second half in front of Luis. 'Eat,' you say. Luis eats like someone making up for days."
      },
      {
        "day": 89,
        "vid": "gen_dct1w2m",
        "kcal": 1124,
        "line": "🍽️ Thin day. Your bowl stays half-full — the other half goes to Puka, who's been quiet about being hungry."
      },
      {
        "day": 90,
        "vid": "victor_lopez",
        "kcal": 1200,
        "line": "🍽️ You push half your bowl across the fire to Victor — 'eat. You need it more than I do.' Victor doesn't argue. The bowl comes back scraped clean."
      },
      {
        "day": 91,
        "vid": "visjoin_75",
        "kcal": 520,
        "line": "🍽️ The bins are thin, and Jayden looks it. You set your second half in front of Jayden. 'Eat,' you say. Jayden eats like someone making up for days."
      },
      {
        "day": 92,
        "vid": "visjoin_75",
        "kcal": 300,
        "line": "🍽️ Half your share tonight. You hand the rest to Jayden, who takes it with both hands and doesn't say a word until it's gone."
      }
    ]
