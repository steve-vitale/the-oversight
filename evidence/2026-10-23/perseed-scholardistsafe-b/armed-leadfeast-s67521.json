      {
        "day": 44,
        "vid": "gen_kenjr1y",
        "kcal": 1000,
        "line": "🍽️ You push half your bowl across the fire to Moritz — 'eat. You need it more than I do.' Moritz doesn't argue. The bowl comes back scraped clean."
      },
      {
        "day": 46,
        "vid": "gen_kenjr1y",
        "kcal": 1270,
        "line": "🍽️ Half your share tonight. You hand the rest to Moritz, who takes it with both hands and doesn't say a word until it's gone."
      },
      {
        "day": 111,
        "vid": "nadia_khoury",
        "kcal": 1354,
        "line": "🍽️ Half your share tonight. You hand the rest to Nadia, who takes it with both hands and doesn't say a word until it's gone."
      },
      {
        "day": 117,
        "vid": "nikolai_volkov",
        "kcal": 1120,
        "line": "🍽️ You wave off the second scoop and nod toward Nikolai. 'Nikolai eats first tonight.' Nobody at the fire disagrees."
      },
      {
        "day": 124,
        "vid": "naran_tumen",
        "kcal": 1100,
        "line": "🍽️ You push half your bowl across the fire to Naran — 'eat. You need it more than I do.' Naran doesn't argue. The bowl comes back scraped clean."
      },
      {
        "day": 125,
        "vid": "naran_tumen",
        "kcal": 1380,
        "line": "🍽️ The bins are thin, and Naran looks it. You set your second half in front of Naran. 'Eat,' you say. Naran eats like someone making up for days."
      }
