rn@game.js:23350:42","Object.tickAction@game.js:19836:35","game.tickAction@favor-company.js:187:34","game.<computed>@timeSettlement.js:39:33","Object.eat@game.js:27532:25","Game.eat@journal.js:1422:23"],"cls":"FOUGHT","reason":null,"liveBefore":false,"pendingBefore":false,"pendingMidBefore":null,"pendingAfter":false,"pendingMidAfter":null,"muster":null,"scholarPos":{"mx":4,"my":4,"px":4,"py":4},"entityPos":{"tx":4,"ty":4,"mx":3,"my":3},"entityHp":{"hp":839,"maxHp":1500},"sayDuring":[],"gameOutcomes":[],"end":"lost"}],"fieldFights":[{"day":122,"vid":"zoe_adams","mid":"reunion","wave":4,"outcome":"vFlee","rounds":2,"vTaken":94,"mDealt":49,"vHpLeft":1,"mHpLeft":251},{"day":123,"vid":"app_mgpspipj139","mid":"reunion","wave":4,"outcome":"vFlee","rounds":1,"vTaken":68,"mDealt":20,"vHpLeft":8,"mHpLeft":231},{"day":125,"vid":"app_mgpspipj139","mid":"reunion","wave":4,"outcome":"vDie","rounds":1,"vTaken":45,"mDealt":0,"vHpLeft":0,"mHpLeft":231},{"day":127,"vid":"zoe_adams","mid":"reunion","wave":4,"outcome":"vFlee","rounds":1,"vTaken":45,"mDealt":23,"vHpLeft":28,"mHpLeft":208},{"day":128,"vid":"henry_zhang","mid":"herald","wave":4,"outcome":"vKill","rounds":0,"vTaken":0,"mDealt":14,"vHpLeft":82,"mHpLeft":0,"log":["Henry does not let it slip away — they close in and strike with the fire-hardened spear for 14 — The Herald falls. (Contact finish)"]},{"day":128,"vid":"greta_hansen","mid":"reunion","wave":4,"outcome":"vKill","rounds":0,"vTaken":0,"mDealt":12,"vHpLeft":96,"mHpLeft":0},{"day":134,"vid":"ruth_goldstein","mid":"editor","wave":5,"outcome":"vDie","rounds":2,"vTaken":104,"mDealt":8,"vHpLeft":0,"mHpLeft":1492},{"day":135,"vid":"henry_zhang","mid":"editor","wave":5,"outcome":"vFlee","rounds":1,"vTaken":74,"mDealt":15,"vHpLeft":13,"mHpLeft":1477}],"kills":[{"day":100,"mid":"strike","wave":4,"by":"gen_wtdz8rh","via":"player"},{"day":123,"mid":"influencer","wave":4,"by":"gen_ori1ksi","via":"player"},{"day":128,"mid":"herald","wave":4,"by":"henry_zhang","via":"wild"},{"day":128,"mid":"reunion","wave":4,"by":"greta_hansen","via":"wild"},{"day":129,"mid":"algorithm","wave":4,"by":"tom_baker","via":"player"}],"musterEvents":[],"census":[{"day":2,"uw":1,"rank":"village"},{"day":2,"uw":1,"rank":"village"},{"day":4,"uw":1,"rank":"village"},{"day":4,"uw":1,"rank":"village"},{"day":5,"uw":1,"rank":"village"},{"day":6,"uw":1,"rank":"village"},{"day":7,"uw":1,"rank":"village"},{"day":8,"uw":1,"rank":"village"},{"day":9,"uw":1,"rank":"village"},{"day":10,"uw":1,"rank":"village"},{"day":11,"uw":1,"rank":"village"},{"day":12,"uw":1,"rank":"village"},{"day":13,"uw":1,"rank":"village"},{"day":14,"uw":1,"rank":"village"},{"day":15,"uw":1,"rank":"village"},{"day":16,"uw":1,"rank":"village"},{"day":17,"uw":1,"rank":"village"},{"day":18,"uw":1,"rank":"village"},{"day":19,"uw":1,"rank":"village"},{"day":20,"uw":1,"rank":"village"},{"day":21,"uw":1,"rank":"village"},{"day":22,"uw":1,"rank":"village"},{"day":23,"uw":1,"rank":"village"},{"day":24,"uw":1,"rank":"village"},{"day":25,"uw":1,"rank":"village"},{"day":26,"uw":1,"rank":"village"},{"day":27,"uw":1,"rank":"village"},{"day":28,"uw":1,"rank":"village"},{"day":29,"uw":2,"rank":"village"},{"day":30,"uw":2,"rank":"village"},{"day":31,"uw":2,"rank":"village"},{"day":32,"uw":2,"rank":"village"},{"day":33,"uw":2,"rank":"village"},{"day":34,"uw":2,"rank":"village"},{"day":35,"uw":2,"rank":"village"},{"day":36,"uw":2,"rank":"village"},{"day":37,"uw":2,"rank":"village"},{"day":38,"uw":2,"rank":"village"},{"day":39,"uw":2,"rank":"village"},{"day":40,"uw":2,"rank":"village"},{"day":41,"uw":2,"rank":"village"},{"day":42,"uw":2,"rank":"village"},{"day":43,"uw":2,"rank":"village"},{"day":44,"uw":2,"rank":"village"},{"day":45,"uw":2,"rank":"village"},{"day":46,"uw":3,"rank":"village"},{"day":47,"uw":3,"rank":"regional"},{"day":48,"uw":3,"rank":"regional"},{"day":49,"uw":3,"rank":"regional"},{"day":50,"uw":3,"rank":"regional"},{"day":51,"uw":3,"rank":"regional"},{"day":52,"uw":3,"rank":"regional"},{"day":53,"uw":3,"rank":"regional"},{"day":54,"uw":3,"rank":"regional"},{"day":55,"uw":3,"rank":"regional"},{"day":56,"uw":4,"rank":"regional"},{"day":57,"uw":4,"rank":"regional"},{"day":58,"uw":4,"rank":"regional"},{"day":59,"uw":4,"rank":"regional"},{"day":60,"uw":4,"rank":"regional"},{"day":61,"uw":4,"rank":"regional"},{"day":62,"uw":4,"rank":"regional"},{"day":63,"uw":4,"rank":"regional"},{"day":64,"uw":4,"rank":"regional"},{"day":65,"uw":4,"rank":"regional"},{"day":66,"uw":4,"rank":"regional"},{"day":67,"uw":4,"rank":"regional"},{"day":68,"uw":4,"rank":"regional"},{"day":69,"uw":4,"rank":"regional"},{"day":70,"uw":4,"rank":"regional"},{"day":71,"uw":4,"rank":"regional"},{"day":72,"uw":4,"rank":"regional"},{"day":73,"uw":4,"rank":"regional"},{"day":74,"uw":4,"rank":"regional"},{"day":75,"uw":4,"rank":"regional"},{"day":76,"uw":4,"rank":"regional"},{"day":77,"uw":4,"rank":"national"},{"day":78,"uw":4,"rank":"national"},{"day":79,"uw":4,"rank":"national"},{"day":80,"uw":4,"rank":"national"},{"day":81,"uw":4,"rank":"national"},{"day":82,"uw":4,"rank":"national"},{"day":83,"uw":4,"rank":"national"},{"day":84,"uw":4,"rank":"national"},{"day":85,"uw":4,"rank":"national"},{"day":86,"uw":4,"rank":"national"},{"day":87,"uw":4,"rank":"national"},{"day":88,"uw":4,"rank":"national"},{"day":89,"uw":4,"rank":"national"},{"day":90,"uw":4,"rank":"national"},{"day":91,"uw":4,"rank":"national"},{"day":92,"uw":4,"rank":"national"},{"day":93,"uw":4,"rank":"national"},{"day":94,"uw":4,"rank":"national"},{"day":95,"uw":4,"rank":"national"},{"day":96,"uw":4,"rank":"national"},{"day":97,"uw":4,"rank":"national"},{"day":98,"uw":4,"rank":"national"},{"day":99,"uw":4,"rank":"national"},{"day":100,"uw":4,"rank":"national"},{"day":101,"uw":4,"rank":"national"},{"day":102,"uw":4,"rank":"national"},{"day":103,"uw":4,"rank":"national"},{"day":104,"uw":4,"rank":"national"},{"day":105,"uw":4,"rank":"national"},{"day":106,"uw":4,"rank":"national"},{"day":107,"uw":4,"rank":"national"},{"day":108,"uw":4,"rank":"national"},{"day":109,"uw":4,"rank":"national"},{"day":110,"uw":4,"rank":"national"},{"day":111,"uw":4,"rank":"national"},{"day":112,"uw":4,"rank":"national"},{"day":113,"uw":4,"rank":"national"},{"day":114,"uw":4,"rank":"national"},{"day":115,"uw":4,"rank":"national"},{"day":116,"uw":4,"rank":"national"},{"day":117,"uw":4,"rank":"national"},{"day":118,"uw":4,"rank":"national"},{"day":119,"uw":4,"rank":"national"},{"day":120,"uw":4,"rank":"national"},{"day":121,"uw":4,"rank":"national"},{"day":122,"uw":4,"rank":"national"},{"day":123,"uw":4,"rank":"national"},{"day":124,"uw":4,"rank":"national"},{"day":125,"uw":4,"rank":"national"},{"day":126,"uw":4,"rank":"national"},{"day":127,"uw":4,"rank":"national"},{"day":128,"uw":4,"rank":"national"},{"day":129,"uw":5,"rank":"national"},{"day":130,"uw":5,"rank":"national"},{"day":131,"uw":5,"rank":"national"},{"day":132,"uw":5,"rank":"global"},{"day":133,"uw":5,"rank":"global"},{"day":134,"uw":5,"rank":"global"},{"day":135,"uw":5,"rank":"global"},{"day":136,"uw":5,"rank":"global"},{"day":137,"uw":5,"rank":"global"},{"day":138,"uw":5,"rank":"global"},{"day":139,"uw":5,"rank":"global"}],"transcripts":[{"cls":"herald-refused-first","day":72,"mid":"herald","muster":{"present":false,"alliesRaw":0,"alliesUnique":0,"havenRaw":0,"havenUnique":0,"need":null,"readyProxy":null},"sayDuring":["⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."],"lines":["Eel's Full Discharge hits you for 11.","Gerald's gear absorbs 9.","Eel's Full Discharge hits Gerald for 9.","📖 Codex: Full Discharge — hits everything close around it. You won't forget this.","The crackling fades. It slides backward into the black water, done spending itself — for now.","It comes apart — no one in reach, no one chasing. The fight ends; they melt back into the wilds.","It got away. No meat, no trophy — but you're breathing, and now you know its moves.","Molly left 1 wood log by the stash. No announcement. That's how it works here.","You catch fragments by the fire — Gerald telling Tom about you. Someone's added a flourish that wasn't there this morning.","Word gets around the haven. Whatever that thing was — every fire has a theory tonight.","Back at the haven the argument starts: Gerald is calling it \"Big Big.\" The name's up for grabs — weigh in if you want.","Word gets around the haven. Whatever that thing was — everyone's talking about it now.","Back at the haven the argument starts: Gerald is calling it \"Loud-Eyes.\" They'll fight it out — weigh in if you want.","💧 Molly returns with water: +3 clean.","💧 Tangaroa returns with water: +4 clean.","Olayemi heads out for water. \"Off to the well — back with a full skin.\"","— NIGHT — Camp. Rest — or risk the dark.","Night settles. The fire is the whole world now. No watches posted. The dark feels bigger than it should.","You wait. The light changes. Nothing asks anything of you.","💛 You hold Knife roll. The dinner rush, the pass, the tickets coming faster than thought. You survived your first Saturday service at sixteen. The roll was the prize. Your gifts are not mastered — but they are lived-in, and they are with you. The feast was the weapon. (The next feast grants FEASTED until tomorrow's dawn: strikes & abilities uplifted, devotion ×1.5 — richer feasts hit harder.)","Travel 1 tile to grove.","It followed you. The Herald is here.","You work the patch with practiced hands: 4× Muscadine Grapes (360 kcal). This patch is picked clean — it'll recover in a few days.","Travel 1 tile to Haven.","The Herald stops at the boundary — pacing, unwilling. Something else is already here. It's still out there.","You keep a day's food (360 kcal) — nothing extra for the pantry this time.","You walk back into Haven. 34 Codex entries. The village is glad to see you.","You clear a dead bed. Sow fresh seed to start a new crop. (40 kcal.)","🫂 It moves.","You sow Muscadine Grapes: 365 days to first harvest. Later harvests need 45 days of regrowth. Tend daily; garden magic can accelerate growth. (2 units sown.)","You accept Emberhold's food — 1,678 kcal on the road, 2 day-parts out. Kenji clasps your runner's shoulder. \"That's what the fire network is FOR.\" (Trust +4.)","They're burying their speaker — grain can wait a week; grief can't. Tending resumes when the mourning lifts.","They're burying their speaker — grain can wait a week; grief can't. Tending resumes when the mourning lifts.","They're burying their speaker — grain can wait a week; grief can't. Tending resumes when the mourning lifts.","Dawn's an hour off — too late for real sleep. Rest a while instead, or wait for morning.","You catch fragments by the fire — Gerald telling Elijah about Tangaroa. The story's getting bigger than what happened.","You catch fragments by the fire — Molly telling Vasyl about Gerald. The truth left this story two fires ago. What's left is better theater.","💧 Gerald returns with water: +3 clean.","💧 Tom returns with water: +2 clean.","Gerald is stitching a tear shut by the door light, squinting at every stitch.","Tangaroa is sweeping ash and grit out through the door, steady strokes.","🌾 Tribute wagons from Emberhold turn at the gate — our shelves are full past tomorrow. \"Eat well,\" we send back. \"That IS your tribute this week.\" (Trust +1.)","🌾 Tribute wagons from Stonebridge turn at the gate — our shelves are full past tomorrow. \"Eat well,\" we send back. \"That IS your tribute this week.\" (Trust +1.)","🌾 Tribute wagons from Thornfield turn at the gate — our shelves are full past tomorrow. \"Eat well,\" we send back. \"That IS your tribute this week.\" (Trust +1.)","🧳 Word of Haven’s the televised games is doing work out there — Word comes late, through traders: The Bloodied has bound itself to Ashford. The region's map is being redrawn — not by Haven.","🧳 Word from The Bloodied: Tomás was killed — Deshawn did it, they say. (The truth: dead is dead; the killing part is gossip.)","🌙 Night. The lingering The Herald gorges at the treeline — 1,500 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","🌙 Night. The lingering The Reunion gorges at the treeline — 1,000 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","A stranger at the tree line, watching. Not hiding, exactly. Measuring. They'll be gone by dusk — but they'll remember what they saw.","That night, they bring Liam home. Nobody asks you to help carry; nobody has to. By morning the grave is dug by the fire, and the body is laid out beside it. The filling of it is yours.","It's settled. The village is calling it \"The Big Beast.\" The Codex keeps it.","◈ The System files the name away with visible satisfaction. It has so few words for things that bleed. (+2 integration)","★ IDENTIFIED: Assacu (Sandbox Tree). Assacu. Thorny trunk, exploding pods. Stay back. Uses unknown — harvest, taste, and learn.","SYSTEM: Oh! It has a NAME. You all love names.","📚 Village knowledge: Wei taught everyone about Assacu (Sandbox Tree). The Codex grows without you lifting a finger.","⚠ STARVING: health and energy falling. You went to bed on an empty stomach.","Village meal: +2200 kcal, +1L water from the communal pantry.","Someone is crying, quietly, in one of the bunks. Vasyl goes to sit with them.","Fireside lesson: Wei passes around Assacu (Sandbox Tree). Someone asks a dumb question. Nobody minds. That's how you learn.","Molly is hurt — a fall, a thorn, a bad step. (health 79/100)","Wei traded something with someone for something else. The barter economy stirs.","🍽️ Olayemi taps the pantry's fullest jar. \"More than we can eat before it turns. Rendering fat instead — the lamps won't fill themselves.\"","🍽️ Elijah taps the pantry door — full to bursting — and keeps the day's share in hand. \"Dinner's on me tonight, then.\"","💧 The cistern's recovered — full cups again, and nobody's guarding the dipper.","🤒 Tangaroa is achy and wrung out, barely eating. Rest and clean water — or it gets worse. You're already boiling water. It's handled.","🛟 Tangaroa stands up by the fire. \"We can't just watch the fever in the tents happen. Here's what we CAN do — pick one, maybe two, but everything costs something.\"","\"The sick need tending — triage tents, broth, boiled water. Or we tighten our belts and wait it out. Or the hale hunt while the sick lie still.\"","\"Or we rally,\" Tangaroa adds. \"Second shift, everybody. We work, we eat, we live — and we pay for it.\"","(Relief is open — triage, rations, hunt, or rally, from the beats row. Each option works once; the moment passes in ~3 days.)","🌙 Raid — The Hungry Road came in the night from the southeast. They trampled 2 garden plots into mud. Nobody's dead, but the message is clear: the ground is theirs too, and they're done asking. (Trust -10.)","The land is getting tired. The easy food is thinning.","🌪️ THE HERALD fed in the night — 180 kcal gone from your stores. It is eating the realm while you deliberate.","— DAY 71 DAWN — The world wakes. Animals are active.","The fire burns low. One new line in the journal: Assacu (Sandbox Tree) — named and noted.","👀 Gerald talks about wanting to belong somewhere the way people talk about weather — often, and with no plans to change it. The real wanting is somewhere they keep not looking.","🎁 You find a small bundle tucked where you'll find it. No one saw it left there.","\"The System flagged your sector. Move. NOW.\"","(469 kcal of dried meat and clean water. Nothing traceable.)","You wait. The light changes. Nothing asks anything of you.","No risky water to boil.","Drank clean water.","📯 It moves.","💧 Olayemi returns with water: +4 clean.","Tom heads out for water. \"Thirst doesn't negotiate. Going.\"","Iron cold. Even the ticks are shelved.","— MIDDAY — Honest work hours. Heat builds.","🎁 Kenji of Emberhold walks in with pack-mules and full baskets: 1,678 kcal, into Haven's bins — real pieces, honestly counted. \"Eat. We'll settle the books when the green comes back.\"","You wait. The light changes. Nothing asks anything of you.","No risky water to boil.","Drank clean water.","Its posture changes. Curiosity is over.","Olayemi heads out for water. \"Fetching water. Somebody has to.\"","Wei heads out for water. \"The well won't fill itself.\"","Elijah heads out for water. \"Water first. Everything else waits.\"","— DUSK — Animals stir again. Shadows lengthen.","You wait. The light changes. Nothing asks anything of you.","💛 You hold Knife roll. The dinner rush, the pass, the tickets coming faster than thought. You survived your first Saturday service at sixteen. The roll was the prize. Your gifts are not mastered — but they are lived-in, and they are with you. The feast was the weapon. (The next feast grants FEASTED until tomorrow's dawn: strikes & abilities uplifted, devotion ×1.5 — richer feasts hit harder.)","Travel 1 tile to grove.","It followed you. The Herald is here.","This patch is worked out — step to another green patch and forage again.","Travel 2 tiles to grove.","It followed you. The Herald is here.","This patch is worked out — step to another green patch and forage again.","The creek runs fast here — no crossing without a bridge or a swim.","Travel 1 tile to Haven.","You walk back into Haven. 35 Codex entries. The village is glad to see you.","You clear a dead bed. Sow fresh seed to start a new crop. (40 kcal.)","🫂 It moves.","They're burying their speaker — grain can wait a week; grief can't. Tending resumes when the mourning lifts.","They're burying their speaker — grain can wait a week; grief can't. Tending resumes when the mourning lifts.","They're burying their speaker — grain can wait a week; grief can't. Tending resumes when the mourning lifts.","You settle into the hall floor. Sleep takes you.","Molly heads out for water. \"Off to the well — back with a full skin.\"","💧 Tom returns with water: +2 clean.","— NIGHT — Camp. Rest — or risk the dark.","No watches tonight. Everyone sleeps with one ear open and pretends not to.","You catch fragments by the fire — Tangaroa telling Olayemi about Gerald. Someone's added a flourish that wasn't there this morning.","💧 Olayemi returns with water: +4 clean.","💧 Wei returns with water: +3 clean.","💧 Elijah returns with water: +3 clean.","Someone's retelling it again — Tom, out past the ridge. Tangaroa says \"Tom would've gone farther if we'd let them.\"","🌙 Night. The lingering The Herald gorges at the treeline — 1,400 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","🌙 Night. The lingering The Reunion gorges at the treeline — 697 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","A lean scout waits a while, then moves on down the road. Word travels about that, too.","Rain. Steady, cold, honest rain.","⚠ WARNING: reserves critical. Eat tomorrow or the spiral begins.","Village meal: +2200 kcal, +1L water from the communal pantry.","Molly traded something with someone for something else. The barter economy stirs.","Molly is hurt — a fall, a thorn, a bad step. (health 59/100)","Wei and Tangaroa lingered over the fire together.","🍽️ Vasyl rests a hand on the pantry door, satisfied. \"No one's going hungry this week. Sitting with the fever cases instead — someone should.\"","🍽️ Wei leaves the surplus by the fire for whoever's hungry. \"The pantry can't take it. We can.\"","🌙 Raid — Ashford came in the night from the southeast. They carried off ~1337 kcal from the pantry. Nobody's dead, but the message is clear: the ground is theirs too, and they're done asking. (Trust -10.)","— DAY 72 DAWN — The world wakes. Animals are active.","👀 You caught Olayemi rehearsing — muttering details about Denver under their breath before the evening fire, like someone cramming for a part.","◈ WORD TRAVELS — riders from Emberhold bring talk of Haven. Out there they call you the Indispensable. Other villages send envoys now. They need what you know.","📊 THE STANDINGS — Haven sits 1st of 8. Haven leads. The audience has a favorite, and it's you.","You wake with a start — something is wrong.","No risky water to boil.","Drank clean water.","Gerald left 3 vines by the stash. No announcement. That's how it works here.","📯 It moves.","💬 Elijah says: \"Do you ever feel it? Like the air leans in when something happens.\"","💧 Molly returns with water: +4 clean.","Olayemi heads out to forage. \"Out for a forage. If I'm late, start without me.\"","Iron cold. Even the ticks are shelved.","— MIDDAY — Honest work hours. Heat builds.","You wait. The light changes. Nothing asks anything of you.","Filled 1L (clean — Haven well). 3L carried (3kg). (-10 kcal hauling, 1 tick.) Cistern: 10L left.","⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."]},{"cls":"herald-refused-late","day":122,"mid":"herald","muster":{"present":false,"alliesRaw":0,"alliesUnique":0,"havenRaw":0,"havenUnique":0,"need":null,"readyProxy":null},"sayDuring":["⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."],"lines":["It spirals closer, wings catching light that isn't there. It's interested in you. Specifically you.","It lands. It folds its wings. The light in them is building.","👥 Vasyl heads out for water. \"The well won't fill itself.\"","👥 Elijah walks out with Vasyl. \"Nobody walks alone today.\"","— DUSK — Animals stir again. Shadows lengthen.","You wait. The light changes. Nothing asks anything of you.","💛 You hold Search locket. The last photo, the one where they're laughing at something off-camera. You'll ask the System what it wants, later. First: them. Your gifts are not mastered — but they are lived-in, and they are with you. The feast was the weapon. (The next feast grants FEASTED until tomorrow's dawn: strikes & abilities uplifted, devotion ×1.5 — richer feasts hit harder.)","Travel 1 tile to grove.","Something moves out there — The Terms of Service.","This patch is worked out — step to another green patch and forage again.","Travel 2 tiles to grove.","This patch is worked out — step to another green patch and forage again.","Travel 2 tiles to creek.","It followed you. The Herald is here.","This patch is worked out — step to another green patch and forage again.","Travel 1 tile to Haven.","The Herald stops at the boundary — pacing, unwilling. Something else is already here. It's still out there.","You keep a day's food (730 kcal) — nothing extra for the pantry this time.","You walk back into Haven. 51 Codex entries. The village is glad to see you.","You clear a dead bed. Sow fresh seed to start a new crop. (40 kcal.)","You sow Lamb's Quarters: 30 days to first harvest. Later harvests need 28 days of regrowth. Tend daily; garden magic can accelerate growth. (2 units sown.)","You coax 3 growing beds forward by 8 days. The next harvest carries the growth magic.","🦋 It moves.","(−200 kcal — food becomes green whisper.)","You settle into the hall floor. Sleep takes you.","Molly heads out for water. \"Water first. Everything else waits.\"","💧 Tom returns with water: +2 clean.","— NIGHT — Camp. Rest — or risk the dark.","Night settles. The fire is the whole world now. No watches posted. The dark feels bigger than it should.","Elijah left 3 wood logs by the stash. No announcement. That's how it works here.","💧 Tangaroa returns with water: +2 clean.","🚶 Wei is back with Tangaroa.","📨 Word came: Greta Hansen of Emberhold wants to join Haven. \"I saw you on the broadcast. You looked like people who eat.\" — they haven't set foot here. The village will judge.","The village debates Greta Hansen. Warm, mostly. \"One more pair of hands.\" (83% for.)","📨 The village didn't wait for you. Greta Hansen was vouched for around the fire — they're walking.","Accepted. Greta Hansen is walking. They'll reach Haven in a few days — membership starts when they arrive, but the village already counts them.","🚶 Zoe Adams walks in — pack light, eyes wide. Haven grows by one. (8 souls.)","📓 Codex: Zoe Adams arrived and joined.","🌙 Night. The lingering Ugly-Eyes gorges at the treeline — 1,200 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","🌙 Night. The lingering The Herald gorges at the treeline — 1,600 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","🌙 Night. The lingering The Loud Beast gorges at the treeline — 803 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","🌙 Night. The lingering The Influencer gorges at the treeline — 1,425 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","Someone walks in like they belong here, grinning. \"Heard about this place three valleys over. Had to see it.\" The System's show has an audience, and audiences talk.","A cold snap. Breath smokes. The woods go quiet.","⚠ STARVING: health and energy falling. The spiral has started.","Village meal: +2400 kcal, +1L water from the communal pantry.","Tom is hurt — a fall, a thorn, a bad step. (health 84/100)","Zoe and Tom lingered over the fire together.","🍽️ Wei stands in the pantry doorway a moment. \"Look at all this. Tending the fire today — someone ought to keep the stories.\"","🍽️ Elijah carries the day's surplus to the pantry door, thinks better of it, and turns back to the fire. \"It'll only rot in there. We eat.\"","💧 The cistern won't cover today — the hall's call, no vote needed: half rations until the water runs come back.","🪤 TRAP: Your Snare 1 tile north caught a Gray Squirrel! — set it, waited, and the old way worked. About 350 kcal on the bone — clean it quickly (knife). It rots fast.","🌪️ THE HERALD fed in the night — 630 kcal gone from your stores. It is eating the realm while you deliberate.","— DAY 121 DAWN — The world wakes. Animals are active.","📦 A care package drops from the sky with a little parachute. There's a note: \"WE LOVE YOU! — your showbiz fans\"","Inside: Starfall bow","Plus 52 kcal of fan-approved snacks.","💬 Molly says: \"If they're watching, let them watch me work. That's all I've got.\"","Snow by morning. (-7°C — Freezing) The ground goes iron — forage thin, walking dear.","The cold works on everyone — the village wakes aching from the deep cold.","Dawn. You wake rested. (+28 health, energy restored. By the fire. Good enough.)","No risky water to boil.","Drank clean water.","The village is rattled. Everyone's jumpy — eyes on the treeline.","⚔ UGLY-EYES! You're on your own.","You fling a handful of grit into its eyes. (pocket_sand: blinded)","Turn-based now. Tap a tile to move — speed is squares. Then act.","It lands on a branch at eye level — wings half-open, catching light that isn't there. Watching you watch it.","It lets go of the air and simply... drifts. Somewhere else. Hard to predict.","🐗 This one came with the raid on Haven — it was with the teeth at the door, not a lone wanderer.","(The game is telling you something: this is bigger than one person. Talk to your companions — \"We should name this. Us.\")","You catch fragments by the fire — Tangaroa telling Zoe about Vasyl. Half of it's true anymore. You're not sure which half.","You catch fragments by the fire — Molly telling Zoe about Tangaroa. The details have shifted. Nobody seems to mind.","💧 Molly returns with water: +4 clean.","👥 Tangaroa heads out to forage. \"Bringing dinner back. One way or another.\"","👥 Molly walks out with Tangaroa. \"Nobody walks alone today.\"","🚶 Elijah is back with Vasyl.","💧 Vasyl returns with water: +4 clean.","📖 Elijah is sorting their finds, setting each one in its place before the bundle gets tied.","Zoe is crouched over the embers, blowing soft, one hand blocking the draft.","Iron cold. Even the ticks are shelved.","— MIDDAY — Honest work hours. Heat builds.","AMBUSH: first blood. ×1.5.","OVERCHARGED ×1.25 (well-fed): food is fuel.","The Ugly-Eyes falls.","You STRIKE the moth for 55 (Hatchet).","📺 +5 style — solid hit","📺 +20 style — dropped the Ugly-Eyes!","Mostly wing. Crunchy. Tastes like dust and regret. It's dead. The carcass is there on the ground — search the body if you want the meat. But you don't know this flesh. Clean it, test it cautiously, or ask someone who knows. And don't leave it long: meat rots where it lies.","You came back bloody. Nobody asks. Someone saves you the good seat by the fire.","👥 Wei heads out for water. \"The well won't fill itself.\"","👥 Vasyl walks out with Wei. \"Nobody walks alone today.\"","— DUSK — Animals stir again. Shadows lengthen.","You wait. The light changes. Nothing asks anything of you.","📯 It moves.","Zoe left 3 bark strips by the stash. No announcement. That's how it works here.","You catch fragments by the fire — Zoe telling Tangaroa about Elijah. The story's getting bigger than what happened.","🚶 Molly is back with Tangaroa.","🌿 Tangaroa returns from foraging the wilds: +251 kcal to the pantry — the shelves are full, so 251 kcal is eaten at the fire instead.","👥 Zoe heads out for water. \"Water first. Everything else waits.\"","👥 Elijah walks out with Zoe. \"Nobody walks alone today.\"","— NIGHT — Camp. Rest — or risk the dark.","Night settles. The fire is the whole world now. No watches posted. The dark feels bigger than it should.","You wait. The light changes. Nothing asks anything of you.","💛 You hold Search locket. The last photo, the one where they're laughing at something off-camera. You'll ask the System what it wants, later. First: them. Your gifts are not mastered — but they are lived-in, and they are with you. The feast was the weapon. (The next feast grants FEASTED until tomorrow's dawn: strikes & abilities uplifted, devotion ×1.5 — richer feasts hit harder.)","Travel 1 tile to grove.","The Herald stops at the boundary — pacing, unwilling. Something else is already here. It's still out there.","This patch is worked out — step to another green patch and forage again.","Travel 2 tiles to grove.","Something pads into the clearing — The Herald. It's here.","This patch is worked out — step to another green patch and forage again.","Travel 2 tiles to creek.","The Herald stops at the boundary — pacing, unwilling. Something else is already here. It's still out there.","This patch is worked out — step to another green patch and forage again.","Travel 1 tile to Haven.","The Loud Beast stops at the boundary — pacing, unwilling. Something else is already here. It's still out there.","1 unprocessed haul onto the counter — the clock is ticking.","You walk back into Haven. 51 Codex entries. The village is glad to see you.","You clear a dead bed. Sow fresh seed to start a new crop. (40 kcal.)","You coax 3 growing beds forward by 8 days. The next harvest carries the growth magic.","(−200 kcal — food becomes green whisper.)","Taken: Gland sac x1, Ugly-Eyes (carcass) x1.","The body is stripped. What's left isn't worth taking.","✨ Ability gained: Echo Location (L1). Clap once: you sense the shape of the land — reveals the 3x3 world-map tiles around you. 1/day.","\"CLAP! The sound comes back with a MAP! You are the bat! (The bat is jealous!)\"","\"Earned, not given. You did the work — we just wrote it down.\"","You settle into the hall floor. Sleep takes you.","🚶 a quiet carpenter walks in — pack light, eyes wide. Haven grows by one. (9 souls.)","🌙 Night. The lingering The Herald gorges at the treeline — 1,000 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","🌙 Night. The lingering The Loud Beast gorges at the treeline — 1,000 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","🌙 Night. The lingering The Influencer gorges at the treeline — 1,290 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","A curious wanderer waits a while, then moves on down the road. Word travels about that, too.","⚠ STARVING: health and energy falling. The spiral has started.","Village meal: +2285 kcal, +1L water from the communal pantry.","Tangaroa came back with an armful of something edible, unprompted. (+100 kcal pantry)","Latifa is hurt — a fall, a thorn, a bad step. (health 72/100)","Latifa is hurt — a fall, a thorn, a bad step. (health 56/100)","🍽️ Vasyl lingers by the full pantry and laughs. \"Full shelves, full bellies. Mending the palisade today — the fence won't fix itself.\"","🍽️ Vasyl leaves the surplus by the fire for whoever's hungry. \"The pantry can't take it. We can.\"","🤒 Wei is achy and wrung out, barely eating. Rest and clean water — or it gets worse.","— DAY 122 DAWN — The world wakes. Animals are active.","Overnight, Wild Black Cherry went bad — beyond saving. You leave it for the flies.","Fresh food keeps days, not weeks. Smoke it over a fire to make it last.","💬 Elijah says: \"They said you're doing well. It sounded... proud? Can they feel proud?\"","Dawn. You wake rested. (+2 health, energy restored. By the fire. Good enough.)","No risky water to boil.","Drank clean water.","Elijah left 1 branch by the stash. No announcement. That's how it works here.","📯 It moves.","⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."]}],"musterRefusals":[{"idx":0,"day":72,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic.","have":0,"need":10,"musterExists":false,"alliesRaw":0,"alliesUnique":0,"havenValid":0,"readyManual":false,"readyGame":false,"omenStage":2,"omenDay":66,"links":[{"villageId":"village_0","name":"Emberhold","trust":69,"opinion":31,"arrears":0,"quota":2,"facesFree":3,"already":0,"wouldRefuse":false,"wouldYield":2},{"villageId":"village_1","name":"Stonebridge","trust":48,"opinion":35,"arrears":0,"quota":2,"facesFree":0,"already":0,"wouldRefuse":false,"wouldYield":0},{"villageId":"village_2","name":"Thornfield","trust":57,"opinion":31,"arrears":0,"quota":2,"facesFree":0,"already":0,"wouldRefuse":false,"wouldYield":0}],"linksActive":3,"callYield":2,"callOffered":true,"commitOffered":true,"volunteers":7,"outcomesPrior":0,"callsSoFar":{"soundTitanCall":0,"titanCommitOwn":0,"titanSelfDo":0,"titanWarCouncil":0}},{"idx":1,"day":72,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic.","have":0,"need":10,"musterExists":false,"alliesRaw":0,"alliesUnique":0,"havenValid":0,"readyManual":false,"readyGame":false,"omenStage":2,"omenDay":66,"links":[{"villageId":"village_0","name":"Emberhold","trust":69,"opinion":31,"arrears":0,"quota":2,"f