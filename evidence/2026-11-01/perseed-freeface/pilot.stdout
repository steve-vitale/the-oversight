","wave":4,"by":"tom_baker","via":"companion"},{"day":118,"mid":"eulogy","wave":4,"by":"gen_kui01j0","via":"player"}],"musterEvents":[],"census":[{"day":2,"uw":1,"rank":"village"},{"day":2,"uw":1,"rank":"village"},{"day":4,"uw":1,"rank":"village"},{"day":4,"uw":1,"rank":"village"},{"day":5,"uw":1,"rank":"village"},{"day":6,"uw":1,"rank":"village"},{"day":7,"uw":1,"rank":"village"},{"day":8,"uw":1,"rank":"village"},{"day":9,"uw":1,"rank":"village"},{"day":10,"uw":1,"rank":"village"},{"day":11,"uw":1,"rank":"village"},{"day":12,"uw":1,"rank":"village"},{"day":13,"uw":1,"rank":"village"},{"day":14,"uw":1,"rank":"village"},{"day":15,"uw":1,"rank":"village"},{"day":16,"uw":1,"rank":"village"},{"day":17,"uw":1,"rank":"village"},{"day":18,"uw":1,"rank":"village"},{"day":19,"uw":1,"rank":"village"},{"day":20,"uw":1,"rank":"village"},{"day":21,"uw":1,"rank":"village"},{"day":22,"uw":1,"rank":"village"},{"day":23,"uw":1,"rank":"village"},{"day":24,"uw":1,"rank":"village"},{"day":25,"uw":1,"rank":"village"},{"day":26,"uw":1,"rank":"village"},{"day":27,"uw":1,"rank":"village"},{"day":28,"uw":1,"rank":"village"},{"day":29,"uw":2,"rank":"village"},{"day":30,"uw":2,"rank":"village"},{"day":31,"uw":2,"rank":"village"},{"day":32,"uw":2,"rank":"village"},{"day":33,"uw":2,"rank":"village"},{"day":34,"uw":2,"rank":"village"},{"day":35,"uw":2,"rank":"village"},{"day":36,"uw":2,"rank":"village"},{"day":37,"uw":2,"rank":"village"},{"day":38,"uw":2,"rank":"village"},{"day":39,"uw":2,"rank":"village"},{"day":40,"uw":2,"rank":"village"},{"day":41,"uw":2,"rank":"village"},{"day":42,"uw":2,"rank":"village"},{"day":43,"uw":2,"rank":"village"},{"day":44,"uw":2,"rank":"village"},{"day":45,"uw":2,"rank":"village"},{"day":46,"uw":3,"rank":"village"},{"day":47,"uw":3,"rank":"regional"},{"day":48,"uw":3,"rank":"regional"},{"day":49,"uw":3,"rank":"regional"},{"day":50,"uw":3,"rank":"regional"},{"day":51,"uw":3,"rank":"regional"},{"day":52,"uw":3,"rank":"regional"},{"day":53,"uw":3,"rank":"regional"},{"day":54,"uw":3,"rank":"regional"},{"day":55,"uw":3,"rank":"regional"},{"day":56,"uw":4,"rank":"regional"},{"day":57,"uw":4,"rank":"regional"},{"day":58,"uw":4,"rank":"regional"},{"day":59,"uw":4,"rank":"regional"},{"day":60,"uw":4,"rank":"regional"},{"day":61,"uw":4,"rank":"regional"},{"day":62,"uw":4,"rank":"regional"},{"day":63,"uw":4,"rank":"regional"},{"day":64,"uw":4,"rank":"regional"},{"day":65,"uw":4,"rank":"regional"},{"day":66,"uw":4,"rank":"regional"},{"day":67,"uw":4,"rank":"regional"},{"day":68,"uw":4,"rank":"regional"},{"day":69,"uw":4,"rank":"regional"},{"day":70,"uw":4,"rank":"regional"},{"day":71,"uw":4,"rank":"regional"},{"day":72,"uw":4,"rank":"regional"},{"day":73,"uw":4,"rank":"regional"},{"day":74,"uw":4,"rank":"regional"},{"day":75,"uw":4,"rank":"regional"},{"day":76,"uw":4,"rank":"regional"},{"day":77,"uw":4,"rank":"national"},{"day":78,"uw":4,"rank":"national"},{"day":79,"uw":4,"rank":"national"},{"day":80,"uw":4,"rank":"national"},{"day":81,"uw":4,"rank":"national"},{"day":82,"uw":4,"rank":"national"},{"day":83,"uw":4,"rank":"national"},{"day":84,"uw":4,"rank":"national"},{"day":85,"uw":4,"rank":"national"},{"day":86,"uw":4,"rank":"national"},{"day":87,"uw":4,"rank":"national"},{"day":88,"uw":4,"rank":"national"},{"day":89,"uw":4,"rank":"national"},{"day":90,"uw":4,"rank":"national"},{"day":91,"uw":4,"rank":"national"},{"day":92,"uw":4,"rank":"national"},{"day":93,"uw":4,"rank":"national"},{"day":94,"uw":4,"rank":"national"},{"day":95,"uw":4,"rank":"national"},{"day":96,"uw":4,"rank":"national"},{"day":97,"uw":4,"rank":"national"},{"day":98,"uw":4,"rank":"national"},{"day":99,"uw":4,"rank":"national"},{"day":100,"uw":4,"rank":"national"},{"day":101,"uw":4,"rank":"national"},{"day":102,"uw":4,"rank":"national"},{"day":103,"uw":4,"rank":"national"},{"day":104,"uw":4,"rank":"national"},{"day":105,"uw":4,"rank":"national"},{"day":106,"uw":4,"rank":"national"},{"day":107,"uw":4,"rank":"national"},{"day":108,"uw":4,"rank":"national"},{"day":109,"uw":4,"rank":"national"},{"day":110,"uw":4,"rank":"national"},{"day":111,"uw":4,"rank":"national"},{"day":112,"uw":4,"rank":"global"},{"day":113,"uw":4,"rank":"global"},{"day":114,"uw":4,"rank":"global"},{"day":115,"uw":4,"rank":"global"},{"day":116,"uw":4,"rank":"global"},{"day":117,"uw":4,"rank":"global"},{"day":118,"uw":4,"rank":"global"},{"day":119,"uw":4,"rank":"global"},{"day":120,"uw":4,"rank":"global"},{"day":121,"uw":4,"rank":"global"},{"day":122,"uw":4,"rank":"global"},{"day":123,"uw":4,"rank":"global"},{"day":124,"uw":4,"rank":"global"},{"day":125,"uw":4,"rank":"global"},{"day":126,"uw":4,"rank":"global"},{"day":127,"uw":4,"rank":"global"},{"day":128,"uw":4,"rank":"global"},{"day":129,"uw":4,"rank":"global"},{"day":130,"uw":4,"rank":"global"},{"day":131,"uw":4,"rank":"global"},{"day":132,"uw":4,"rank":"global"},{"day":133,"uw":4,"rank":"global"},{"day":134,"uw":4,"rank":"global"},{"day":135,"uw":4,"rank":"global"},{"day":136,"uw":4,"rank":"global"},{"day":137,"uw":4,"rank":"global"},{"day":138,"uw":4,"rank":"global"},{"day":139,"uw":4,"rank":"global"},{"day":140,"uw":4,"rank":"global"},{"day":141,"uw":4,"rank":"global"},{"day":142,"uw":4,"rank":"global"},{"day":143,"uw":4,"rank":"global"},{"day":144,"uw":4,"rank":"global"},{"day":145,"uw":4,"rank":"global"},{"day":146,"uw":4,"rank":"global"},{"day":147,"uw":4,"rank":"global"},{"day":148,"uw":4,"rank":"global"},{"day":149,"uw":4,"rank":"global"},{"day":150,"uw":4,"rank":"global"},{"day":151,"uw":4,"rank":"global"},{"day":152,"uw":4,"rank":"global"},{"day":153,"uw":4,"rank":"global"}],"transcripts":[{"cls":"herald-refused-first","day":87,"mid":"herald","muster":{"present":false,"alliesRaw":0,"alliesUnique":0,"havenRaw":0,"havenUnique":0,"need":null,"readyProxy":null},"sayDuring":["⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."],"lines":["Gerald sets out to hunt The Mountain Lord. \"It was there. Going back for it.\"","Wei heads out to forage. \"Bringing dinner back. One way or another.\"","Elijah sets out to find Tom. \"Won't be long.\"","Vasyl heads out to check the snares. \"Wire doesn't lie.\"","— DUSK — Animals stir again. Shadows lengthen.","You wait. The light changes. Nothing asks anything of you.","You catch fragments by the fire — Wei telling Gerald about themself. The retelling is already better than the event.","💬 Wei mutters: \"Smile for the sky, they said. I hate how easy it was to start doing it.\"","🌿 Tom returns from foraging the wilds: +132 kcal to the pantry — the shelves are full, so 131 kcal is eaten at the fire instead.","— NIGHT — Camp. Rest — or risk the dark.","The fire burns lower than it should. Nobody wants to be the one to go for wood in the dark.","Word with the traders: Stonebridge door is clear again. Whatever had them, let go.","You wait. The light changes. Nothing asks anything of you.","💛 You hold Wedding ring. Breathe. The shaking eases. (−12 trauma)","💛 You hold Knife roll. The dinner rush, the pass, the tickets coming faster than thought. You survived your first Saturday service at sixteen. The roll was the prize. Your gifts are not mastered — but they are lived-in, and they are with you. The feast was the weapon. (The next feast grants FEASTED until tomorrow's dawn: strikes & abilities uplifted, devotion ×1.5 — richer feasts hit harder.)","Travel 1 tile to grove.","This patch is worked out — step to another green patch and forage again.","Travel 2 tiles to grove.","This patch is worked out — step to another green patch and forage again.","The creek runs fast here — no crossing without a bridge or a swim.","Travel 1 tile to Haven.","While you were gone — 2 things you missed:","⚔️ Vasyl stared down the Bailiff and it backed off — 0 rounds, not a scratch on them. It's still out there, somewhere.","⚔️ Elijah stared down the Bailiff and it backed off — 0 rounds, not a scratch on them. It's still out there, somewhere.","You keep a day's food (840 kcal) — nothing extra for the pantry this time.","You walk back into Haven. 44 Codex entries. The village is glad to see you.","📋 Gerald — 🎣 Fish. Gerald nods eagerly. They'll report back by next part.","📋 Wei — 🍲 Cook. Wei nods eagerly. They'll report back by next part.","They're burying their speaker — grain can wait a week; grief can't. Tending resumes when the mourning lifts.","They're burying their speaker — grain can wait a week; grief can't. Tending resumes when the mourning lifts.","They're burying their speaker — grain can wait a week; grief can't. Tending resumes when the mourning lifts.","You settle into the hall floor. Sleep takes you.","💧 Gerald eyes the cistern — full to the brim. No sense hauling water there's no room for; they turn to the stone pile instead.","🪨 Gerald pries 2 stone loose from the creek bed. The building pile grows. (128 stone now.)","🍲 Wei cooked for the haven — meals stretched. Wei worked the smoke racks too — 2 batches preserved (~1940 kcal, keeps for weeks).","You catch fragments by the fire — Gerald telling Tom about you. The story's getting bigger than what happened.","🌿 Wei returns from foraging the wilds: +275 kcal to the pantry — the shelves are full, so 274 kcal is eaten at the fire instead.","🪤 Vasyl is back. \"Snares were empty. They'll keep.\"","Victor waits two days at your fire, getting thinner. Nobody answers. They walk back to The Hungry Road with nothing. They'll remember the silence.","📨 Word came: Tariq Mahmood wants to join Haven. \"Heard about this place three valleys over. Had to try.\" — they haven't set foot here. The village will judge.","The village debates Dale Hoffman. The room is cold — Gerald, Olayemi, Wei against. \"More mouths, same fire.\" (0% for.)","🐗 RAID — 5 raiders (The Mountain Lord, The Bailiff, Sunback, Big-Eyes, The Herald) hit Haven in the night, drawn by the smell of the pantry! The palisade's stakes take their toll as they come over the wall.","🐗⚠️ One of them is bigger than the usual teeth at the door — The Herald came with this raid, and the wall was not built for its kind.","🚨 The Mountain Lord, The Bailiff, Sunback, Big-Eyes, The Herald is at Haven's door. The village looks to you. Four ways to call: a RUNNER (slow, dangerous), a SIGNAL FIRE (fast, loud, everyone sees), the SYSTEM RELAY (if it can carry voices), or an ABILITY CRY (if your build has one). Each with honest costs.","📓 Codex: you've heard of **Trophy Room**. Someone, somewhere, can do this. Now you know its name.","◈ The System names Olayemi: Stalker of the Apex Predator. The village repeats it at the fire.","◈ THE SYSTEM has been watching Olayemi — Combat 1. Three offers; they took Trophy Room. Earned, chosen. (trophy_room: villager level-up)","📓 Codex: Olayemi chose Trophy Room (trophy_room) at Combat 1.","Nobody met The Herald — it's still out there at the treeline. It'll gorge every night until it's driven off.","🛡️ Olayemi, Wei, Vasyl and Tom met them at the door — 4 driven off.","The watch holds the wall. You sleep through the worst of it — or would have, if the shouting had let you.","Ants march past your boot, laden. You follow them to a seep. +1L water (risky). (ant_trail)","⚠ WARNING: reserves critical. Eat tomorrow or the spiral begins.","Village meal: +2295 kcal, +1L water from the communal pantry.","Tom came back with 583 kcal of something edible. The pantry breathes.","🍽️ Vasyl lingers by the full pantry and laughs. \"Full shelves, full bellies. Mending the palisade today — the fence won't fix itself.\"","🍽️ Elijah looks at the full shelves and waves off the day's share. \"No more into the store — we eat at the fire, and the shelves keep.\"","🌿 Assacu (Sandbox Tree) — the foragers have handled it 8 days running. They know it now — which parts are worth hauling, which bruise, how it wants to be carried. The village's knowledge deepens.","💡 Assacu (Sandbox Tree): the village knows more than you do. Harvest it a few more times (0/3) and it'll click.","🌙 Raid — Thornfield came in the night from the southwest. They trampled 2 garden plots into mud. Nobody's dead, but the message is clear: the ground is theirs too, and they're done asking. (Trust -10.)","🌙 Raid — The Bloodied came in the night from the northeast. They trampled 2 garden plots into mud. Nobody's dead, but the message is clear: the ground is theirs too, and they're done asking. (Trust -10.)","🌙 Raid — The Hungry Road came in the night from the southeast. They carried off ~1485 kcal from the pantry. Nobody's dead, but the message is clear: the ground is theirs too, and they're done asking. (Trust -10.)","🌪️ THE HERALD struck Emberhold in the night. They bled while the coalition talked. (trust −5 — they notice who wasn't there.)","— DAY 86 DAWN — The world wakes. Animals are active.","Dawn. You wake rested. (+0 health, energy restored. By the fire. Good enough.)","Boiled 1L. Bacteria dead. (-35 kcal, 32 ticks tending the fire.)","Drank clean water.","📋 Gerald — 💧 Fetch water. Gerald nods eagerly. They'll report back by next part.","📯 It moves.","🌿 Tom checks the pantry before heading out — the shelves are full, ~5 days of fresh on hand… leaves the harvest standing and turns to the stone pile instead. The pantry can't take more; the wild will keep.","🪨 Tom pries 1 stone loose from the creek bed. The building pile grows. (129 stone now.)","💧 Gerald returns with 13L of creek water. Risky until the hearth boils it.","You catch fragments by the fire — Elijah telling Olayemi about you. Someone's added a flourish that wasn't there this morning.","Tom heads out to forage. \"Bringing dinner back. One way or another.\"","Iron cold. Even the ticks are shelved.","— MIDDAY — Honest work hours. Heat builds.","You wait. The light changes. Nothing asks anything of you.","You catch fragments by the fire — Gerald telling Tom about you. The story's getting bigger than what happened.","— DUSK — Animals stir again. Shadows lengthen.","You wait. The light changes. Nothing asks anything of you.","Its posture changes. Curiosity is over.","📯 It moves.","🚶 Elijah is back — found Tom.","🌿 Tom returns from foraging the wilds: +218 kcal to the pantry — the shelves are full, so 218 kcal is eaten at the fire instead.","— NIGHT — Camp. Rest — or risk the dark.","No watches tonight. Everyone sleeps with one ear open and pretends not to.","You wait. The light changes. Nothing asks anything of you.","💛 You hold Wedding ring. Gold band, worn thin. Inside: initials and a date. You remember the day — the rain, the borrowed suit, the laughter during the vows. Grief is just love with nowhere to go. Your gifts are not mastered — but they are lived-in, and they are with you. The feast was the weapon. (The next feast grants FEASTED until tomorrow's dawn: strikes & abilities uplifted, devotion ×3.0 — richer feasts hit harder.)","Travel 1 tile to grove.","It followed you. The Herald is here.","This patch is worked out — step to another green patch and forage again.","Travel 2 tiles to grove.","It followed you. The Herald is here.","This patch is worked out — step to another green patch and forage again.","The creek runs fast here — no crossing without a bridge or a swim.","Travel 1 tile to Haven.","While you were gone — 4 things you missed:","⚔️ Olayemi stared down the Mountain Lord and it backed off — 0 rounds, not a scratch on them. It's still out there, somewhere.","⚔️ Wei stared down the Bailiff and it backed off — 0 rounds, not a scratch on them. It's still out there, somewhere.","⚔️ Vasyl stared down the Sunback and it backed off — 0 rounds, not a scratch on them. It's still out there, somewhere.","⚔️ Tom stared down the Big-Eyes and it backed off — 0 rounds, not a scratch on them. It's still out there, somewhere.","You keep a day's food (840 kcal) — nothing extra for the pantry this time.","You walk back into Haven. 44 Codex entries. The village is glad to see you.","You clear a dead bed. Sow fresh seed to start a new crop. (40 kcal.)","You sow Wild Onion: 30 days to first harvest. Later harvests need 28 days of regrowth. Tend daily; garden magic can accelerate growth. (2 units sown.)","📋 Gerald — 🎣 Fish. Gerald nods eagerly. They'll report back by next part.","📋 Wei — 🍲 Cook. Wei nods eagerly. They'll report back by next part.","They're burying their speaker — grain can wait a week; grief can't. Tending resumes when the mourning lifts.","They're burying their speaker — grain can wait a week; grief can't. Tending resumes when the mourning lifts.","They're burying their speaker — grain can wait a week; grief can't. Tending resumes when the mourning lifts.","You settle into the hall floor. Sleep takes you.","🪵 Gerald hauls back 7 wood. The pile grows. (509 logs now.)","🍲 Wei cooked for the haven — meals stretched. Wei worked the smoke racks too — 2 batches preserved (~980 kcal, keeps for weeks).","Wei is stitching a tear shut by the door light, squinting at every stitch.","The village debates Tariq Mahmood. The room is cold — Gerald, Olayemi, Wei against. \"More mouths, same fire.\" (17% for.)","🚶 Zoe Adams walks in — pack light, eyes wide. Haven grows by one. (8 souls.)","📓 Codex: Zoe Adams arrived and joined.","📯 MUSTER — scouts report The Herald hunting near Haven, and it is beyond us. Everyone inside. No one walks the treeline alone — the garden crews double up, the hunters stand down. We outlast it.","🌙 Night. The lingering The Herald gorges at the treeline — 1,093 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","Riders on the ridge — no, a cart. A TRADER. Word travels: Haven has food, and where there's food there's trade.","⚠ WARNING: reserves critical. Eat tomorrow or the spiral begins.","Village meal: +2331 kcal, +1L water from the communal pantry.","Wei came back with an armful of something edible, unprompted. (+100 kcal pantry)","Gerald is hurt — a fall, a thorn, a bad step. (health 52/100)","Elijah and Wei lingered over the fire together.","Tom and Wei lingered over the fire together.","🍽️ Tom stands in the pantry doorway a moment. \"Look at all this. Tending the fire today — someone ought to keep the stories.\"","🍽️ Wei sets the sharing basket down by the fire instead of the pantry. \"Full shelves don't need my little more.\"","📓 Codex: Zoe taught Elijah Diplomatic Incident.","— DAY 87 DAWN — The world wakes. Animals are active.","👀 \"trail crew lead, huh?\" Olayemi nods — then, an hour later, drops a shop-talk detail no trail crew lead would ever get right. They catch themselves. Too late.","Dawn. You wake rested. (+0 health, energy restored. By the fire. Good enough.)","No risky water to boil.","Drank clean water.","📋 Gerald — 💧 Fetch water. Gerald nods eagerly. They'll report back by next part.","📯 It moves.","You catch fragments by the fire — Gerald telling Zoe about Wei. Half of it's true anymore. You're not sure which half.","You catch fragments by the fire — Elijah telling Zoe about you. Three retellings in, nobody remembers what actually happened — but everyone has opinions.","You catch fragments by the fire — Elijah telling Zoe about Gerald. It's picking up decorations as it travels.","You catch fragments by the fire — Gerald telling Tom about you. Someone's added a flourish that wasn't there this morning.","👥 Vasyl heads out for water. \"Water first. Everything else waits.\"","👥 Elijah walks out with Vasyl. \"Nobody walks alone today.\"","Tom heads out to forage. \"There's food out there. Going to find it.\"","Iron cold. Even the ticks are shelved.","— MIDDAY — Honest work hours. Heat builds.","You wait. The light changes. Nothing asks anything of you.","No risky water to boil.","Drank clean water.","📯 It moves.","⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."]}],"musterRefusals":[{"idx":0,"day":87,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic.","have":0,"need":10,"musterExists":false,"alliesRaw":0,"alliesUnique":0,"havenValid":0,"readyManual":false,"readyGame":false,"omenStage":2,"omenDay":66,"links":[{"villageId":"village_0","name":"Emberhold","trust":91,"opinion":42,"arrears":0,"quota":6,"facesFree":3,"already":0,"wouldRefuse":false,"wouldYield":3},{"villageId":"village_1","name":"Stonebridge","trust":84,"opinion":46,"arrears":0,"quota":6,"facesFree":0,"already":0,"wouldRefuse":false,"wouldYield":0},{"villageId":"village_2","name":"Thornfield","trust":88,"opinion":42,"arrears":0,"quota":6,"facesFree":0,"already":0,"wouldRefuse":false,"wouldYield":0}],"linksActive":3,"callYield":3,"callOffered":true,"commitOffered":true,"volunteers":4,"outcomesPrior":0,"callsSoFar":{"soundTitanCall":0,"titanCommitOwn":0,"titanSelfDo":0,"titanWarCouncil":0}},{"idx":1,"day":87,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic.","have":0,"need":10,"musterExists":false,"alliesRaw":0,"alliesUnique":0,"havenValid":0,"readyManual":false,"readyGame":false,"omenStage":2,"omenDay":66,"links":[{"villageId":"village_0","name":"Emberhold","trust":91,"opinion":42,"arrears":0,"quota":6,"facesFree":3,"already":0,"wouldRefuse":false,"wouldYield":3},{"villageId":"village_1","name":"Stonebridge","trust":84,"opinion":46,"arrears":0,"quota":6,"facesFree":0,"already":0,"wouldRefuse":false,"wouldYield":0},{"villageId":"village_2","name":"Thornfield","trust":88,"opinion":42,"arrears":0,"quota":6,"facesFre