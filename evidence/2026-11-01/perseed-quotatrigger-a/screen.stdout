unds":2,"vTaken":53,"mDealt":20,"vHpLeft":29,"mHpLeft":282,"log":["Samuel's gear absorbs 52.","R1: The Naming hits Samuel for 40 (42 left)","R1: Samuel strikes for 10 (292 left)","Samuel's gear absorbs 18.","R2: First Omen hits Samuel for 13 (29 left)","R2: Samuel strikes for 10 (282 left)","Samuel sees how this ends — and runs while running still works."]},{"day":151,"vid":"app_mgpspj78424","mid":"herald","wave":4,"outcome":"vFlee","rounds":2,"vTaken":60,"mDealt":25,"vHpLeft":33,"mHpLeft":257,"log":["R1: Samuel strikes for 12 (270 left)","Samuel's gear absorbs 58.","R1: The Naming hits Samuel for 44 (49 left)","Samuel's gear absorbs 20.","R2: First Omen hits Samuel for 16 (33 left)","R2: Samuel strikes for 13 (257 left)","Samuel sees how this ends — and runs while running still works."]},{"day":153,"vid":"app_mgpspj78424","mid":"algorithm","wave":4,"outcome":"vFlee","rounds":1,"vTaken":56,"mDealt":14,"vHpLeft":23,"mHpLeft":986},{"day":155,"vid":"henry_zhang","mid":"herald","wave":4,"outcome":"mFlee","rounds":0,"vTaken":0,"mDealt":16,"vHpLeft":100,"mHpLeft":66,"log":["Henry closes in and strikes with the fire-hardened spear for 16 (66 left) — but The Herald breaks away all the same."]},{"day":155,"vid":"app_mgpspj78424","mid":"influencer","wave":4,"outcome":"vFlee","rounds":2,"vTaken":45,"mDealt":23,"vHpLeft":49,"mHpLeft":614},{"day":159,"vid":"app_mgpsphjh82","mid":"algorithm","wave":4,"outcome":"vDie","rounds":1,"vTaken":86,"mDealt":16,"vHpLeft":0,"mHpLeft":970},{"day":164,"vid":"app_mgpspj78424","mid":"influencer","wave":4,"outcome":"vFlee","rounds":2,"vTaken":41,"mDealt":21,"vHpLeft":54,"mHpLeft":380},{"day":170,"vid":"henry_zhang","mid":"influencer","wave":4,"outcome":"vFlee","rounds":4,"vTaken":65,"mDealt":30,"vHpLeft":35,"mHpLeft":350},{"day":170,"vid":"henry_zhang","mid":"influencer","wave":4,"outcome":"vFlee","rounds":1,"vTaken":21,"mDealt":15,"vHpLeft":14,"mHpLeft":335},{"day":171,"vid":"henry_zhang","mid":"suburb","wave":4,"outcome":"vFlee","rounds":1,"vTaken":23,"mDealt":14,"vHpLeft":19,"mHpLeft":961}],"kills":[],"musterEvents":[],"census":[{"day":2,"uw":1,"rank":"village"},{"day":2,"uw":1,"rank":"village"},{"day":4,"uw":1,"rank":"village"},{"day":4,"uw":1,"rank":"village"},{"day":5,"uw":1,"rank":"village"},{"day":6,"uw":1,"rank":"village"},{"day":7,"uw":1,"rank":"village"},{"day":8,"uw":1,"rank":"village"},{"day":9,"uw":1,"rank":"village"},{"day":10,"uw":1,"rank":"village"},{"day":11,"uw":1,"rank":"village"},{"day":12,"uw":1,"rank":"village"},{"day":13,"uw":1,"rank":"village"},{"day":14,"uw":1,"rank":"village"},{"day":15,"uw":1,"rank":"village"},{"day":16,"uw":1,"rank":"village"},{"day":17,"uw":1,"rank":"village"},{"day":18,"uw":1,"rank":"village"},{"day":19,"uw":1,"rank":"village"},{"day":20,"uw":1,"rank":"village"},{"day":21,"uw":1,"rank":"village"},{"day":22,"uw":1,"rank":"village"},{"day":23,"uw":1,"rank":"village"},{"day":24,"uw":1,"rank":"village"},{"day":25,"uw":1,"rank":"village"},{"day":26,"uw":1,"rank":"village"},{"day":27,"uw":1,"rank":"village"},{"day":28,"uw":1,"rank":"village"},{"day":29,"uw":2,"rank":"village"},{"day":30,"uw":2,"rank":"village"},{"day":31,"uw":2,"rank":"village"},{"day":32,"uw":2,"rank":"village"},{"day":33,"uw":2,"rank":"village"},{"day":34,"uw":2,"rank":"village"},{"day":35,"uw":2,"rank":"village"},{"day":36,"uw":2,"rank":"village"},{"day":37,"uw":2,"rank":"village"},{"day":38,"uw":2,"rank":"village"},{"day":39,"uw":2,"rank":"village"},{"day":40,"uw":2,"rank":"village"},{"day":41,"uw":2,"rank":"village"},{"day":42,"uw":2,"rank":"village"},{"day":43,"uw":2,"rank":"village"},{"day":44,"uw":2,"rank":"village"},{"day":45,"uw":2,"rank":"village"},{"day":46,"uw":2,"rank":"village"},{"day":47,"uw":2,"rank":"village"},{"day":48,"uw":2,"rank":"village"},{"day":49,"uw":2,"rank":"village"},{"day":50,"uw":2,"rank":"village"},{"day":51,"uw":2,"rank":"village"},{"day":52,"uw":2,"rank":"village"},{"day":53,"uw":2,"rank":"regional"},{"day":54,"uw":2,"rank":"regional"},{"day":55,"uw":2,"rank":"regional"},{"day":56,"uw":2,"rank":"regional"},{"day":57,"uw":2,"rank":"regional"},{"day":58,"uw":2,"rank":"regional"},{"day":59,"uw":2,"rank":"regional"},{"day":60,"uw":2,"rank":"regional"},{"day":61,"uw":2,"rank":"regional"},{"day":62,"uw":2,"rank":"regional"},{"day":63,"uw":2,"rank":"regional"},{"day":64,"uw":2,"rank":"regional"},{"day":65,"uw":2,"rank":"regional"},{"day":66,"uw":2,"rank":"regional"},{"day":67,"uw":2,"rank":"regional"},{"day":68,"uw":2,"rank":"regional"},{"day":69,"uw":2,"rank":"regional"},{"day":70,"uw":2,"rank":"regional"},{"day":71,"uw":2,"rank":"regional"},{"day":72,"uw":2,"rank":"regional"},{"day":73,"uw":2,"rank":"regional"},{"day":74,"uw":2,"rank":"regional"},{"day":75,"uw":2,"rank":"regional"},{"day":76,"uw":2,"rank":"regional"},{"day":77,"uw":2,"rank":"regional"},{"day":78,"uw":2,"rank":"regional"},{"day":79,"uw":2,"rank":"regional"},{"day":80,"uw":2,"rank":"regional"},{"day":81,"uw":2,"rank":"regional"},{"day":82,"uw":2,"rank":"regional"},{"day":83,"uw":2,"rank":"national"},{"day":84,"uw":2,"rank":"national"},{"day":85,"uw":2,"rank":"global"},{"day":86,"uw":2,"rank":"global"},{"day":87,"uw":2,"rank":"global"},{"day":88,"uw":2,"rank":"global"},{"day":89,"uw":2,"rank":"global"},{"day":90,"uw":2,"rank":"global"},{"day":91,"uw":2,"rank":"global"},{"day":92,"uw":2,"rank":"global"},{"day":93,"uw":2,"rank":"global"},{"day":94,"uw":2,"rank":"global"},{"day":95,"uw":2,"rank":"global"},{"day":96,"uw":2,"rank":"global"},{"day":97,"uw":2,"rank":"global"},{"day":98,"uw":2,"rank":"global"},{"day":99,"uw":2,"rank":"global"},{"day":100,"uw":2,"rank":"global"},{"day":101,"uw":2,"rank":"global"},{"day":102,"uw":2,"rank":"global"},{"day":103,"uw":2,"rank":"global"},{"day":104,"uw":2,"rank":"global"},{"day":105,"uw":2,"rank":"global"},{"day":106,"uw":2,"rank":"global"},{"day":107,"uw":2,"rank":"global"},{"day":108,"uw":2,"rank":"global"},{"day":109,"uw":2,"rank":"global"},{"day":110,"uw":2,"rank":"global"},{"day":111,"uw":2,"rank":"global"},{"day":112,"uw":3,"rank":"global"},{"day":113,"uw":3,"rank":"global"},{"day":114,"uw":3,"rank":"global"},{"day":115,"uw":3,"rank":"global"},{"day":116,"uw":3,"rank":"global"},{"day":117,"uw":3,"rank":"global"},{"day":118,"uw":3,"rank":"global"},{"day":119,"uw":4,"rank":"global"},{"day":120,"uw":4,"rank":"global"},{"day":121,"uw":4,"rank":"global"},{"day":122,"uw":4,"rank":"global"},{"day":123,"uw":4,"rank":"global"},{"day":124,"uw":4,"rank":"global"},{"day":125,"uw":4,"rank":"global"},{"day":126,"uw":4,"rank":"global"},{"day":127,"uw":4,"rank":"global"},{"day":128,"uw":4,"rank":"global"},{"day":129,"uw":4,"rank":"global"},{"day":130,"uw":4,"rank":"global"},{"day":131,"uw":4,"rank":"global"},{"day":132,"uw":4,"rank":"global"},{"day":133,"uw":4,"rank":"global"},{"day":134,"uw":4,"rank":"global"},{"day":135,"uw":4,"rank":"global"},{"day":136,"uw":4,"rank":"global"},{"day":137,"uw":4,"rank":"global"},{"day":138,"uw":4,"rank":"global"},{"day":139,"uw":4,"rank":"global"},{"day":140,"uw":4,"rank":"global"},{"day":141,"uw":4,"rank":"global"},{"day":142,"uw":4,"rank":"global"},{"day":143,"uw":4,"rank":"global"},{"day":144,"uw":4,"rank":"global"},{"day":145,"uw":4,"rank":"global"},{"day":146,"uw":4,"rank":"global"},{"day":147,"uw":4,"rank":"global"},{"day":148,"uw":4,"rank":"global"},{"day":149,"uw":4,"rank":"global"},{"day":150,"uw":4,"rank":"global"},{"day":151,"uw":4,"rank":"global"},{"day":152,"uw":4,"rank":"global"},{"day":153,"uw":4,"rank":"global"},{"day":154,"uw":4,"rank":"global"},{"day":155,"uw":4,"rank":"global"},{"day":156,"uw":4,"rank":"global"},{"day":157,"uw":4,"rank":"global"},{"day":158,"uw":4,"rank":"global"},{"day":159,"uw":4,"rank":"global"},{"day":160,"uw":4,"rank":"global"},{"day":161,"uw":4,"rank":"global"},{"day":162,"uw":4,"rank":"global"},{"day":163,"uw":4,"rank":"global"},{"day":164,"uw":4,"rank":"global"},{"day":165,"uw":4,"rank":"global"},{"day":166,"uw":4,"rank":"global"},{"day":167,"uw":4,"rank":"global"},{"day":168,"uw":4,"rank":"global"},{"day":169,"uw":4,"rank":"global"},{"day":170,"uw":4,"rank":"global"},{"day":171,"uw":4,"rank":"global"},{"day":172,"uw":4,"rank":"global"}],"transcripts":[{"cls":"herald-refused-late","day":138,"mid":"herald","muster":{"present":false,"alliesRaw":0,"alliesUnique":0,"havenRaw":0,"havenUnique":0,"need":null,"readyProxy":null},"sayDuring":["⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."],"lines":["👄 SMACKING — audible chewing from a mile off. It eats forage (300 kcal). The belly swells. (+0 damage growth. Total eaten: 600 kcal. Poison the meal, starve the field, or end it.)","Your strikes land harder. (x1.15 training)","(eater's hide absorbs 12.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the eater for 54 (Hunting spear).","📺 +5 style — solid hit","👄 SMACKING — audible chewing from a mile off. It eats forage (300 kcal). The belly swells. (+0 damage growth. Total eaten: 900 kcal. Poison the meal, starve the field, or end it.)","💥 It slams through!","Armor absorbs 38.","Eater's attack hits you for 43.","📖 Codex: Smack-Rush — charges in a straight line, trampling everything in its path. You won't forget this.","Your strikes land harder. (x1.15 training)","(eater's hide absorbs 12.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the eater for 51 (Hunting spear).","📺 +5 style — solid hit","👄 SMACKING — audible chewing from a mile off. It eats forage (300 kcal). The belly swells. (+0 damage growth. Total eaten: 1200 kcal. Poison the meal, starve the field, or end it.)","Your strikes land harder. (x1.15 training)","(eater's hide absorbs 12.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the eater for 50 (Hunting spear).","📺 +5 style — solid hit","👄 SMACKING — audible chewing from a mile off. It eats forage (300 kcal). The belly swells. (+0 damage growth. Total eaten: 1500 kcal. Poison the meal, starve the field, or end it.)","Your strikes land harder. (x1.15 training)","(eater's hide absorbs 12.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the eater for 49 (Hunting spear).","📺 +5 style — solid hit","👄 SMACKING — audible chewing from a mile off. It eats forage (300 kcal). The belly swells. (+0 damage growth. Total eaten: 1800 kcal. Poison the meal, starve the field, or end it.)","It lowers its maw to the grid and EATS — crops, forage, the dirt itself. It grows as it chews. (EXPOSED — hit it now, it takes half again as much.)","Your strikes land harder. (x1.15 training)","(eater's hide absorbs 12.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","It is exposed — the hit lands clean, half again as hard.","eater is hurt — and it goes quiet and clever. It stops rushing. It starts CHOOSING. Watch the spacing.","You STRIKE the eater for 74 (Hunting spear).","📺 +5 style — solid hit","👄 SMACKING — audible chewing from a mile off. It eats forage (300 kcal). The belly swells. (+0 damage growth. Total eaten: 2100 kcal. Poison the meal, starve the field, or end it.)","Your strikes land harder. (x1.15 training)","(eater's hide absorbs 12.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the eater for 77 (Hunting spear).","📺 +5 style — solid hit","👄 SMACKING — audible chewing from a mile off. It eats forage (300 kcal). The belly swells. (+0 damage growth. Total eaten: 2400 kcal. Poison the meal, starve the field, or end it.)","Your strikes land harder. (x1.15 training)","(eater's hide absorbs 12.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the eater for 75 (Hunting spear).","📺 +5 style — solid hit","👄 SMACKING — audible chewing from a mile off. It eats forage (300 kcal). The belly swells. (+0 damage growth. Total eaten: 2700 kcal. Poison the meal, starve the field, or end it.)","💥 Smack-Rush!","Armor absorbs 34.","Eater's Smack-Rush hits you for 38.","👄 SMACKING — audible chewing from a mile off. It eats forage (300 kcal). The belly swells. (+0 damage growth. Total eaten: 3000 kcal. Poison the meal, starve the field, or end it.)","👄 SMACKING — audible chewing from a mile off. It eats forage (300 kcal). The belly swells. (+0 damage growth. Total eaten: 3300 kcal. Poison the meal, starve the field, or end it.)","👄 SMACKING — audible chewing from a mile off. It eats forage (300 kcal). The belly swells. (+0 damage growth. Total eaten: 3600 kcal. Poison the meal, starve the field, or end it.)","💥 Smack-Rush!","Armor absorbs 38.","Eater's Smack-Rush hits you for 44.","You go down.","📖 The Codex turns a page on its own. Chloe Dubois is dead. You didn't ask. It knew.","Nobody's talking much. The fire feels smaller tonight.","🕯️ Chloe is dead — and the dead hold no treaties. Every link Haven has shakes.","Stonebridge watches to see if Haven holds without its dead — and presses the tribute down to 1,688 kcal/week while the chair is empty. They'll test the link. Count on it.","Thornfield watches to see if Haven holds without its dead — and presses the tribute down to 1,688 kcal/week while the chair is empty. They'll test the link. Count on it.","The Bloodied watches to see if Haven holds without its dead — and presses the tribute down to 1,688 kcal/week while the chair is empty. They'll test the link. Count on it.","🕯️ Chloe Dubois is dead — the wild. The village stops. Somebody screams. Somebody else starts digging.","\"Chloe's gone.\" Oliver looks at you for a long moment. \"You're not Chloe.\" No heat in it. Just fact. You'll have to earn this face.","The Codex doesn't pause for grief. Alejandro blinks — and it's already there, overlaying everything, syncing. No pen. No paper. The mantle just... transfers.","🌟 \"MANTLE TRANSFER DETECTED. ...Oh! New face! Same job! Whole new set of tricks. We hardly noticed. (That is a lie. We noticed. The audience CRIED.)\"","📖 The Codex turns a page: Chloe Dubois, 137 days. The mantle passes to Alejandro Liang.","🪞 You wake up somebody else. Alejandro Liang, 65 — a Vintner. Their hands know different work now: Green Whisper, Green Thumb, Literally, War Cry, Scream Cheese.","The village's quarrel was with Chloe — and Chloe is dead. The sentence doesn't cross the grave. You're someone else now; the docket is empty, but the village remembers.","You knew Chloe — not the office, the person. The fire keeps expecting her, and so do you. That's a heavier kind of stepping up. (+5 trauma)","At the grave, Max, Maya, Nina and 3 more speak for Alejandro — \"Chloe trusted them. We saw it. Give them the fire's hearing.\" The village listens.","The fire knew Alejandro before the Codex did — their name already carried weight here.","💛 You hold Trail compass. Breathe. The shaking eases. (−6 trauma)","Travel 1 tile to creek.","The Herald stops at the boundary — pacing, unwilling. Something else is already here. It's still out there.","This patch is worked out — step to another green patch and forage again.","Travel 3 tiles to trail edge.","It followed you. The Big Beast is here.","Nothing left to take here today.","Travel 2 tiles to Haven.","The Big Beast stops at the boundary — pacing, unwilling. Something else is already here. It's still out there.","You walk back into Haven. 47 Codex entries. The village is glad to see you.","You clear a dead bed. Sow fresh seed to start a new crop. (40 kcal.)","Taken: Sinew cord x1, Stripped hide x1.","The body is stripped. What's left isn't worth taking.","You are full enough.","Took Foraged food (dried).","You eat Foraged food (dried) (80 kcal).","Your chewing echoes off the trees. Something out there heard. (encounters more likely tomorrow)","Took Foraged food (dried).","You eat Foraged food (dried) (160 kcal).","Took Foraged food (dried).","You eat Foraged food (dried) (160 kcal).","Took Foraged food (dried).","You eat Foraged food (dried) (160 kcal).","Took Foraged food (dried).","You eat Foraged food (dried) (160 kcal).","Took Foraged food (dried).","You eat Foraged food (dried) (160 kcal).","You settle into the hall floor. Sleep takes you.","💧 Oliver returns with water: +4 clean.","The village debates Sanne Bakker. The room is cold — Max, Maya, Nina against. \"More mouths, same fire.\" (0% for.)","🌙 Night. The lingering The Herald gorges at the treeline — 1,200 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","A stranger at the tree line, watching. Not hiding, exactly. Measuring. They'll be gone by dusk — but they'll remember what they saw.","It's settled. The village is calling it \"The Ugly Beast.\" The Codex keeps it.","◈ The System files the name away with visible satisfaction. It has so few words for things that bleed. (+2 integration)","⚠ WARNING: reserves critical. Eat tomorrow or the spiral begins.","Village meal: +2272 kcal, +1L water from the communal pantry.","🩹 You make rounds — Oliver gets bound up properly. (57 → 72 HP)","Oliver: \"Walked past a good stand of jujube. Worth remembering where.\"","🍽️ Oliver taps the pantry's fullest jar. \"More than we can eat before it turns. Rendering fat instead — the lamps won't fill themselves.\"","🍽️ Oliver taps the pantry door — full to bursting — and keeps the day's share in hand. \"Dinner's on me tonight, then.\"","Emberhold's speaker sent a runner: the northwest ground feeds both villages or neither. They want to talk — properly, at their fire. Ignoring this is also an answer.","🌙 Raid — Thornfield came in the night from the southeast. They carried off ~800 kcal from the pantry. Nobody's dead, but the message is clear: the ground is theirs too, and they're done asking. (Trust -10.)","The Red Table's speaker sent a runner: the northeast ground feeds both villages or neither. They want to talk — properly, at their fire. Ignoring this is also an answer.","— DAY 138 DAWN — The world wakes. Animals are active.","💬 Maya says: \"They said you're doing well. It sounded... proud? Can they feel proud?\"","🏃 Peter of Stonebridge walks into Haven unannounced, pack-mules behind. \"Heard your bins are echoing. Stonebridge has grain to spare — 1,952 kcal, no tribute, no ceremony. Say the word.\"","(Aid offer — accept or refuse from the beats row. Refusing costs pride: trust -3.)","🥣 Yuki of Thornfield stands at your fire, thinner than pride allows. \"Thornfield is eating bark. We're asking — 1,830 kcal, whatever you can spare. We'll remember it.\"","(They beg — give from the beats row, or refuse aloud. If they once fed you, refusing costs double.)","Max Allen reads the sky: clear tomorrow, cold.","Maya kneels and asks. The land answers: 6 bellies full in Haven today. (Feed the Multitude)","You wake with a start — something is wrong.","No risky water to boil.","Drank clean water.","📯 It moves.","You catch fragments by the fire — Max telling Nina about Oliver. Half of it's true anymore. You're not sure which half.","💧 Max returns with water: +4 clean.","🚶 Maya is back with Max.","🩹 Maya is hurting (53 HP) — You patch them up before they head out. (53 → 78 HP)","👥 Oliver heads out for water. \"Off to the well — back with a full skin.\"","👥 Maya walks out with Oliver. \"Nobody walks alone today.\"","Iron cold. Even the ticks are shelved.","— MIDDAY — Honest work hours. Heat builds.","You wait. The light changes. Nothing asks anything of you.","Its posture changes. Curiosity is over.","📯 It moves.","🩹 Max is hurting (53 HP) — You patch them up before they head out. (53 → 78 HP)","Max heads out for water. \"Fetching water. Somebody has to.\"","💧 Nina returns with water: +2 clean.","🚶 Chantal is back with Nina.","💧 Farid returns with water: +2 clean.","— DUSK — Animals stir again. Shadows lengthen.","You wait. The light changes. Nothing asks anything of you.","⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."]}],"musterRefusals":[{"idx":0,"day":138,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic.","have":0,"need":10,"musterExists":false,"alliesRaw":0,"alliesUnique":0,"havenValid":0,"readyManual":false,"readyGame":false,"omenStage":2,"omenDay":134,"links":[{"villageId":"village_1","name":"Stonebridge","trust":92,"opinion":64,"arrears":0,"quota":6,"facesFree":5,"already":0,"wouldRefuse":false,"wouldYield":5},{"villageId":"village_2","name":"Thornfield","trust":92,"opinion":56,"arrears":0,"quota":6,"facesFree":0,"already":0,"wouldRefuse":false,"wouldYield":0},{"villageId":"village_spl_31_57155","name":"The Bloodied","trust":70,"opinion":63,"arrears":0,"quota":6,"facesFree":2,"already":0,"wouldRefuse":false,"wouldYield":2}],"linksActive":3,"callYield":7,"callOffered":true,"commitOffered":true,"volunteers":3,"outcomesPrior":0,"callsSoFar":{"soundTitanCall":0,"titanCommitOwn":0,"titanSelfDo":0,"titanWarCouncil":0}},{"idx":1,"day":138,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic.","have":0,"need":10,"musterExists":false,"alliesRaw":0,"alliesUnique":0,"havenValid":0,"readyManual":false,"readyGame":false,"omenStage":2,"omenDay":134,"links":[{"villageId":"village_1","name":"Stonebridge","trust":92,"opinion":64,"arrears":0,"quota":6,"facesFree":5,"already":0,"wouldRefuse":false,"wouldYield":5},{"villageId":"village_2","name":"Thornfield","trust":92,"opinion":56,"arrears":0,"quota":6,"facesFree":0,"already":0,"wouldRefuse":false,"wouldYield":0},{"villageId":"village_spl_31_57155","name":"The Bloodied","trust":70,"opinion":63,"arrears":0,"quota":6,"facesFree":2,"alrea