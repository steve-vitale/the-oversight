":"audit","pendingAfter":false,"pendingMidAfter":null,"muster":null,"scholarPos":{"mx":8,"my":0,"px":4,"py":4},"entityPos":null,"entityHp":null,"sayDuring":[],"gameOutcomes":[],"end":"lost"},{"day":75,"mid":"herald","wave":4,"aggression":"heraldic","titan":true,"caller":"wild-contact","stackTop":["stackTop@herald-instrument-20261030.js:132:17","Game.startCombat@herald-instrument-20261030.js:239:21","Object.monsterTurn@game.js:23383:48","Object.tickAction@game.js:19836:35","game.tickAction@favor-company.js:187:34","game.<computed>@timeSettlement.js:39:33","Object.doAction@game.js:27058:25","Game.doAction@journal.js:1444:28"],"cls":"REFUSED","reason":"MUSTER-GATE","liveBefore":false,"pendingBefore":false,"pendingMidBefore":null,"pendingAfter":false,"pendingMidAfter":null,"muster":{"present":false,"alliesRaw":0,"alliesUnique":0,"havenRaw":0,"havenUnique":0,"need":null,"readyProxy":null},"scholarPos":{"mx":4,"my":4,"px":4,"py":4},"entityPos":{"tx":4,"ty":4,"mx":4,"my":4},"entityHp":{"hp":525,"maxHp":700},"sayDuring":["⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."],"gameOutcomes":[{"titan":"herald","day":75,"outcome":"refused","detail":{"gate":"muster","have":0,"need":10}}],"end":null}],"fieldFights":[{"day":83,"vid":"priya_nair","mid":"herald","wave":4,"outcome":"vFlee","rounds":2,"vTaken":43,"mDealt":50,"vHpLeft":55,"mHpLeft":475,"log":["R1: Priya strikes for 24 (501 left)","Priya's gear absorbs 18.","R1: First Omen hits Priya for 24 (74 left)","R2: Priya strikes for 26 (475 left)","Priya's gear absorbs 15.","R2: Second Omen hits Priya for 19 (55 left)","Priya sees how this ends — and runs while running still works."]},{"day":83,"vid":"priya_nair","mid":"herald","wave":4,"outcome":"vFlee","rounds":1,"vTaken":27,"mDealt":23,"vHpLeft":28,"mHpLeft":452,"log":["R1: Priya strikes for 23 (452 left)","Priya's gear absorbs 20.","R1: First Omen hits Priya for 27 (28 left)","Priya is past holding — they run while running still works."]}],"kills":[{"day":59,"mid":"strike","wave":4,"by":"gen_gxp862b","via":"player"}],"musterEvents":[],"census":[{"day":2,"uw":1,"rank":"village"},{"day":2,"uw":1,"rank":"village"},{"day":4,"uw":1,"rank":"village"},{"day":4,"uw":1,"rank":"village"},{"day":5,"uw":1,"rank":"village"},{"day":6,"uw":1,"rank":"village"},{"day":7,"uw":1,"rank":"village"},{"day":8,"uw":1,"rank":"village"},{"day":9,"uw":1,"rank":"village"},{"day":10,"uw":1,"rank":"village"},{"day":11,"uw":1,"rank":"village"},{"day":12,"uw":1,"rank":"village"},{"day":13,"uw":1,"rank":"village"},{"day":14,"uw":1,"rank":"village"},{"day":15,"uw":1,"rank":"village"},{"day":16,"uw":1,"rank":"village"},{"day":17,"uw":1,"rank":"village"},{"day":18,"uw":1,"rank":"village"},{"day":19,"uw":1,"rank":"village"},{"day":20,"uw":2,"rank":"village"},{"day":21,"uw":2,"rank":"village"},{"day":22,"uw":2,"rank":"village"},{"day":23,"uw":2,"rank":"village"},{"day":24,"uw":2,"rank":"village"},{"day":25,"uw":2,"rank":"village"},{"day":26,"uw":2,"rank":"village"},{"day":27,"uw":2,"rank":"village"},{"day":28,"uw":2,"rank":"village"},{"day":29,"uw":2,"rank":"village"},{"day":30,"uw":2,"rank":"village"},{"day":31,"uw":2,"rank":"village"},{"day":32,"uw":2,"rank":"village"},{"day":33,"uw":2,"rank":"village"},{"day":34,"uw":2,"rank":"village"},{"day":35,"uw":2,"rank":"village"},{"day":36,"uw":2,"rank":"village"},{"day":37,"uw":2,"rank":"village"},{"day":38,"uw":2,"rank":"village"},{"day":39,"uw":2,"rank":"village"},{"day":40,"uw":2,"rank":"village"},{"day":41,"uw":2,"rank":"village"},{"day":42,"uw":2,"rank":"village"},{"day":43,"uw":2,"rank":"village"},{"day":44,"uw":2,"rank":"village"},{"day":45,"uw":3,"rank":"village"},{"day":46,"uw":3,"rank":"village"},{"day":47,"uw":3,"rank":"village"},{"day":48,"uw":3,"rank":"village"},{"day":49,"uw":3,"rank":"village"},{"day":50,"uw":3,"rank":"village"},{"day":51,"uw":3,"rank":"regional"},{"day":52,"uw":4,"rank":"regional"},{"day":53,"uw":4,"rank":"regional"},{"day":54,"uw":4,"rank":"regional"},{"day":55,"uw":4,"rank":"regional"},{"day":56,"uw":4,"rank":"regional"},{"day":57,"uw":4,"rank":"regional"},{"day":58,"uw":4,"rank":"regional"},{"day":59,"uw":4,"rank":"regional"},{"day":60,"uw":4,"rank":"regional"},{"day":61,"uw":4,"rank":"regional"},{"day":62,"uw":4,"rank":"regional"},{"day":63,"uw":4,"rank":"regional"},{"day":64,"uw":4,"rank":"regional"},{"day":65,"uw":4,"rank":"regional"},{"day":66,"uw":4,"rank":"regional"},{"day":67,"uw":4,"rank":"regional"},{"day":68,"uw":4,"rank":"regional"},{"day":69,"uw":4,"rank":"regional"},{"day":70,"uw":4,"rank":"regional"},{"day":71,"uw":4,"rank":"regional"},{"day":72,"uw":4,"rank":"regional"},{"day":73,"uw":4,"rank":"regional"},{"day":74,"uw":4,"rank":"regional"},{"day":75,"uw":4,"rank":"regional"},{"day":76,"uw":4,"rank":"regional"},{"day":77,"uw":4,"rank":"regional"},{"day":78,"uw":4,"rank":"regional"},{"day":79,"uw":4,"rank":"regional"},{"day":80,"uw":4,"rank":"regional"},{"day":81,"uw":4,"rank":"national"},{"day":82,"uw":4,"rank":"global"},{"day":83,"uw":4,"rank":"global"},{"day":84,"uw":4,"rank":"global"},{"day":85,"uw":4,"rank":"global"},{"day":86,"uw":4,"rank":"global"},{"day":87,"uw":4,"rank":"global"},{"day":88,"uw":4,"rank":"global"},{"day":89,"uw":4,"rank":"global"}],"transcripts":[{"cls":"herald-refused-first","day":71,"mid":"herald","muster":{"present":false,"alliesRaw":0,"alliesUnique":0,"havenRaw":0,"havenUnique":0,"need":null,"readyProxy":null},"sayDuring":["⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."],"lines":["You coax 4 growing beds forward by 8 days. The next harvest carries the growth magic.","(−200 kcal — food becomes green whisper.)","You eat Burdock (630 kcal).","You settle into the hall floor. Sleep takes you.","You catch fragments by the fire — Victor telling Sofia about you. It's picking up decorations as it travels.","💧 Victor returns with water: +2 clean.","💧 Brooklyn returns with water: +3 clean.","🧳 Word from The Bloodied: Lucia is dead, and Talia and Omar both claim the fire. The Bloodied is choosing — or fighting.","🌙 Night. The lingering Drum-Belly gorges at the treeline — 800 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","🌙 Night. The lingering The Herald gorges at the treeline — 1,000 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","🌙 Night. The lingering Gavel gorges at the treeline — 1,192 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","⚠ WARNING: reserves critical. Eat tomorrow or the spiral begins.","Village meal: +2200 kcal, +1L water from the communal pantry.","Victor came back with an armful of something edible, unprompted. (+100 kcal pantry)","Marcus is hurt — a fall, a thorn, a bad step. (health 68/100)","🍽️ Sofia counts the pantry jars twice, then sets down the gathering sack. \"We're eating well. Sharpening the skinning knives instead.\"","🍽️ Sofia watches another basket arrive and laughs. \"We're feeding the shelves more than ourselves. Not today.\"","The moment passed. Nobody mentions the pods today. A few people notice that nobody mentions them.","— DAY 70 DAWN — The world wakes. Animals are active.","Overnight, Hickory Nuts (in shell) went bad — beyond saving. You leave it for the flies.","Fresh food keeps days, not weeks. Smoke it over a fire to make it last.","🎁 You find a small bundle tucked where you'll find it. No one saw it left there.","\"They're sending Vex after you tomorrow. He's bored. Be somewhere else.\"","(396 kcal of dried meat and clean water. Nothing traceable.)","Dawn. You wake rested. (+0 health, energy restored. By the fire. Good enough.)","No risky water to boil.","Drank clean water.","\"Can we talk?\" David sits down near you. \"Just... talk. Like people used to.\" (Talk to David.)","It sits up and drums a little paradiddle, watching to see if you flinch.","It rears up. The belly starts to swell. You know what comes next.","You catch fragments by the fire — Sarawut telling Brooklyn about Victor. The story's getting bigger than what happened.","👥 Victor heads out for water. \"Off to the well — back with a full skin.\"","👥 Marcus walks out with Victor. \"Nobody walks alone today.\"","👥 Sarawut heads out for water. \"Thirst doesn't negotiate. Going.\"","👥 David walks out with Sarawut. \"Nobody walks alone today.\"","🩹 Devon is still hurting (33 HP) — no healer at haven. They rest today instead of ranging out.","👥 Benoit heads out for water. \"Fetching water. Somebody has to.\"","Sofia is sweeping the hall. Someone has to.","Iron cold. Even the ticks are shelved.","— MIDDAY — Honest work hours. Heat builds.","You wait. The light changes. Nothing asks anything of you.","Benoit left 3 wood logs by the stash. No announcement. That's how it works here.","🦡 It moves.","You catch fragments by the fire — David telling Victor about you. Someone's added a flourish that wasn't there this morning.","You catch fragments by the fire — Sarawut telling Marcus about themself. The retelling is already better than the event.","Brooklyn heads out for water. \"The well won't fill itself.\"","Sofia is sweeping the hall. Someone has to.","— DUSK — Animals stir again. Shadows lengthen.","You wait. The light changes. Nothing asks anything of you.","The village is rattled. Everyone's jumpy — eyes on the treeline.","You don't know what that was. A drumbeat with no drummer, getting closer. Someone at the haven should hear about this.","⚔ DRUM-BELLY! You're on your own.","Turn-based now. Tap a tile to move — speed is squares. Then act.","🐗 This one came with the raid on Haven — it was with the teeth at the door, not a lone wanderer.","(The game is telling you something: this is bigger than one person. Talk to your companions — \"We should name this. Us.\")","You catch fragments by the fire — David telling Brooklyn about you. It's picking up decorations as it travels.","Word gets around the haven. Whatever that thing was — everyone's talking about it now.","Back at the haven the argument starts: Victor is calling it \"The Big Beast.\" They'll fight it out — weigh in if you want.","💧 Sarawut returns with water: +4 clean.","🚶 David is back with Sarawut.","💧 Benoit returns with water: +3 clean.","— NIGHT — Camp. Rest — or risk the dark.","No watches tonight. Everyone sleeps with one ear open and pretends not to.","PATIENT AIM: first strike -- and your training piles on. (x2.30)","AMBUSH: first blood. ×1.5.","OVERCHARGED ×1.25 (well-fed): food is fuel.","The Drum-Belly falls.","You STRIKE the tanuki for 250 (Hardlight knife).","📺 +5 style — solid hit","📺 +20 style — dropped the Drum-Belly!","Fatty, dark, faintly of thunder. Cook it well — and thank the drum. It's dead. The carcass is there on the ground — search the body if you want the meat. But you don't know this flesh. Clean it, test it cautiously, or ask someone who knows. And don't leave it long: meat rots where it lies.","You came back bloody. Nobody asks. Someone saves you the good seat by the fire.","💛 You hold Dispatcher's headset. You learned the voice — low, steady, unhurried. 'Panic is just information arriving too fast.' You hear it in your own voice now when it counts. Your gifts are not mastered — but they are lived-in, and they are with you. The feast was the weapon. (The next feast grants FEASTED until tomorrow's dawn: strikes & abilities uplifted, devotion ×1.5 — richer feasts hit harder.)","Travel 1 tile to meadow.","It followed you. The Herald is here.","💬 Sarawut says: \"Someone's been leaving food out. Good food. Don't ask me how I know it wasn't one of us.\"","This patch is worked out — step to another green patch and forage again.","Travel 2 tiles to meadow.","It followed you. The Herald is here.","You work the patch with practiced hands: 7× Blackberry, 7× Stinging Nettle (735 kcal). This patch is picked clean — it'll recover in a few days.","Its posture changes. Curiosity is over.","Travel 1 tile to Haven.","The Herald stops at the treeline — pacing, unwilling. The walls end the argument. It's still out there.","You keep a day's food (545 kcal) — nothing extra for the pantry this time.","1 unprocessed haul onto the counter — the clock is ticking.","You walk back into Haven. 34 Codex entries. The village is glad to see you.","Word gets around the haven. Whatever that thing was — the haven's talking about nothing else.","Back at the haven the argument starts: Victor is calling it \"Big-Eyes.\" Nobody agrees yet — weigh in if you want.","You coax 4 growing beds forward by 8 days. The next harvest carries the growth magic.","(−200 kcal — food becomes green whisper.)","Harvest: 175× Blackberry, 175× Blackberry. About 22750 kcal before preparation.","You settle into the hall floor. Sleep takes you.","Word gets around the haven. Whatever that thing was — every fire has a theory tonight.","Back at the haven the argument starts: Victor is calling it \"Big Ugly.\" The name's up for grabs — weigh in if you want.","💧 Victor returns with water: +4 clean.","💧 Brooklyn returns with water: +4 clean.","🚶 Marcus is back with Victor.","🌾 Tribute wagons from Emberhold turn at the gate — our shelves are full past tomorrow. \"Eat well,\" we send back. \"That IS your tribute this week.\" (Trust +1.)","🌾 Tribute wagons from Stonebridge turn at the gate — our shelves are full past tomorrow. \"Eat well,\" we send back. \"That IS your tribute this week.\" (Trust +1.)","🌾 Tribute wagons from Thornfield turn at the gate — our shelves are full past tomorrow. \"Eat well,\" we send back. \"That IS your tribute this week.\" (Trust +1.)","🌙 Night. The lingering The Herald gorges at the treeline — 1,508 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","🌙 Night. The lingering Gavel gorges at the treeline — 728 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","Riders on the ridge — no, a cart. A TRADER. Word travels: Haven has food, and where there's food there's trade.","★ IDENTIFIED: Tulsi (Holy Basil). The courtyard herb — tea for coughs. Uses unknown — harvest, taste, and learn.","SYSTEM: Naming things. Very human. The audience approves.","📚 Village knowledge: Marcus taught everyone about Tulsi (Holy Basil). The Codex grows without you lifting a finger.","⚠ STARVING: health and energy falling. You went to bed on an empty stomach.","Village meal: +2136 kcal, +1L water from the communal pantry.","Marcus is showing everyone Tulsi (Holy Basil) by the fire. \"See the leaves? Like that. Don't mix it up.\" The Codex grows — the human way.","Benoit: \"Moringa is coming back thick on the damp slope. Not new — but it's holding.\"","🔍 Marcus crouches over a low woodland plant with a whorl of compound leaves and a small cluster of red berries — rare, and protected, studying it a moment before moving on. (1/3 looks)","Marcus traded something with someone for something else. The barter economy stirs.","Sarawut and Victor lingered over the fire together.","Devon and David lingered over the fire together.","🍽️ Sofia taps the pantry's fullest jar. \"More than we can eat before it turns. Rendering fat instead — the lamps won't fill themselves.\"","🍽️ David looks at the full shelves and waves off the day's share. \"No more into the store — we eat at the fire, and the shelves keep.\"","The land is getting tired. The easy food is thinning.","— DAY 71 DAWN — The world wakes. Animals are active.","Overnight, Stinging Nettle went bad — beyond saving. You leave it for the flies.","Fresh food keeps days, not weeks. Smoke it over a fire to make it last.","The fire burns low. One new line in the journal: Tulsi (Holy Basil) — named and noted.","📦 A care package drops from the sky with a little parachute. There's a note: \"WE LOVE YOU!\"","Inside: Deep Pocket Coat","Plus 45 kcal of fan-approved snacks.","You wake with a start — something is wrong.","★ IDENTIFIED: Bittersweet Nightshade. Purple star flowers, red berries, climbing vine. Uses unknown — harvest, taste, and learn.","SYSTEM: Catalogued. The Codex grows teeth.","No risky water to boil.","Drank clean water.","📯 It moves.","You catch fragments by the fire — Marcus telling Devon about you. Half of it's true anymore. You're not sure which half.","Victor heads out for water. \"Thirst doesn't negotiate. Going.\"","Sarawut heads out for water. \"Fetching water. Somebody has to.\"","Marcus heads out for water. \"The well won't fill itself.\"","🩹 Devon is still hurting (36 HP) — no healer at haven. They rest today instead of ranging out.","Benoit heads out for water. \"Water first. Everything else waits.\"","Iron cold. Even the ticks are shelved.","— MIDDAY — Honest work hours. Heat builds.","You wait. The light changes. Nothing asks anything of you.","No risky water to boil.","Drank clean water.","📯 It moves.","You catch fragments by the fire — David telling Benoit about you. Three retellings in, nobody remembers what actually happened — but everyone has opinions.","Manpreet showed Sarawut the Bittersweet Nightshade — \"remember it.\" The haven hears about it by supper.","Brooklyn heads out for water. \"Off to the well — back with a full skin.\"","Sofia heads out to forage. \"Bringing dinner back. One way or another.\"","— DUSK — Animals stir again. Shadows lengthen.","You wait. The light changes. Nothing asks anything of you.","Your pack is full — water is heavy (1L = 1kg). Drink some or drop weight before filling.","⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."]}],"musterRefusals":[{"idx":0,"day":71,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic.","have":0,"need":10,"musterExists":false,"alliesRaw":0,"alliesUnique":0,"havenValid":0,"readyManual":false,"readyGame":false,"omenStage":2,"omenDay":63,"links":[{"villageId":"village_0","name":"Emberhold","trust":92,"opinion":17,"arrears":0,"quota":6,"facesFree":0,"already":0,"wouldRefuse":false,"wouldYield":0},{"villageId":"village_1","name":"Stonebridge","trust":85,"opinion":13,"arrears":0,"quota":6,"facesFree":0,"already":0,"wouldRefuse":false,"wouldYield":0},{"villageId":"village_2","name":"Thornfield","trust":91,"opinion":21,"arrears":0,"quota":6,"facesFree":6,"already":0,"wouldRefuse":false,"wouldYield":6}],"linksActive":3,"callYield":6,"callOffered":true,"commitOffered":true,"volunteers":2,"outcomesPrior":0,"callsSoFar":{"soundTitanCall":0,"titanCommitOwn":0,"titanSelfDo":0,"titanWarCouncil":0}},{"idx":1,"day":71,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic.","have":0,"need":10,"musterExists":false,"alliesRaw":0,"alliesUnique":0,"havenValid":0,"readyManual":false,"readyGame":false,"omenStage":2,"omenDay":63,"links":[{"villageId":"village_0","name":"Emberhold","trust":92,"opinion":17,"arrears":0,"quota":6,"facesFree":0,"already":0,"wouldRefuse":false,"wouldYield":0},{"villageId":"village_1","name":"Stone