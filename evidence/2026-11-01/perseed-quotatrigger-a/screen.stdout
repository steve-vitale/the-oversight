nk":"village"},{"day":28,"uw":2,"rank":"village"},{"day":29,"uw":2,"rank":"village"},{"day":30,"uw":2,"rank":"village"},{"day":31,"uw":2,"rank":"village"},{"day":32,"uw":2,"rank":"village"},{"day":33,"uw":2,"rank":"village"},{"day":34,"uw":2,"rank":"village"},{"day":35,"uw":2,"rank":"village"},{"day":36,"uw":2,"rank":"village"},{"day":37,"uw":2,"rank":"village"},{"day":38,"uw":2,"rank":"village"},{"day":39,"uw":2,"rank":"village"},{"day":40,"uw":2,"rank":"village"},{"day":42,"uw":3,"rank":"village"},{"day":42,"uw":3,"rank":"village"},{"day":43,"uw":3,"rank":"village"},{"day":44,"uw":3,"rank":"village"},{"day":45,"uw":3,"rank":"village"},{"day":46,"uw":3,"rank":"village"},{"day":47,"uw":3,"rank":"regional"},{"day":48,"uw":3,"rank":"regional"},{"day":49,"uw":3,"rank":"regional"},{"day":50,"uw":4,"rank":"regional"},{"day":51,"uw":4,"rank":"regional"},{"day":52,"uw":4,"rank":"regional"},{"day":53,"uw":4,"rank":"regional"},{"day":54,"uw":4,"rank":"regional"},{"day":55,"uw":4,"rank":"regional"},{"day":56,"uw":4,"rank":"regional"},{"day":57,"uw":4,"rank":"regional"},{"day":58,"uw":4,"rank":"regional"},{"day":59,"uw":4,"rank":"regional"},{"day":60,"uw":4,"rank":"regional"},{"day":61,"uw":4,"rank":"regional"},{"day":62,"uw":4,"rank":"regional"},{"day":63,"uw":4,"rank":"regional"},{"day":64,"uw":4,"rank":"regional"},{"day":65,"uw":4,"rank":"regional"},{"day":66,"uw":4,"rank":"regional"},{"day":67,"uw":4,"rank":"regional"},{"day":68,"uw":4,"rank":"regional"},{"day":69,"uw":4,"rank":"regional"},{"day":70,"uw":4,"rank":"regional"},{"day":71,"uw":4,"rank":"regional"},{"day":72,"uw":4,"rank":"regional"},{"day":73,"uw":4,"rank":"regional"},{"day":74,"uw":4,"rank":"regional"},{"day":75,"uw":4,"rank":"regional"},{"day":76,"uw":4,"rank":"regional"},{"day":77,"uw":4,"rank":"regional"},{"day":78,"uw":4,"rank":"regional"},{"day":79,"uw":4,"rank":"regional"},{"day":80,"uw":4,"rank":"regional"},{"day":81,"uw":4,"rank":"regional"},{"day":82,"uw":4,"rank":"regional"},{"day":83,"uw":4,"rank":"regional"},{"day":84,"uw":4,"rank":"regional"},{"day":86,"uw":4,"rank":"regional"},{"day":86,"uw":4,"rank":"regional"},{"day":87,"uw":4,"rank":"regional"},{"day":88,"uw":4,"rank":"regional"}],"transcripts":[{"cls":"herald-refused-first","day":72,"mid":"herald","muster":{"present":false,"alliesRaw":0,"alliesUnique":0,"havenRaw":0,"havenUnique":0,"need":null,"readyProxy":null},"sayDuring":["⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."],"lines":["📺 +20 style — dropped the Loud Bastard!","Sanne nods, slow. \"Remind me not to cross you.\"","It is all mouth. You are not hungry enough.","You came back bloody. Nobody asks. Someone saves you the good seat by the fire.","You clutch your Dog Tags. You're still here. The resonance deepens. (bond 0)","Your hands won't stop shaking. The Dog Tags is right there — hold it, think of them. (Pack → 💛 Hold it (steady yourself))","Your pack is full — water is heavy (1L = 1kg). Drink some or drop weight before filling.","\"OUR STORY BEGINS,\" says the dark, \"at the end.\"","🎙️ It moves.","\"AND THEN THEY RAN.\" The spotlight narrows. The story is gaining weight.","— NIGHT — Camp. Rest — or risk the dark.","No watches tonight. Everyone sleeps with one ear open and pretends not to.","You wait. The light changes. Nothing asks anything of you.","💛 You hold Dog Tags. Breathe. The shaking eases. (−6 trauma)","💛 You hold Dispatcher's headset. You learned the voice — low, steady, unhurried. 'Panic is just information arriving too fast.' You hear it in your own voice now when it counts. Your gifts are not mastered — but they are lived-in, and they are with you. The feast was the weapon. (The next feast grants FEASTED until tomorrow's dawn: strikes & abilities uplifted, devotion ×1.5 — richer feasts hit harder.)","Travel 1 tile to grove.","You catch fragments by the fire — Sanne telling Phat about you. Half of it's true anymore. You're not sure which half.","You catch fragments by the fire — Naran telling Valeria about Sanne. Someone's added a flourish that wasn't there this morning.","This patch is worked out — step to another green patch and forage again.","The creek runs fast here — no crossing without a bridge or a swim.","Travel 2 tiles to creek.","This patch is worked out — step to another green patch and forage again.","Travel 1 tile to Haven.","While you were gone — one thing you missed:","⚔️ Phat stared down the Big Loud and it backed off — 0 rounds, not a scratch on them. It's still out there, somewhere.","The pantry is bursting past tomorrow — most of the haul stays in your pack. The fire can wait; the road can't.","You keep a day's food (5100 kcal) — nothing extra for the pantry this time.","You walk back into Haven. 49 Codex entries. The village is glad to see you.","Donated Muscadine Grapes (+270 kcal). Trust +1. They'll remember this.","You coax 4 growing beds forward by 10 days. The next harvest carries the growth magic.","(−200 kcal — food becomes green thumb.)","📋 Enzo — 🎣 Fish. They'll report back by next part.","Too heavy for the rest — left where it lies: Sinew cord x2, Sinew cord x2.","✨ Ability gained: Adrenaline Control (L1). Your heart hammers — and every hammering beat lands 30% harder. Fear is fuel.","\"Earned, not given. You did the work — we just wrote it down.\"","You settle into the hall floor. Sleep takes you.","🌿 Enzo checks the pantry before heading out — the shelves are full, ~5 days of fresh on hand… leaves the fish nets standing and turns to the water run instead. The pantry can't take more; the wild will keep.","💧 Enzo returns with 8L of creek water. Risky until the hearth boils it.","💧 Naran returns with water: +3 clean.","💧 Sanne returns with water: +2 clean.","🚶 Valeria is back with Naran.","🚶 Phat is back — found Andres.","🌙 Night. The lingering The Eulogy gorges at the treeline — 1,200 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","🌙 Night. The lingering The Herald gorges at the treeline — 1,585 kcal gone from the stores. Endure it (they drift off within ~6 nights — the gorge is the price), or send a sortie: fighters, rations, real risk.","A weathered trader waits a while, then moves on down the road. Word travels about that, too.","⚠ WARNING: reserves critical. Eat tomorrow or the spiral begins.","Village meal: +2500 kcal, +1L water from the communal pantry.","Someone told a joke by the fire. You hear Valeria laugh — a real one.","Enzo is hurt — a fall, a thorn, a bad step. (health 76/100)","Sanne and Naran lingered over the fire together.","🍽️ Sanne taps the pantry door — full to bursting — and keeps the day's share in hand. \"Dinner's on me tonight, then.\"","💧 The cistern's recovered — full cups again, and nobody's guarding the dipper.","🪤 TRAP: Your Snare 1 tile north caught a Gray Squirrel! — head-high on the trail, anchored solid, wire near-invisible. About 350 kcal on the bone — clean it quickly (knife). It rots fast.","🪤 TRAP: Your Snare 1 tile north caught a Gray Squirrel! — head-high on the trail, anchored solid, wire near-invisible. About 350 kcal on the bone — clean it quickly (knife). It rots fast.","🌪️ THE HERALD struck Thornfield in the night. They bled while the coalition talked. (trust −5 — they notice who wasn't there.)","— DAY 72 DAWN — The world wakes. Animals are active.","📦 A care package drops from the sky with a little parachute. There's a note: \"WE LOVE YOU! — your showbiz fans\"","Inside: Stormcloak","Plus 46 kcal of fan-approved snacks.","◈ WORD TRAVELS — riders from The Red Table II bring talk of Haven. Out there they call you the Feared. The show's narration lingers on your hands.","📊 THE STANDINGS — Haven sits 1st of 6. Haven leads. The audience has a favorite, and it's you.","Dawn. You wake rested. (+6 health, energy restored. Your sleeping body burned less — 571 kcal conserved. By the fire. Good enough.)","You eat Lamb's Quarters (1550 kcal). Past full — the bank takes it. (+2400 banked. The furnace roars. You feel dangerous.)","Your chewing echoes off the trees. Something out there heard. (encounters more likely tomorrow)","No risky water to boil.","Drank clean water.","🎙️ It moves.","🌱 Phat works the garden — watered, weeded, turned. Nothing ripe yet.","👥 Valeria heads out for water. \"The well won't fill itself.\"","👥 Naran walks out with Valeria. \"Nobody walks alone today.\"","Iron cold. Even the ticks are shelved.","— MIDDAY — Honest work hours. Heat builds.","You wait. The light changes. Nothing asks anything of you.","Your pack is full — water is heavy (1L = 1kg). Drink some or drop weight before filling.","The village is rattled. Everyone's jumpy — eyes on the treeline.","You don't know what that was. A voice practicing your name in past tense. Someone at the haven should hear about this.","⚔ THE EULOGY! You're on your own.","Turn-based now. Tap a tile to move — speed is squares. Then act.","🐗 This one came with the raid on Haven — it was with the teeth at the door, not a lone wanderer.","(The game is telling you something: this is bigger than one person. Talk to your companions — \"We should name this. Us.\")","👥 Sanne sets out to find Andres. \"Won't be long.\"","👥 Phat walks out with Sanne. \"Nobody walks alone today.\"","— DUSK — Animals stir again. Shadows lengthen.","📖 The Eulogy narrates, honestly, always: \"and then they stood their ground, poor brave fools.\" The spotlight widens. (No weight yet — just the story starting.) (5 verses remain. Contradict it — do the opposite — or give it a better ending.)","Your strikes land harder. (x1.30 training)","(eulogy's hide absorbs 8.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the eulogy for 65 (Machete).","📺 +5 style — solid hit","📖 The Eulogy narrates, honestly, always: \"and then they ran, and the spotlight followed.\" The spotlight narrows. Your dodge feels watched. (-10% dodge.) (4 verses remain. Contradict it — do the opposite — or give it a better ending.)","💥 eulogy's attack finds you — no dodging it.","Armor absorbs 31.","Eulogy's attack hits you for 17.","📖 Codex: Epitaph — locks onto one target — moving won't dodge it. You won't forget this.","Your strikes land harder. (x1.30 training)","(eulogy's hide absorbs 8.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the eulogy for 73 (Machete).","📺 +5 style — solid hit","📖 The Eulogy narrates, honestly, always: \"and then they bled, politely, where everyone could see.\" The narration lingers on your wounds. (Bleeds last 1 round longer.) (3 verses remain. Contradict it — do the opposite — or give it a better ending.)","💥 It connects!","Armor absorbs 34.","Eulogy's attack hits you for 20.","📖 Codex: Final Chapter — strikes one target after a windup. You won't forget this.","Your strikes land harder. (x1.30 training)","(eulogy's hide absorbs 8.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","You STRIKE the eulogy for 71 (Machete).","📺 +5 style — solid hit","📖 The Eulogy narrates, honestly, always: \"and then they knelt, and the story approved.\" The story leans in. (The Eulogy's attacks +15.) (2 verses remain. Contradict it — do the opposite — or give it a better ending.)","💥 Final Chapter!","Armor absorbs 41.","Eulogy's Final Chapter hits you for 23.","Your strikes land harder. (x1.30 training)","(eulogy's hide absorbs 8.)","OVERCHARGED ×1.25 (well-fed): food is fuel.","eulogy is BLEEDING — and it likes it. Louder, faster, no more feints.","You STRIKE the eulogy for 65 (Machete).","📺 +5 style — solid hit","📖 The Eulogy narrates, honestly, always: \"and then — this is the last line — they ended.\" The last line hangs in the air. (It finishes next round.) (1 verse remain. Contradict it — do the opposite — or give it a better ending.)","💥 eulogy's Epitaph finds you — no dodging it.","Armor absorbs 34.","Eulogy's Epitaph hits you for 19.","📖 \"...they ended.\" The last line lands like a lid. (The story finishes — you die as narrated.)","Armor absorbs 6363.","You go down.","📖 The Codex turns a page on its own. Andres Koenig is dead. You didn't ask. It knew.","Nobody's talking much. The fire feels smaller tonight.","🕯️ Andres is dead — and the dead hold no treaties. Every link Haven has shakes.","ANDRES — GONE. 1 open question closed unanswered.","🕯️ Andres Koenig is dead — the wild. The village stops. Somebody screams. Somebody else starts digging.","\"Andres's gone.\" Naran looks at you for a long moment. \"You're not Andres.\" No heat in it. Just fact. You'll have to earn this face.","The Codex doesn't pause for grief. Sanne blinks — and it's already there, overlaying everything, syncing. No pen. No paper. The mantle just... transfers.","★ The record corrects itself: this was never Loquat — it's Pawpaw. someone taught you wrong (their own memory). (The Codex marks the disagreement. You can call them out in conversation.)","🌟 \"MANTLE TRANSFER DETECTED. ...Oh! New face! Same job! Whole new set of tricks. We hardly noticed. (That is a lie. We noticed. The audience CRIED.)\"","📖 The Codex turns a page: Andres Koenig, 72 days. The mantle passes to Sanne Bakker.","🪞 You wake up somebody else. Sanne Bakker, 41 — a Vintner. Her hands know different work now: Green Whisper.","You knew Andres — not the office, the person. The fire keeps expecting them, and so do you. That's a heavier kind of stepping up. (+5 trauma)","At the grave, Naran, Valeria speak for Sanne — \"Andres trusted them. We saw it. Give them the fire's hearing.\" The village listens.","The fire knew Sanne before the Codex did — her name already carried weight here.","You eat Energy drink (120 kcal).","Its posture changes. Curiosity is over.","Took Tribute grain from Thornfield.","You eat Tribute grain from Thornfield (500 kcal).","Took Tribute grain from Thornfield.","You eat Tribute grain from Thornfield (500 kcal).","Your chewing echoes off the trees. Something out there heard. (encounters more likely tomorrow)","Filled 1L (clean — Haven well). 3L carried (3kg). (-10 kcal hauling, 1 tick.) Cistern: 5L left.","📯 It moves.","⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic."]}],"musterRefusals":[{"idx":0,"day":72,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic.","have":0,"need":10,"musterExists":false,"alliesRaw":0,"alliesUnique":0,"havenValid":0,"readyManual":false,"readyGame":false,"omenStage":2,"omenDay":62,"links":[{"villageId":"village_0","name":"Emberhold","trust":41,"opinion":12,"arrears":6000,"quota":2,"facesFree":0,"already":0,"wouldRefuse":true,"wouldYield":0},{"villageId":"village_1","name":"Stonebridge","trust":31,"opinion":22,"arrears":0,"quota":2,"facesFree":6,"already":0,"wouldRefuse":false,"wouldYield":2},{"villageId":"village_2","name":"Thornfield","trust":34,"opinion":21,"arrears":0,"quota":2,"facesFree":7,"already":0,"wouldRefuse":false,"wouldYield":2}],"linksActive":3,"callYield":4,"callOffered":true,"commitOffered":true,"volunteers":0,"outcomesPrior":0,"callsSoFar":{"soundTitanCall":0,"titanCommitOwn":0,"titanSelfDo":0,"titanWarCouncil":0}},{"idx":1,"day":73,"sayText":"⛔ THE HERALD does not notice you the way prey notices a hunter. It notices you the way weather notices a field. You cannot face this alone — sound the call, muster 10 allied blades (you have 0). This is not courage. This is arithmetic.","have":0,"need":10,"musterExists":false,"alliesRaw":0,"alliesUnique":0,"havenValid":0,"readyManual":false,"readyGame":false,"omenStage":2,"omenDay":62,"links":