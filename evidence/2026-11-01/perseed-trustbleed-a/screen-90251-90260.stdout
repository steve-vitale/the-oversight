"},{"day":90,"line":"◈ Salvatore Vega walks out of the light alone, which is how they walked in — and the galaxy, which came to watch a monster, leaves afraid of the right things. The fear is a shield now, held over a village that trusts the hand that holds it."}],"callLines":[],"heraldAttempts":[],"musterRefusals":[],"musterCalls":{"soundTitanCall":0,"titanCommitOwn":0,"titanSelfDo":0,"titanWarCouncil":0},"musterErrs":0,"musterErrors":[],"instrumentErrors":[],"maxWave":4,"wave4":1,"wave5":0,"w4Day":86,"w5Day":null,"national":0,"table":1,"won":1,"days":90,"gameDays":90,"endReason":"over-other","endScaleRank":"regional","deaths":[{"day":9,"kind":"monster","who":"drumbelly_tanuki","cause":"villager combat","player":false},{"day":14,"kind":"villager","who":"gen_rortmwi","cause":"the wild","player":true},{"day":17,"kind":"monster","who":"drumbelly_tanuki","cause":"villager combat","player":false},{"day":21,"kind":"monster","who":"hushwolf","cause":"combat","player":false},{"day":34,"kind":"monster","who":"hummice","cause":"villager combat","player":false},{"day":36,"kind":"monster","who":"glasswing","cause":"expedition","player":false},{"day":38,"kind":"monster","who":"voice_mimic_radio","cause":"villager combat","player":false},{"day":41,"kind":"monster","who":"mirrormoth","cause":"villager combat","player":false},{"day":42,"kind":"monster","who":"murkcap","cause":"combat","player":false},{"day":42,"kind":"monster","who":"hummice","cause":"villager combat","player":false},{"day":43,"kind":"monster","who":"white_noise_heron","cause":"combat","player":false},{"day":43,"kind":"monster","who":"glasswing","cause":"expedition","player":false},{"day":45,"kind":"monster","who":"nightcourt","cause":"combat","player":false},{"day":47,"kind":"monster","who":"bright_idea","cause":"villager combat","player":false},{"day":52,"kind":"monster","who":"lockpick_raccoon","cause":"villager combat","player":false},{"day":54,"kind":"monster","who":"cliffhanger","cause":"villager combat","pl