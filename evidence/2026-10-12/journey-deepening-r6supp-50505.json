 "favorAsks": [
  {
   "n": 0,
   "day": 41,
   "npc": "Hank",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-50505-0.txt",
   "texts": [
    "\"About this wound — I hate to ask twice, but it's still open. Will you?\"",
    "\"Careful with it. And — thank you.\"",
    "\"Thank you for listening. Really listening. That's rare.\""
   ]
  },
  {
   "n": 1,
   "day": 44,
   "npc": "Marcus",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-50505-1.txt",
   "texts": [
    "\"About this wound — still need hands. Are you in? Doesn't matter now.\"",
    "\"Careful with it. And — thank you.\"",
    "\"The mosquito — the tracks, the sound it makes before it moves, where not to stand. That's the one that matters. Ask me again sometime, there's more.\"",
    "\"The ducks in a row — the tracks, the sound it makes before it moves, where not to stand. That's the one that matters. Ask me again sometime, there's more.\"",
    "\"I should — yeah. Later.\""
   ]
  },
  {
   "n": 2,
   "day": 58,
   "npc": "Marcus",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-50505-2.txt",
   "texts": [
    "\"We never finished talking about that visit — we got cut off, 3 days back.\"",
    "\"I just said — did you miss it?\"",
    "\"This one — Huckleberry. Leaf, stem, smell. You won't forget it now.\"",
    "\"Remember what we said. Hold me to it.\""
   ]
  },
  {
   "n": 3,
   "day": 61,
   "npc": "Marcus",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-50505-3.txt",
   "texts": [
    "\"We never finished talking about that favor — we got cut off. Anyway, that's me.\"",
    "\"My cut needs a second pair of hands. Could you clean it out for me? Please.\"",
    "\"Good talk. Don't be a stranger.\""
   ]
  },
  {
   "n": 4,
   "day": 67,
   "npc": "Marcus",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-50505-4.txt",
   "texts": [
    "\"I can't reach this properly. Could you clean it out for me? Please.\"",
    "\"Good talk. Now let's go be useful.\""
   ]
  },
  {
   "n": 5,
   "day": 68,
   "npc": "James",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-50505-5.txt",
   "texts": [
    "\"I can't reach this properly. Could you clean it out for me? Please.\"",
    "\"Alright. One thing at a time. That's how we get through.\""
   ]
  },
  {
   "n": 6,
   "day": 71,
   "npc": "Lena",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-50505-6.txt",
   "texts": [
    "\"I hate to ask this, but I can't shake it. I'm achy and wrung out, barely keeping food down. I need help. Please.\"",
    "\"I'm sorry — I can't shake it. I'm achy and wrung out, barely keeping food down. I need help. Please.\"",
    "\"Please — I can't shake it. I'm achy and wrung out, barely keeping food down. I need help. Please.\"",
    "\"I just said — did you miss it?\"",
    "\"Take care of yourself.\""
   ]
  },
  {
   "n": 7,
   "day": 72,
   "npc": "Marcus",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-50505-7.txt",
   "texts": [
    "\"About this wound — I still haven't found anyone. Any chance? You know?\"",
    "\"Careful with it. And — thank you.\"",
    "\"Alright. Back to it. Things don't do themselves.\""
   ]
  },
  {
   "n": 8,
   "day": 73,
   "npc": "James",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-50505-8.txt",
   "texts": [
    "\"About this wound — the need hasn't gone anywhere. I'm still asking.\"",
    "\"Careful with it. And — thank you.\"",
    "\"See you at the fire.\""
   ]
  },
  {
   "n": 9,
   "day": 76,
   "npc": "Lena",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-50505-9.txt",
   "texts": [
    "\"Never mind the sickness I'm fighting — we got it handled. Thanks anyway.\"",
    "\"Okay. Here’s the thing —\"",
    "\"I just said — did you miss it?\"",
    "\"I just told you — what else is on your mind?\"",
    "\"Good. We've got a plan forming. I can feel it.\""
   ]
  },
  {
   "n": 10,
   "day": 80,
   "npc": "Lena",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-50505-10.txt",
   "texts": [
    "\"About the pantry run — the need hasn't gone anywhere. I'm still asking.\"",
    "\"Good. The old burn east of camp, morning, early. Two packs between us.\"",
    "\"Steady as she goes. See you at dinner.\""
   ]
  },
  {
   "n": 11,
   "day": 81,
   "npc": "Marcus",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-50505-11.txt",
   "texts": [
    "\"Pantry's thin and getting thinner. Forage with me tomorrow? I know the meadow edge, west of the creek. No point pretending otherwise.\"",
    "\"Saw things with too many joints. Give them room. That's the whole lesson.\"",
    "\"Remember what I said. And I'll remember what you said. Deal?\""
   ]
  }
 ],
