 "scaleBeats": [
  {
   "day": 25,
   "beat": "link-propose",
   "args": [
    "village_0"
   ],
   "scale": "village",
   "text": "⛓️ Marcus brings it home: Emberhold bows to Haven — one organization, us primary. Tribute: 4,000 kcal/week. The relationship starts at trust 30. Everything from here is earned.\nThe village feels it before they understand it: Haven isn't just Haven anymore. Marcus speaks at Emberhold's table now — earned, not appointed. And the other fire is watching what Haven does FIRST.\nThree weeks. That's how long before a handshake is a relationship — the System will say so when it's true. Tend this fire.\n📓 Codex: First link formed with Emberhold. The gesture goes out now; the Dawn waits for seasons."
  },
  {
   "day": 26,
   "beat": "accord",
   "args": [
    "gift"
   ],
   "scale": "village",
   "text": "🎁 Haven's first gesture: 2,000 kcal walks to Emberhold's fire — a gift, no strings. They count it, and they remember who sent it. (Trust +10.)"
  },
  {
   "day": 26,
   "beat": "covenant-propose",
   "args": [
    "village_1"
   ],
   "scale": "village",
   "text": "Stonebridge barely know Haven's name — and a covenant is a relationship, not a handshake. Sit with them first: walk to their fire and study their codex, win where the region hears it, give it weeks. Come back when they know what Haven is."
  },
