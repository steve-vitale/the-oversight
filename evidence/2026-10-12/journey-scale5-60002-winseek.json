 "scaleBeats": [
  {
   "day": 3,
   "beat": "link-propose",
   "args": [
    "village_2",
    "[object Object]"
   ],
   "scale": "village",
   "text": "⛓️ Thornfield doesn't say no. They say: \"They'll take Haven — but the tribute is 6,000 kcal/week, not 5,000. Take it or leave it.\" The table is set — accept their terms, sweeten the offer, or walk away."
  },
  {
   "day": 4,
   "beat": "counter",
   "args": [
    "accept"
   ],
   "scale": "village",
   "text": "⛓️ A person, maybe 40s, with a broad frame brings it home: Haven bows to Thornfield — one organization, them primary. Tribute: 6,000 kcal/week. The relationship starts at trust 30. Everything from here is earned.\nThe village feels it before they understand it: Haven isn't just Haven anymore. A person, maybe 40s, with a broad frame speaks at Thornfield's table now — earned, not appointed. And the other fire is watching what Haven does FIRST.\nThree weeks. That's how long before a handshake is a relationship — the System will say so when it's true. Tend this fire.\n📓 Journal: First link formed with Thornfield. The gesture goes out now; the Dawn waits for seasons."
  },
  {
   "day": 5,
   "beat": "accord",
   "args": [
    "gift"
   ],
   "scale": "village",
   "text": "🎁 Haven's first gesture: 2,000 kcal walks to Thornfield's fire — a gift, no strings. They count it, and they remember who sent it. (Trust +10.)"
  },
  {
   "day": 30,
   "beat": "covenant-propose",
   "args": [
    "village_spl_25_82203"
   ],
   "scale": "regional",
   "text": "Haven's council doesn't take orders from the road. Exile means exile."
  }
