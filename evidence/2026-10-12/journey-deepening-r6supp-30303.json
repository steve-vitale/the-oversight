 "favorAsks": [
  {
   "n": 0,
   "day": 40,
   "npc": "Emma",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-30303-0.txt",
   "texts": [
    "\"About this wound — I still haven't found anyone. Any chance? ...yeah.\"",
    "\"Careful with it. And — thank you.\"",
    "\"There's more, but that's for another fire.\"",
    "\"I should get back to it — but this was nice.\""
   ]
  },
  {
   "n": 1,
   "day": 42,
   "npc": "Emma",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-30303-1.txt",
   "texts": [
    "\"I can't reach this properly. Could you take a look?  Simple as that.\"",
    "\"I'm rooting for you. Whatever you're working on. Just so you know.\""
   ]
  },
  {
   "n": 2,
   "day": 43,
   "npc": "David",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-30303-2.txt",
   "texts": [
    "\"Can we talk?\" David sits down near you. \"Just... talk. Like people used to.\"",
    "\"Later.\""
   ]
  },
  {
   "n": 3,
   "day": 44,
   "npc": "Emma",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-30303-3.txt",
   "texts": [
    "\"About the pantry run — the need hasn't gone anywhere. I'm still asking.  Not that it matters.\"",
    "\"Good. The south slope below the meadow, morning, early. Two packs between us.\"",
    "\"That's everything I brought back. The rest is just walking.\"",
    "\"Anyway. I'm glad we talked. Really.\""
   ]
  },
  {
   "n": 4,
   "day": 46,
   "npc": "David",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-30303-4.txt",
   "texts": [
    "\"We never finished talking about that question — we got cut off.\"",
    "\"The pantry's nearly bare. Will you forage with me tomorrow? Two pairs of eyes, twice the ground.\"",
    "\"Don't be a stranger.\""
   ]
  },
  {
   "n": 5,
   "day": 47,
   "npc": "David",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-30303-5.txt",
   "texts": [
    "\"We never finished talking about that favor — we got cut off.\"",
    "\"This wound — I can't clean it properly one-handed. Could you take a look?\"",
    "\"Good talk.\""
   ]
  },
  {
   "n": 6,
   "day": 48,
   "npc": "David",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-30303-6.txt",
   "texts": [
    "\"We never finished talking about that favor — we got cut off.\"",
    "\"I can't reach this properly. Could you take a look?\"",
    "\"Take care of yourself.\""
   ]
  },
  {
   "n": 7,
   "day": 49,
   "npc": "David",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-30303-7.txt",
   "texts": [
    "\"We never finished talking about that favor — we got cut off.\"",
    "\"My cut needs a second pair of hands. Will you help me clean it?\"",
    "\"Okay. One step at a time, right?\""
   ]
  },
  {
   "n": 8,
   "day": 50,
   "npc": "David",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-30303-8.txt",
   "texts": [
    "\"About the pantry run — still need hands. Are you in?\"",
    "\"Good. The north treeline by the fallen oak, dawn. Two packs between us.\"",
    "\"Later.\""
   ]
  },
  {
   "n": 9,
   "day": 52,
   "npc": "David",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-30303-9.txt",
   "texts": [
    "\"We never finished talking about that debt — we got cut off.\"",
    "\"This cut — I can't clean it properly one-handed. Will you help me clean it?\"",
    "\"I should get back. Stay sharp out there.\""
   ]
  },
  {
   "n": 10,
   "day": 53,
   "npc": "David",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-30303-10.txt",
   "texts": [
    "\"About this wound — the need hasn't gone anywhere. I'm still asking.\"",
    "\"Careful with it. And — thank you.\"",
    "\"I'll think about what you said. Carefully. That's how I do things.\""
   ]
  },
  {
   "n": 11,
   "day": 54,
   "npc": "David",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-30303-11.txt",
   "texts": [
    "\"We never finished talking about that debt — we got cut off.\"",
    "\"This wound — I can't clean it properly one-handed. Could you clean it out for me? Please.\"",
    "\"Well. We'll see how it goes.\""
   ]
  }
