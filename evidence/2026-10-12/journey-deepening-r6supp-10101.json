 "favorAsks": [
  {
   "n": 0,
   "day": 40,
   "npc": "Lena",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-10101-0.txt",
   "texts": [
    "\"About this wound — I still haven't found anyone. Any chance?\"",
    "\"Careful with it. And — thank you.\"",
    "\"Later.\""
   ]
  },
  {
   "n": 1,
   "day": 41,
   "npc": "Marcus",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-10101-1.txt",
   "texts": [
    "\"About the pantry run — I still haven't found anyone. Any chance? !\"",
    "\"Good. The old burn east of camp, morning, early. Pack light — we move fast.\"",
    "\"a spring that runs clear — I'll show you on the map sometime. It's real.\"",
    "\"an old trapline — I'll show you on the map sometime. It's real.\"",
    "\"Good talk.\""
   ]
  },
  {
   "n": 2,
   "day": 42,
   "npc": "James",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-10101-2.txt",
   "texts": [
    "\"Can we talk?\" James sits down near you. \"Just... talk. Like people used to.\"",
    "\"Alright. Back to it.\""
   ]
  },
  {
   "n": 3,
   "day": 43,
   "npc": "Emma",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-10101-3.txt",
   "texts": [
    "\"We never finished talking about that favor — we got cut off.\"",
    "\"The pantry's nearly bare. Forage with me tomorrow? I know the creek bend, past the treeline.\"",
    "\"This one — Greenbrier Shoots. Leaf, stem, smell. You won't forget it now.\"",
    "\"This one — Saw Palmetto. Leaf, stem, smell. You won't forget it now.\"",
    "\"I'm rooting for you. Whatever you're working on. Just so you know.\""
   ]
  },
  {
   "n": 4,
   "day": 44,
   "npc": "David",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-10101-4.txt",
   "texts": [
    "\"About the pantry run — I hate to ask twice, but it's still open. Will you?\"",
    "\"Good. The south slope below the meadow, first light. Bring your pack and your knife.\"",
    "\"Don't be a stranger.\""
   ]
  },
  {
   "n": 5,
   "day": 47,
   "npc": "Marcus",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-10101-5.txt",
   "texts": [
    "\"We never finished talking about that debt — we got cut off, 3 days back.\"",
    "\"This cut — I can't clean it properly one-handed. Could you clean it out for me? Please.\"",
    "\"Good talk. Now let's go be useful.\""
   ]
  },
  {
   "n": 6,
   "day": 49,
   "npc": "Rosa",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-10101-6.txt",
   "texts": [
    "\"I asked Alma about the pantry run — Alma's gone. Still need hands. Are you in? No point pretending otherwise.\"",
    "\"Good. The old burn east of camp, morning, early. Pack light — we move fast.\"",
    "\"Right. Back to it.\""
   ]
  },
  {
   "n": 7,
   "day": 50,
   "npc": "Marcus",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-10101-7.txt",
   "texts": [
    "\"Alma and I never finished talking about that favor — we left it mid-thought, 3 days back. You're wearing Alma's shoes now — want to pick it up? Just... be straight with me.\"",
    "\"Later.\""
   ]
  },
  {
   "n": 8,
   "day": 51,
   "npc": "James",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-10101-8.txt",
   "texts": [
    "\"About the food I needed — I still haven't found anyone. Any chance? Let's move.\"",
    "\"Thank you. I won't forget who fed me when it mattered.\"",
    "\"Alright. Back to work.\""
   ]
  },
  {
   "n": 9,
   "day": 52,
   "npc": "Emma",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-10101-9.txt",
   "texts": [
    "\"Alma and I never finished talking about that favor — we got cut off, 6 days back. You're wearing Alma's shoes now — want to pick it up? We still owe their secret a proper ending, too. Anyway — how are YOU doing?\"",
    "\"This was nice. Don't be a stranger — we're six people, it's hard.\""
   ]
  },
  {
   "n": 10,
   "day": 56,
   "npc": "Marcus",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-10101-10.txt",
   "texts": [
    "\"About the food I needed — I still haven't found anyone. Any chance? You know?\"",
    "\"Thank you. I won't forget who fed me when it mattered.\"",
    "\"Saw things with too many joints. Give them room. That's the whole lesson.\"",
    "\"Take care of yourself.\""
   ]
  },
  {
   "n": 11,
   "day": 57,
   "npc": "James",
   "wantId": "ask_favor",
   "file": "/tmp/journey-deep-r6-favor-10101-11.txt",
   "texts": [
    "\"We never finished talking about that favor — we got cut off.\"",
    "\"I'm going hungry — have you got anything to spare? Anything? I can't keep going like this.\"",
    "\"See you at the fire.\""
   ]
  }
 ],
