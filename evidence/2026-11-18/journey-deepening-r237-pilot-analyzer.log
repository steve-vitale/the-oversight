   Q2-GUARDLINES seed=104602 day=10 vid=gen_6r9954q kind=guard-passes pick="[goon] \"Keep going.\"" triggerPick="[ans:q_alone_time:a_tell] \"Every day. I go for walks that don't need to happen. Just to breathe my own air.\"" prevThem="\"I get it. Solitude's a resource too. Scarcer than food, some days.\""
