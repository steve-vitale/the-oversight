   "buried": true,
   "looted": true
  },
  "fallenEntry": {
   "day": 25,
   "cause": "the arena",
   "name": "Rafael"
  },
  "echoMentions": 6,
  "echoConvo": 6,
  "echoSay": 0,
  "echoSample": [
   "d28: \"Huh. Let me think about that.\" \"Rafael owed me a favor. I keep thinking about collecting. Stupid.\"",
   "d28: \"Good question.\" \"I dreamed Rafael was still here. Woke up angry at the dream. Stupid.\"",
   "d28: \"I keep turning over the last thing Rafael said to me. I can't tell if I'm remembering it right, and that's somehow the worst part.\"",
   "d32: \"Good question.\" \"Huh. I answered that once — back when the answer was simpler.\" \"Rafael always took the burnt piece. Said someone had to. I take it now.\"",
   "d32: \"Nobody says Rafael's name right yet. We will. Give it a few days.\"",
   "d32: \"I clean up other people's messes quietly for Rafael, now. Feels right. Feels like the least I can do.\""
  ],
