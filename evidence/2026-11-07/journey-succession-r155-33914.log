 "funeral": {
  "scriptedBurial": {
   "found": true,
   "respectsOk": true,
   "buryOk": true,
   "buried": true
  },
  "deathBeat": [
   "d16: 📖 The Codex turns a page on its own. Howard Silverman is dead. You didn't ask. It knew.",
   "d16: 🕯️ Howard Silverman is dead — the wild. The village stops. Somebody screams. Somebody else starts digging.",
   "d16: The village's quarrel was with Howard — and Howard is dead. The sentence doesn't cross the grave. You're someone else now; the docket is empty, but the village remembers.",
   "d17: 📖 The Codex turns a page on its own. Scarlett Ahmed is dead. You didn't ask. It knew.",
   "d17: 🕯️ Scarlett Ahmed is dead — a stranger. The village stops. Somebody screams. Somebody else starts digging."
  ],
  "recoverHome": [
   "d17: That night, they bring Howard home. Nobody asks you to help carry; nobody has to. By morning the grave is dug by the fire, and the body is laid out beside it. The filling of it is yours.",
   "d18: That night, they bring Scarlett home. Nobody asks you to help carry; nobody has to. By morning the grave is dug by the fire, and the body is laid out beside it. The filling of it is yours."
  ],
  "vouch": [
   "d16: At the grave, Ramatu, Jorge speak for Scarlett — \"Howard trusted them. We saw it. Give them the fire's hearing.\" The village listens.",
   "d17: At the grave, Dakota, Ramatu speak for Jorge — \"Scarlett trusted them. We saw it. Give them the fire's hearing.\" The village listens."
  ],
  "systemVoice": [
   "d16: SYSTEM: \"Perimeter violated! This is unprecedented! ...Is this unprecedented? Checking. Yes. Unprecedented.\"",
   "d17: SYSTEM: Deep integration. You see the world through us now.",
   "d17: ⬢ SYSTEM: \"Neural depth 80. I can hold more of you now — ability slots: 6.\"",
   "d18: SYSTEM: Identification complete. You are 0.3% less lost.",
   "d18: 📺 SYSTEM: \"We have already cleared your morning. You are welcome. We require 300 kcal of tubers and your full attention. The fans love a cooking segment.\"",
   "d18: 📺 SYSTEM: \"We will keep practicing on our own.\" You decide, firmly, not to ask what that means."
  ],
  "burialWindowSay": [
   "d16: The Highbeam Deer thrashes its antlers at you — getting close has a price.",
   "d16: The Highbeam Deer thrashes its antlers at Scarlett — getting close has a price.",
   "d16: The Highbeam Deer thrashes its antlers at you — getting close has a price.",
