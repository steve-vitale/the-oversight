   "wanjiru_kamau": {
    "name": "Wanjiru",
    "count": 4,
    "deeds": [
     {
      "text": "Wanjiru came back mauled by The Landlord (1 rounds, 11 taken) and alive. Three white lines across the forearm now.",
      "day": 26,
      "type": "survived_hurt"
     },
     {
      "text": "Wanjiru came back mauled by The Understudy (1 rounds, 8 taken) and alive. A limp that comes back in the cold now.",
      "day": 25,
      "type": "survived_hurt"
     },
     {
      "text": "Wanjiru killed The Moderator out past the ridge — with Miguel charging in when it turned — and walked home. 7 rounds, 35 taken.",
      "day": 24,
      "type": "monster_kill"
     },
     {
      "text": "Wanjiru showed Miguel the snare — the loop, the trigger stick, where the run narrows. The beginner's wire.",
      "day": 18,
      "type": "taught"
     }
    ],
    "closed": false
   }
