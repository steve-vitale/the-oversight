{
  "schemaVersion": 1,
  "minimumPairs": 8,
  "confirmationSeeds": 64,
  "bootstrapSamples": 1000,
  "metrics": [
    { "id": "won", "label": "Table win rate", "unit": "fraction", "direction": "neutral", "tolerance": 0.02, "reviewChanges": true },
    { "id": "entered", "label": "Table entry rate", "unit": "fraction", "direction": "higher", "tolerance": 0.02 },
    { "id": "table", "label": "Table invitation rate", "unit": "fraction", "direction": "higher", "tolerance": 0.02 },
    { "id": "national", "label": "National scale access", "unit": "fraction", "direction": "higher", "tolerance": 0.02 },
    { "id": "survival30", "label": "First bearer survives through day 30", "unit": "fraction, observable cases", "direction": "higher", "tolerance": 0.02 },
    { "id": "survival60", "label": "First bearer survives through day 60", "unit": "fraction, observable cases", "direction": "higher", "tolerance": 0.02 },
    { "id": "playerDeaths", "label": "Player deaths per run", "unit": "deaths/run", "direction": "lower", "tolerance": 0.1 },
    { "id": "playerDeaths100Days", "label": "Player deaths per 100 calendar days", "unit": "deaths/100 days", "direction": "lower", "tolerance": 0.1 },
    { "id": "communityLost", "label": "Community loss rate", "unit": "fraction", "direction": "lower", "tolerance": 0.02 },
    { "id": "livingNpcs", "label": "Mean sampled living NPCs", "unit": "people", "direction": "higher", "tolerance": 0.25 },
    { "id": "lowFood", "label": "Sampled reserve below 500 kcal", "unit": "fraction of sampled days", "direction": "lower", "tolerance": 0.02 },
    { "id": "lowWater", "label": "Sampled hydration below 25%", "unit": "fraction of sampled days", "direction": "lower", "tolerance": 0.02 },
    { "id": "lowHealth", "label": "Sampled HP below 25", "unit": "fraction of sampled days", "direction": "lower", "tolerance": 0.02 },
    { "id": "npcHungry", "label": "Sampled hungry NPCs (hunger at least 80)", "unit": "fraction of known NPC needs samples", "direction": "lower", "tolerance": 0.02 },
    { "id": "classAccess", "label": "Player named-class access", "unit": "fraction", "direction": "higher", "tolerance": 0.02 },
    { "id": "npcClassAccess", "label": "NPC named-class access", "unit": "fraction of sampled NPC identities", "direction": "higher", "tolerance": 0.02 },
    { "id": "goodGear", "label": "Earned player tier-3+ weapon/armor access", "unit": "fraction", "direction": "higher", "tolerance": 0.02 },
    { "id": "contestShowGear", "label": "Player tier-3+ contest/show weapon/armor", "unit": "fraction", "direction": "higher", "tolerance": 0.02 },
    { "id": "craftTradeGear", "label": "Player tier-3+ craft/trade weapon/armor", "unit": "fraction", "direction": "higher", "tolerance": 0.02 },
    { "id": "corpseGear", "label": "Player tier-3+ corpse weapon/armor", "unit": "fraction", "direction": "neutral", "tolerance": 0 },
    { "id": "usefulIntake", "label": "Nourishment / physical food consumed", "unit": "fraction", "direction": "neutral", "tolerance": 0 },
    { "id": "bearerChanges", "label": "Bearer changes", "unit": "people/run", "direction": "neutral", "tolerance": 0 },
    { "id": "abilityAccepted", "label": "Accepted player ability events", "unit": "events/run, not landed effects", "direction": "neutral", "tolerance": 0 }
  ]
}
